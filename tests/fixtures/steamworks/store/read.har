pp[content][earlyaccess][pricing][vietnamese]\" value=\"\"></div>                </div>\n            </div>\n        </div>\n\n        <div class=\"subsection\">\n            <div class=\"newformrow widelabel EarlyAccess\">\n                <div class=\"formlabel\">\n\t\t\t\t\t<div class=\"ea_question\">How are you planning on involving the Community in your development process?</div>\n\t\t\t\t\t</div>\n                <div class=\"formdata\">\n                    <div id=\"app_content_earlyaccess_community__area\" class=\"LocTextArea\"><div class=\"LocTextAreaBar\"><select id=\"app_content_earlyaccess_community__select\" class=\"LocTextAreaLangSelect\" onfocus=\"LocUpdateLangThatHaveText( 'app_content_earlyaccess_community_' )\" onchange=\"OnLocLanguageSelect( 'app_content_earlyaccess_community_' )\"><option id=\"app_content_earlyaccess_community_english__option\" value=\"english\">English</option><option id=\"app_content_earlyaccess_community_french__option\" value=\"french\">French</option><option id=\"app_content_earlyaccess_community_italian__option\" value=\"italian\">Italian</option><option id=\"app_content_earlyaccess_community_german__option\" value=\"german\">German</option><option id=\"app_content_earlyaccess_community_spanish__option\" value=\"spanish\">Spanish - Spain</option><option id=\"app_content_earlyaccess_community_bulgarian__option\" value=\"bulgarian\">Bulgarian</option><option id=\"app_content_earlyaccess_community_czech__option\" value=\"czech\">Czech</option><option id=\"app_content_earlyaccess_community_danish__option\" value=\"danish\">Danish</option><option id=\"app_content_earlyaccess_community_dutch__option\" value=\"dutch\">Dutch</option><option id=\"app_content_earlyaccess_community_finnish__option\" value=\"finnish\">Finnish</option><option id=\"app_content_earlyaccess_community_greek__option\" value=\"greek\">Greek</option><option id=\"app_content_earlyaccess_community_hungarian__option\" value=\"hungarian\">Hungarian</option><option id=\"app_content_earlyaccess_community_indonesian__option\" value=\"indonesian\">Indonesian</option><option id=\"app_content_earlyaccess_community_japanese__option\" value=\"japanese\">Japanese</option><option id=\"app_content_earlyaccess_community_koreana__option\" value=\"koreana\">Korean</option><option id=\"app_content_earlyaccess_community_malay__option\" value=\"malay\">Malay</option><option id=\"app_content_earlyaccess_community_norwegian__option\" value=\"norwegian\">Norwegian</option><option id=\"app_content_earlyaccess_community_polish__option\" value=\"polish\">Polish</option><option id=\"app_content_earlyaccess_community_brazilian__option\" value=\"brazilian\">Portuguese - Brazil</option><option id=\"app_content_earlyaccess_community_portuguese__option\" value=\"portuguese\">Portuguese - Portugal</option><option id=\"app_content_earlyaccess_community_romanian__option\" value=\"romanian\">Romanian</option><option id=\"app_content_earlyaccess_community_russian__option\" value=\"russian\">Russian</option><option id=\"app_content_earlyaccess_community_schinese__option\" value=\"schinese\">Simplified Chinese</option><option id=\"app_content_earlyaccess_community_latam__option\" value=\"latam\">Spanish - Latin America</option><option id=\"app_content_earlyaccess_community_swedish__option\" value=\"swedish\">Swedish</option><option id=\"app_content_earlyaccess_community_thai__option\" value=\"thai\">Thai</option><option id=\"app_content_earlyaccess_community_tchinese__option\" value=\"tchinese\">Traditional Chinese</option><option id=\"app_content_earlyaccess_community_turkish__option\" value=\"turkish\">Turkish</option><option id=\"app_content_earlyaccess_community_ukrainian__option\" value=\"ukrainian\">Ukrainian</option><option id=\"app_content_earlyaccess_community_vietnamese__option\" value=\"vietnamese\">Vietnamese</option></select><div style=\"clear: both;\"></div></div><textarea id=\"app_content_earlyaccess_community__textarea\" onchange=\"OnLocTextChanged( 'app_content_earlyaccess_community_' )\"></textarea><input type=\"hidden\" id=\"app_content_earlyaccess_community__currentlanguage\"><input type=\"hidden\" id=\"app_content_earlyaccess_community_english__hidden\" lang=\"en\" name=\"app[content][earlyaccess][community][english]\" value=\"\"><input type=\"hidden\" id=\"app_content_earlyaccess_community_french__hidden\" lang=\"fr\" name=\"app[content][earlyaccess][community][french]\" value=\"\"><input type=\"hidden\" id=\"app_content_earlyaccess_community_italian__hidden\" lang=\"it\" name=\"app[content][earlyaccess][community][italian]\" value=\"\"><input type=\"hidden\" id=\"app_content_earlyaccess_community_german__hidden\" lang=\"de\" name=\"app[content][earlyaccess][community][german]\" value=\"\"><input type=\"hidden\" id=\"app_content_earlyaccess_community_spanish__hidden\" lang=\"es\" name=\"app[content][earlyaccess][community][spanish]\" value=\"\"><input type=\"hidden\" id=\"app_content_earlyaccess_community_bulgarian__hidden\" lang=\"bg\" name=\"app[content][earlyaccess][community][bulgarian]\" value=\"\"><input type=\"hidden\" id=\"app_content_earlyaccess_community_czech__hidden\" lang=\"cs\" name=\"app[content][earlyaccess][community][czech]\" value=\"\"><input type=\"hidden\" id=\"app_content_earlyaccess_community_danish__hidden\" lang=\"da\" name=\"app[content][earlyaccess][community][danish]\" value=\"\"><input type=\"hidden\" id=\"app_content_earlyaccess_community_dutch__hidden\" lang=\"nl\" name=\"app[content][earlyaccess][community][dutch]\" value=\"\"><input type=\"hidden\" id=\"app_content_earlyaccess_community_finnish__hidden\" lang=\"fi\" name=\"app[content][earlyaccess][community][finnish]\" value=\"\"><input type=\"hidden\" id=\"app_content_earlyaccess_community_greek__hidden\" lang=\"el\" name=\"app[content][earlyaccess][community][greek]\" value=\"\"><input type=\"hidden\" id=\"app_content_earlyaccess_community_hungarian__hidden\" lang=\"hu\" name=\"app[content][earlyaccess][community][hungarian]\" value=\"\"><input type=\"hidden\" id=\"app_content_earlyaccess_community_indonesian__hidden\" lang=\"id\" name=\"app[content][earlyaccess][community][indonesian]\" value=\"\"><input type=\"hidden\" id=\"app_content_earlyaccess_community_japanese__hidden\" lang=\"ja\" name=\"app[content][earlyaccess][community][japanese]\" value=\"\"><input type=\"hidden\" id=\"app_content_earlyaccess_community_koreana__hidden\" lang=\"ko\" name=\"app[content][earlyaccess][community][koreana]\" value=\"\"><input type=\"hidden\" id=\"app_content_earlyaccess_community_malay__hidden\" lang=\"ms\" name=\"app[content][earlyaccess][community][malay]\" value=\"\"><input type=\"hidden\" id=\"app_content_earlyaccess_community_norwegian__hidden\" lang=\"no\" name=\"app[content][earlyaccess][community][norwegian]\" value=\"\"><input type=\"hidden\" id=\"app_content_earlyaccess_community_polish__hidden\" lang=\"pl\" name=\"app[content][earlyaccess][community][polish]\" value=\"\"><input type=\"hidden\" id=\"app_content_earlyaccess_community_brazilian__hidden\" lang=\"pt-br\" name=\"app[content][earlyaccess][community][brazilian]\" value=\"\"><input type=\"hidden\" id=\"app_content_earlyaccess_community_portuguese__hidden\" lang=\"pt\" name=\"app[content][earlyaccess][community][portuguese]\" value=\"\"><input type=\"hidden\" id=\"app_content_earlyaccess_community_romanian__hidden\" lang=\"ro\" name=\"app[content][earlyaccess][community][romanian]\" value=\"\"><input type=\"hidden\" id=\"app_content_earlyaccess_community_russian__hidden\" lang=\"ru\" name=\"app[content][earlyaccess][community][russian]\" value=\"\"><input type=\"hidden\" id=\"app_content_earlyaccess_community_schinese__hidden\" lang=\"zh-cn\" name=\"app[content][earlyaccess][community][schinese]\" value=\"\"><input type=\"hidden\" id=\"app_content_earlyaccess_community_latam__hidden\" lang=\"es-419\" name=\"app[content][earlyaccess][community][latam]\" value=\"\"><input type=\"hidden\" id=\"app_content_earlyaccess_community_swedish__hidden\" lang=\"sv\" name=\"app[content][earlyaccess][community][swedish]\" value=\"\"><input type=\"hidden\" id=\"app_content_earlyaccess_community_thai__hidden\" lang=\"th\" name=\"app[content][earlyaccess][community][thai]\" value=\"\"><input type=\"hidden\" id=\"app_content_earlyaccess_community_tchinese__hidden\" lang=\"zh-tw\" name=\"app[content][earlyaccess][community][tchinese]\" value=\"\"><input type=\"hidden\" id=\"app_content_earlyaccess_community_turkish__hidden\" lang=\"tr\" name=\"app[content][earlyaccess][community][turkish]\" value=\"[turkish text removed]\"><input type=\"hidden\" id=\"app_content_earlyaccess_community_ukrainian__hidden\" lang=\"uk\" name=\"app[content][earlyaccess][community][ukrainian]\" value=\"\"><input type=\"hidden\" id=\"app_content_earlyaccess_community_vietnamese__hidden\" lang=\"vi\" name=\"app[content][earlyaccess][community][vietnamese]\" value=\"\"></div>                </div>\n            </div>\n        </div>\n\n\t\t    \n\n\t<div class=\"form_footer sticky_save_bar\">\n\t\t<div><input class=\"btn_green_white_innerfade btn_medium xtra_padding\" type=\"submit\" value=\"Save\"></div>\n\t</div>\n</div>\n</div>\n\n<div class=\"tab_content  \" id=\"tab_ratings_content\">\n\t<link href=\"https://partner.steamgames.com/public/css/styles_twoColumn.css?v=uZF2jROQa8G3&amp;l=english&amp;_cdn=akamai\" rel=\"stylesheet\" type=\"text/css\">\n<link href=\"https://partner.steamgames.com/public/css/contentdescriptors.css?v=C3xURP7SQWHu&amp;l=english&amp;_cdn=akamai\" rel=\"stylesheet\" type=\"text/css\">\n\n\n\n\n<div class=\"subsection\">\n\t\t\t<div class=\"adminTwoColCtn\">\n\t\t\t<div class=\"adminLeftCol\">\n\t\t\t\t<div class=\"colSection\">\n\t\t\t\t\t<h2 class=\"inline\">Official Agency Ratings</h2>\n\t\t\t\t\t<p class=\"introText\">If your game has been granted a rating directly from one of these official rating boards, select the entity below to enter your rating information. Manually entered ratings here will take priority over the rating generated by the <a href=\"https://partner.steamgames.com/contentdescriptors/editsurvey/1000000/\">Content Survey</a> for players in the associated country.</p>\n\t\t\t\t\t<div class=\"game_ratings_note_warning\">\n\t\t\t\t\t\tOnly enter a rating here if you have received an official rating from the associated entity such as ESRB, USK, etc. This rating is usually accompanied by official paperwork and a rating ID from the rating agency.<br><br>\n\t\t\t\t\t\tGoing through rating generation process on other platforms doesn’t necessarily result in a rating you can use here. Please carefully check the paperwork provided from each agency before entering ratings here.\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t<div class=\"gameratings_contentsurvey_warning\">\n\t\t\t\t\t\t<p>Official ratings cannot be entered until you have completed and published your game's Content Survey.</p>\n\t\t\t\t\t\t<a class=\"btn_darkblue_white_innerfade btn_medium xtra_padding\" href=\"https://partner.steamgames.com/contentdescriptors/editsurvey/1000000/\"><span>Visit Content Survey Page</span></a>\n\t\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</div>\n\t\t</div>\n\t\t\t</div>\n</div>\n\n<div class=\"tab_content \" id=\"tab_graphicalassets_content\">\n\t<div class=\"section\" id=\"ScreenshotNoFormData\" style=\"display: none\">\n\tEditing graphical assets requires Edge, Chrome or Firefox</div>\n<div class=\"section\" id=\"ScreenshotFormData\">\n\t\n\t<script type=\"text/javascript\">\n\t\t$J( function() {\n\t\t\t$J('.graphical_assets_tab').on( 'click', function()\n\t\t\t{\n\t\t\t\tlet url = new URL( window.location );\n\n\t\t\t\tconst tab = $J( this ).data('tab');\n\t\t\t\turl.searchParams.set( 'subtab', tab );\n\t\t\t\twindow.history.pushState( {}, '', url );\n\t\t\t\t$J(this).addClass('active').siblings().removeClass('active');\n\t\t\t\t$J('.graphical_assets_tab_content[data-tab=' + tab + ']').addClass('active').siblings().removeClass('active');\n\t\t\t\tif ( tab !== 'store' )\n\t\t\t\t\tAgreeToBaseAssetsUpload();\n\t\t\t} );\n\t\t});\n\t</script>\n\n\t\t\t<div id=\"graphical_assets_tabs\" class=\"graphical_assets_tabs\">\n\t\t\t<div class=\"graphical_assets_tab active\" data-tab=\"store\">\n\t\t\t\tStore assets &nbsp;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<span class=\"graphical_asset_status checklist_incomplete\">0/4 Added</span>\n\t\t\t\t\t\t\t\t\t\t\t\t</div>\n\n\t\t\t\t\t\t\t<div class=\"graphical_assets_tab\" data-tab=\"screenshots\">\n\t\t\t\t\tScreenshot assets &nbsp;\n\t\t\t\t\t\t\t\t\t\t\t<span class=\"graphical_asset_status checklist_incomplete\">0/5 Added</span>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\n\t\t\t\t\t\t\t<div class=\"graphical_assets_tab\" data-tab=\"library\">\n\t\t\t\t\tLibrary assets &nbsp;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<span class=\"graphical_asset_status checklist_incomplete\">0/5 Added</span>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\n\t\t\t\t\t\t\t<div class=\"graphical_assets_tab\" data-tab=\"broadcast\">\n\t\t\t\t\tBroadcast assets &nbsp;\n\t\t\t\t\t\t\t\t\t\t\t<span class=\"graphical_asset_status checklist_suggested\">SUGGESTED</span>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\n\t<div class=\"drag_and_drop\" id=\"game_image_drop\">\n\t\t<div class=\"drag_and_drop_contents\"  >\n\t\t\tDrop images here to upload\t\t\t<div class=\"drag_and_drop_instructions\" id=\"game_image_drop_instructions\">Based on the dimensions of the image, we'll make sure it gets put in the right category below.</div>\n\t\t\t\t\t\t<div id=\"game_image_drop_preview\"></div>\n\t\t\t<div style=\"clear: both;\" ></div>\n\t\t\t<div class=\"drag_and_drop_upload_button btnv6_lightblue_blue btn_medium\" id=\"image_upload_btn\" onclick=\"SubmitImageUpload( 2000000, 'Game', '', '', 0 );\">\n\t\t\t\t<span>Upload</span>\n\t\t\t</div>\n\t\t</div>\n\t\t\t</div>\n\n\t<div id=\"graphical_assets_tab_contents\" class=\"graphical_assets_tab_contents\">\n\n\t\t<div class=\"graphical_assets_tab_content active\" data-tab=\"store\">\n\t\t\t\n\t\n<div class=\"instructions subsection overview\">\n\n\t<div class=\"instructions_table\">\n\t\t<div class=\"instructions_table_row\">\n\t\t\t<div class=\"instructions_table_cell left\">\n\t\t\t\t<strong>Overview:</strong>\n\t\t\t</div>\n\t\t\t<div class=\"instructions_table_cell\">\n\t\t\t\t<p class=\"overview\">This section is for managing the images that represent your application in various parts of the Steam store and client. For best results, please upload .png files at the exact dimensions specified for each type. JPEG files are also accepted if necessary.</p>\n\t\t\t</div>\n\t\t</div>\n\n\t\t<div class=\"instructions_table_row\">\n\t\t\t<div class=\"instructions_table_cell left\">\n\t\t\t\t<strong>Templates:</strong>\n\t\t\t</div>\n\t\t\t<div class=\"instructions_table_cell\">\n\t\t\t\t<p>Download Photoshop templates for the specific sized images here: <a href=\"https://www.dropbox.com/scl/fo/cvkwbosmrimklcl9h0qko/AF5IPErKP-mQM_3YO1Dw2lA?rlkey=b3ad0izykq367g4luasrinw9z&dl=0\" target=\"_blank\">Steam Templates on Dropbox</a></p>\n\t\t\t</div>\n\t\t</div>\n\n\t\t<div class=\"instructions_table_row\">\n\t\t\t<div class=\"instructions_table_cell left\">\n\t\t\t\t<strong>Localization:</strong>\n\t\t\t</div>\n\t\t\t<div class=\"instructions_table_cell\">\n\t\t\t\t<p>Include the appropriate language name at the end of your file name to automatically assign that language. (for example \"capsule_sm_koreana.png\" will automatically assign it as Korean or \"capsule_sm_schinese.png\" will automatically assign it as Simplified Chinese)</p>\n                <p>For a full list of supported language names, please see \"API language code\" column in <a href=\"https://partner.steamgames.com/doc/store/localization#supported_languages\" target=\"_blank\">Localization and Languages Documentation</a>.</p>\n\t\t\t</div>\n\t\t</div>\n\n\t\t<div class=\"instructions_table_row\">\n\t\t\t<div class=\"instructions_table_cell left\">\n\t\t\t\t<strong>Requirements:</strong>\n\t\t\t</div>\n\t\t\t<div class=\"instructions_table_cell\">\n                                    <p><em>Content on base graphical asset capsules is limited to game artwork, the game name, and any official subtitle. If including text on a graphical asset to promote an update or special event, this MUST be uploaded as an Artwork Override. Please see <a href=\"https://partner.steamgames.com/doc/store/assets/rules\">Graphical Asset Rules</a> for details.</em></p>\n                    <p class=\"required\">* indicates required fields</p>\n                \t\t\t</div>\n\t\t</div>\n\t</div>\n</div>\n\n\n\n<div class=\"section\">\n\t<div class=\"instructions\">\n\t\t<div class=\"title2\">\n\t\t\tHeader Capsule <span class=\"required\">*</span>\t\t</div>\n\t\t<div class=\"titleHelper\">\n\t\t\t920px wide x 430px tall\t\t\t\t\t</div>\n\t\t<br clear=\"left\">\n\t\t<div class=\"grayRule\"> </div>\n\t\t\t\t\t<div class=\"formrow text\">\n\t\t\t\t<strong>Design:</strong> This image should focus on the branding of your product. For best results, please use the same artwork that you use for any retail box or marketing and make sure the logo is clearly legible.<br>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t<strong>Usage:</strong> It will appear at the top of your page in the store, in the 'recommended for you' section, in 'grid view' in customers libraries in the Steam client, in browse views on Big Picture mode, and for daily deals if applicable.<br>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t<strong>Sizes:</strong> 920px x 430px\t\t\t</div>\n\t\t\n\t\t\t</div>\n\t<br>\n\t<div class=\"image_type_section\">\n\t\t<div class=\"image_preview_col header_image\">\n\t\t\t\t\t\t\t<div class=\"noimage image_preview_badge warning\">No English image uploaded.</div>\n\t\t\t\t\t</div>\n\t\t<div class=\"image_language_col\">\n\t\t\t\t\t</div>\n\t</div>\n\t</div>\n<div class=\"section\">\n\t<div class=\"instructions\">\n\t\t<div class=\"title2\">\n\t\t\tSmall Capsule <span class=\"required\">*</span>\t\t</div>\n\t\t<div class=\"titleHelper\">\n\t\t\t462px wide x 174px tall\t\t\t\t\t</div>\n\t\t<br clear=\"left\">\n\t\t<div class=\"grayRule\"> </div>\n\t\t\t\t\t<div class=\"formrow text\">\n\t\t\t\t<strong>Design:</strong> These are small, so they should focus on making the logo clearly legible, even at the smallest size.<br>\n\t\t\t\t\t\t\t\t\t\t\t\t<strong>Usage:</strong> These are used for all the lists throughout Steam. Search results, top-sellers, new releases, etc. <br>\n\t\t\t\t\t\t\t\t\t\t\t\t<strong>Sizes:</strong> 462px x 174px<br>\n\t\t\t\t<strong>Requirements:</strong> <span class=\"required\"><b>Small Capsule</b> should contain readable logo, even at smallest size. In most cases, this means your logo should nearly fill the small capsule.</span>\n\t\t\t</div>\n\t\t\n\t\t\t</div>\n\t<br>\n\t<div class=\"image_type_section\">\n\t\t<div class=\"image_preview_col small_capsule\">\n\t\t\t\t\t\t\t<div class=\"noimage image_preview_badge warning\">No English image uploaded.</div>\n\t\t\t\t\t</div>\n\t\t<div class=\"image_language_col\">\n\t\t\t\t\t</div>\n\t</div>\n\t</div>\n<div class=\"section\">\n\t<div class=\"instructions\">\n\t\t<div class=\"title2\">\n\t\t\tMain Capsule <span class=\"required\">*</span>\t\t</div>\n\t\t<div class=\"titleHelper\">\n\t\t\t1232px wide x 706px tall\t\t\t\t\t</div>\n\t\t<br clear=\"left\">\n\t\t<div class=\"grayRule\"> </div>\n\t\t\t\t\t<div class=\"formrow text\">\n\t\t\t\t<strong>Design:</strong> These should be designed to market the product. For best results, please use the key art and logo that is being used for any retail boxes or marketing. Do not include quotes, review scores, or awards.<br>\n\t\t\t\t\t\t\t\t\t\t\t\t<strong>Usage:</strong> These appear at the top of the front page in the featured and recommended carousel.<br>\n\t\t\t\t\t\t\t\t\t\t\t\t<strong>Sizes:</strong> 1232px x 706px\t\t\t</div>\n\t\t\n\t\t\t</div>\n\t<br>\n\t<div class=\"image_type_section\">\n\t\t<div class=\"image_preview_col main_capsule\">\n\t\t\t\t\t\t\t<div class=\"noimage image_preview_badge warning\">No English image uploaded.</div>\n\t\t\t\t\t</div>\n\t\t<div class=\"image_language_col\">\n\t\t\t\t\t</div>\n\t</div>\n\t</div>\n<div class=\"section\">\n\t<div class=\"instructions\">\n\t\t<div class=\"title2\">\n\t\t\tVertical Capsule <span class=\"required\">*</span>\t\t</div>\n\t\t<div class=\"titleHelper\">\n\t\t\t748px wide x 896px tall\t\t\t\t\t</div>\n\t\t<br clear=\"left\">\n\t\t<div class=\"grayRule\"> </div>\n\t\t\t\t\t<div class=\"formrow text\">\n\t\t\t\t<strong>Design:</strong> This is a vertical asset that is designed to market your game. For best results, please use the key art and logo that is being used for any retail boxes or marketing. Do not include quotes, review scores, or awards.<br>\n\t\t\t\t\t\t\t\t\t\t\t\t<strong>Usage:</strong> These can appear at the top of the front page during seasonal sales, and on other new sale pages.<br>\n\t\t\t\t\t\t\t\t\t\t\t\t<strong>Sizes:</strong> 748px x 896px\t\t\t</div>\n\t\t\n\t\t\t</div>\n\t<br>\n\t<div class=\"image_type_section\">\n\t\t<div class=\"image_preview_col hero_capsule\">\n\t\t\t\t\t\t\t<div class=\"noimage image_preview_badge warning\">No English image uploaded.</div>\n\t\t\t\t\t</div>\n\t\t<div class=\"image_language_col\">\n\t\t\t\t\t</div>\n\t</div>\n\t</div>\n\n\t<div class=\"section\">\n\n\t\t<div class=\"instructions\">\n\t\t\t<div class=\"title2\">Page Background</div><div class=\"titleHelper\">1438px wide x 810px tall</div>\n\t\t\t<br clear=\"left\">\n\t\t\t<div class=\"grayRule\"> </div>\n\n\t\t\t<div class=\"instructions_table\">\n\t\t\t\t<div class=\"instructions_table_row\">\n\t\t\t\t\t<div class=\"instructions_table_cell left\">\n\t\t\t\t\t\t<strong>Design:</strong>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class=\"instructions_table_cell\">\n\t\t\t\t\t\t<p>This should be ambient so as not to compete with the content on the page, so try to avoid high-contrast images or images with lots of text. A template will automatically be applied to your uploaded file, which will tint it blue and fade out the edges. If you don't upload an image here, we'll automatically take a random screenshot and generate a background image from that.</p>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\n\t\t\t\t<div class=\"instructions_table_row\">\n\t\t\t\t\t<div class=\"instructions_table_cell left\">\n\t\t\t\t\t\t<strong>Usage:</strong>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class=\"instructions_table_cell\">\n\t\t\t\t\t\t<p>This is the image that will be used in the background of your store page.</p>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\n\t\t\t\t<div class=\"instructions_table_row\">\n\t\t\t\t\t<div class=\"instructions_table_cell left\">\n\t\t\t\t\t\t<strong>Size:</strong>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class=\"instructions_table_cell\">\n\t\t\t\t\t\t<p>1438px x 810px</p>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t</div>\n\t\t<br>\n\n\t\t<div class=\"formrow\">\n\t\t\t<div class=\"\">\n\t\t\t\t\t\t\t\t\t<div class=\"noimage\">No image uploaded.</div>\n\t\t\t\t\t\t\t</div>\n\t\t</div>\n\t</div>\n\n\t<div class=\"section\" id=\"section_manuals\">\n\t\t<h2>Game manuals, quick reference guides, and read-me files</h2>\n\t\t<div class=\"grayRule\"></div>\n\t\t<div class=\"formrow\">\n\t\t\t<b>Usage:</b> These manuals are accessible from the Steam client.<br>\n\t\t\t\t\t\t\t\t\t\t\t\t<b>Format:</b> Please upload as .pdf files.<br>\n\t\t\t\t\t\t\t\t\t\t\t\t<b>Online Manuals?</b> Link to online manuals on the Basic Info tab.\t\t</div>\n\n\t\t<div class=\"msglist\">\n\t\t\t\t\t</div>\n\t\t<div class=\"formrow\">\n\t\t\t<div class=\"rightbutton\">\n\t\t\t\t<input class=\"btn_darkblue_white_innerfade btn_small_thin xtra_padding\" type=\"submit\" value=\"Save Changes\">\n\t\t\t</div>\n\t\t</div>\n\t\t\t\t<div class=\"subarea\">\n\t\t\t<div class=\"formrow\">\n\t\t\t\t<input type=\"file\" name=\"manual|assets|manuals|0|file\">\n\t\t\t\t<select name=\"app[assets][manuals][0][language]\" id=\"app_assets_manuals_0_language__entry\">\n<option value=\"arabic\">Arabic</option>\n<option value=\"bulgarian\">Bulgarian</option>\n<option value=\"czech\">Czech</option>\n<option value=\"danish\">Danish</option>\n<option value=\"dutch\">Dutch</option>\n<option selected=\"selected\" value=\"english\">English</option>\n<option value=\"finnish\">Finnish</option>\n<option value=\"french\">French</option>\n<option value=\"german\">German</option>\n<option value=\"greek\">Greek</option>\n<option value=\"hungarian\">Hungarian</option>\n<option value=\"indonesian\">Indonesian</option>\n<option value=\"italian\">Italian</option>\n<option value=\"japanese\">Japanese</option>\n<option value=\"koreana\">Korean</option>\n<option value=\"malay\">Malay</option>\n<option value=\"norwegian\">Norwegian</option>\n<option value=\"polish\">Polish</option>\n<option value=\"brazilian\">Portuguese - Brazil</option>\n<option value=\"portuguese\">Portuguese - Portugal</option>\n<option value=\"romanian\">Romanian</option>\n<option value=\"russian\">Russian</option>\n<option value=\"schinese\">Simplified Chinese</option>\n<option value=\"sc_schinese\">Simplified Chinese - SteamChina</option>\n<option value=\"latam\">Spanish - Latin America</option>\n<option value=\"spanish\">Spanish - Spain</option>\n<option value=\"swedish\">Swedish</option>\n<option value=\"thai\">Thai</option>\n<option value=\"tchinese\">Traditional Chinese</option>\n<option value=\"turkish\">Turkish</option>\n<option value=\"ukrainian\">Ukrainian</option>\n<option value=\"vietnamese\">Vietnamese</option>\n</select>\t\t\t\t<select name=\"app[assets][manuals][0][type]\" id=\"app_assets_manuals_0_type__entry\">\n<option selected=\"selected\" value=\"\">&lt; select type &gt;</option>\n<option value=\"Manual\">Manual</option>\n<option value=\"QuickRef\">Quick Reference</option>\n<option value=\"Map\">Map</option>\n<option value=\"Getting Started\">Getting Started</option>\n<option value=\"Read-Me\">Read-Me</option>\n<option value=\"Tech Tree\">Tech Tree</option>\n<option value=\"Keybindings\">Keybindings</option>\n<option value=\"Warranty\">Warranty</option>\n</select>\t\t\t\t<select name=\"app[assets][manuals][0][system]\" id=\"app_assets_manuals_0_system__entry\">\n<option value=\"unknown\">Unknown/All</option>\n<option selected=\"selected\" value=\"windows\">Windows</option>\n<option value=\"macos\">macOS</option>\n<option value=\"linux\">Linux</option>\n<option value=\"ps3\">PS3</option>\n</select>\t\t\t\t<input type=\"submit\" value=\"Upload\">\n\t\t\t</div>\n\t\t</div>\n\t</div>\n\t\t</div>\n\n\t\t\t\t\t<div class=\"graphical_assets_tab_content\" data-tab=\"screenshots\">\n\t\t\t\t\n<div class=\"section\" id=\"section_screenshots\">\n\t<div class=\"instructions\">\n\t\t<div class=\"title2\">Screenshots\t\t\t\t\t\t\t<span class=\"required\">*</span></div><div class=\"titleHelper\">Must provide at least 5. Drag to reorder.\t\t\t\t\t</div>\n\t\t<br clear=\"left\">\n\t\t<div class=\"grayRule\"> </div>\n\n\t\t<div class=\"instructions_table\">\n\t\t\t<div class=\"instructions_table_row\">\n\t\t\t\t<div class=\"instructions_table_cell left\">\n\t\t\t\t\t<strong>Design:</strong>\n\t\t\t\t</div>\n\t\t\t\t<div class=\"instructions_table_cell\">\n\t\t\t\t\t<p> Select screenshots that clearly show off the player perspective and gameplay in action.</p>\n\t\t\t\t\t<p> Select screenshots that clearly communicate the genre of your game. Showing HUD elements typically help communicate that to players pretty quickly.</p>\n\t\t\t\t\t<p> Avoid menu screens. See requirements below.</p>\n\t\t\t\t</div>\n\t\t\t</div>\n\n\t\t\t<div class=\"instructions_table_row\">\n\t\t\t\t<div class=\"instructions_table_cell left\">\n\t\t\t\t\t<strong>Formatting</strong>\n\t\t\t\t</div>\n\t\t\t\t<div class=\"instructions_table_cell\">\n\t\t\t\t\t<p>Should be high-res, widescreen format (16:9 aspect ratio) and at least 1920px x 1080px.</p>\n\t\t\t\t</div>\n\t\t\t</div>\n\n\t\t\t<div class=\"instructions_table_row\">\n\t\t\t\t<div class=\"instructions_table_cell left\">\n\t\t\t\t\t<strong>Localizing</strong>\n\t\t\t\t</div>\n\t\t\t\t<div class=\"instructions_table_cell\">\n\t\t\t\t\t<p>To upload localized versions of a screenshot, drag and drop alternative versions onto the designated area next to the screenshot below. Language name can be used as a suffix to hint to the UI which language this screenshot should be in (For example, foo_japanese.jpg)</p>\n\t\t\t\t</div>\n\t\t\t</div>\n\n\t\t\t<div class=\"instructions_table_row\">\n\t\t\t\t<div class=\"instructions_table_cell left\">\n\t\t\t\t\t<strong>Mature Content</strong>\n\t\t\t\t</div>\n\t\t\t\t<div class=\"instructions_table_cell\">\n\t\t\t\t\t<p>If your game has mature content, you should upload and mark at least four screenshots as being suitable for all ages. Suitable screenshots should not contain gore, violence, or suggestive themes. These screenshots may be shown outside of your store page, such as on the front page. If you do not have enough screenshots provided and properly flagged, your game may not appear in these places, even if it otherwise qualifies.</p>\n\t\t\t\t\t<p><span class=\"reference\">&#185;</span> For non-mature products, checking the 'suitable for all ages' option also works to specify a screenshot that Steam should prefer when choosing an image to show in places on Steam outside your store product page.</p>\n\t\t\t\t</div>\n\t\t\t</div>\n\n\t\t\t<div class=\"instructions_table_row\">\n\t\t\t\t<div class=\"instructions_table_cell left\">\n\t\t\t\t\t<strong>Requirements:</strong>\n\t\t\t\t</div>\n\t\t\t\t<div class=\"instructions_table_cell\">\n\t\t\t\t\t<p class=\"required\"><b>Screenshots</b> should exclusively show the gameplay of your game. This means avoiding using concept art, pre-rendered cinematic stills, or images showing awards, marketing copy, written descriptions, and so on. Please show customers what your game is actually like to play. Menu screens should only be included if they are a unique component of your game.</p>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t</div>\n\t</div>\n\t<br>\n\n\t<div class=\"image_hover_preview\" id=\"screenshot_preview\" style=\"display: none;\">\n\t\t<img style=\"width: 400px;\">\n\t</div>\n\n\t<div id=\"screenshots\" class=\"formrow\">\n\t\t<div  data-featuretarget=\"storeadmin-app-screenshot-alttext\"></div>\n\t\t<div id=\"screenshot_processing\">\n\t\t\t<div class=\"throbber\"></div>\n\t\t</div>\n\t\t<p>Grab screenshot thumbnails and drag up or down to change the order of screenshots on your store page.</p>\n\t\t<div id=\"screenshot_container\">\n\t\t\t\t\t\tNo screenshots have been uploaded\t\t\t<div style=\"clear: left\"></div>\n\t\t</div>\n\t</div>\n\t<div class=\"formrow\">\n\t\t<input class=\"btn_green_white_innerfade btn_border_2px btn_medium xtra_padding\" type=\"submit\" value=\"Save Changes\">\n\t</div>\n</div>\n\t\t\t</div>\n\t\t\n\t\t\t\t\t<div class=\"graphical_assets_tab_content\" data-tab=\"library\">\n\t\t\t\t\n\t\n<div class=\"instructions subsection overview\">\n\t<div class=\"graphical_assets_guidelines_title\">LIBRARY ASSET GUIDELINES</div>\n\t<div class=\"grayRule\"> </div>\n\n\t<div class=\"instructions_table\">\n\n        \n\n\t\t<div class=\"instructions_table_row\">\n\t\t\t<div class=\"instructions_table_cell left\">\n\t\t\t\t<strong>Overview:</strong>\t<!-- overview -->\n\t\t\t</div>\n\t\t\t<div class=\"instructions_table_cell\">\n\t\t\t\t<p>This section is for managing the images that represent your application in various parts of the Steam store and client. For best results, please upload .png files at the exact dimensions specified for each type. JPEG files are also accepted if necessary.</p>\n\t\t\t</div>\n\t\t</div>\n\n\t\t<div class=\"instructions_table_row\">\n\t\t\t<div class=\"instructions_table_cell left\">\n\t\t\t\t<strong>Templates:</strong>\t<!-- templates -->\n\t\t\t</div>\n\t\t\t<div class=\"instructions_table_cell\">\n\t\t\t\t<p>\n\t\t\t\t\tDownload Photoshop templates for the specific sized images here: <a href=\"https://www.dropbox.com/scl/fo/cvkwbosmrimklcl9h0qko/AF5IPErKP-mQM_3YO1Dw2lA?rlkey=b3ad0izykq367g4luasrinw9z&dl=0\" target=\"_blank\">Steam Templates on Dropbox</a>\t\t\t\t</p>\n\t\t\t</div>\n\t\t</div>\n\n        <div class=\"instructions_table_row\">\n            <div class=\"instructions_table_cell left\">\n                <strong>Documentation:</strong>\t<!-- documentation -->\n            </div>\n            <div class=\"instructions_table_cell\">\n                <p>\n                    <a href=\"https://partner.steamgames.com/doc/store/assets/libraryassets\" target=\"_blank\">Examples and more details</a                </p>\n            </div>\n        </div>\n\n\t\t<div class=\"instructions_table_row\">\n\t\t\t<div class=\"instructions_table_cell left\">\n\t\t\t\t<strong>Localization:</strong>\n\t\t\t</div>\n\t\t\t<div class=\"instructions_table_cell\">\n\t\t\t\t<p>Include the appropriate language name at the end of your file name to automatically assign that language. (for example \"capsule_sm_koreana.png\" will automatically assign it as Korean or \"capsule_sm_schinese.png\" will automatically assign it as Simplified Chinese)</p>\n                <p>For a full list of supported language names, please see \"API language code\" column in <a href=\"https://partner.steamgames.com/doc/store/localization#supported_languages\" target=\"_blank\">Localization and Languages Documentation</a>.</p>\n\t\t\t</div>\n\t\t</div>\n\n\t\t<div class=\"instructions_table_row\">\n\t\t\t<div class=\"instructions_table_cell left\">\n\t\t\t\t<strong>Requirements:</strong> <!-- requirements -->\n\t\t\t</div>\n\t\t\t<div class=\"instructions_table_cell\">\n                                    <p><em>Content on library assets is limited to game artwork and logo. Please see <a href=\"https://partner.steamgames.com/doc/store/assets/rules\">Graphical Asset Rules</a> for details. See below for specifications for each asset.</em></p>\n                    <p class=\"required\">* indicates required fields</p>\n                \t\t\t</div>\n\t\t</div>\n\t</div>\n</div>\n\n\n\n<div class=\"section\">\n\t<div class=\"instructions\">\n\t\t<div class=\"title2\">\n\t\t\tLibrary Capsule <span class=\"required\">*</span>\t\t</div>\n\t\t<div class=\"titleHelper\">\n\t\t\t600px wide x 900px tall\t\t\t\t\t</div>\n\t\t<br clear=\"left\">\n\t\t<div class=\"grayRule\"> </div>\n\t\t\n\t\t\t\t\t\t<div class=\"newformrow\">\n\t\t\t\t\t<div class=\"formlabel graphical_asset_desc_label\">Design:</div>\n\t\t\t\t\t<div class=\"formdata\">This should be graphically-centric and give the user some sense of the experience.  Please use the key art that is being used for any retail boxes or marketing as well as the name of your game, ideally using the same logo / title as printed on any retail or marketing. <em>Do not include quotes, marketing copy, or other strings of text beyond the title of your application.</em>  The art should depict something important about your product.  The logo should be easily legible against the background.</div>\n\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class=\"newformrow\">\n\t\t\t\t\t<div class=\"formlabel graphical_asset_desc_label\">Usage:</div>\n\t\t\t\t\t<div class=\"formdata\">This image is primarily used in the library overview and collection views</div>\n\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class=\"newformrow\">\n\t\t\t\t\t<div class=\"formlabel graphical_asset_desc_label\">Size:</div>\n\t\t\t\t\t<div class=\"formdata\">600px x 900px (an additional half-size 300px x 450px PNG will be auto-generated from larger file)</div>\n\t\t\t\t</div>\n\t\t\t\t</div>\n\t<br>\n\t<div class=\"image_type_section\">\n\t\t<div class=\"image_preview_col library_capsule\">\n\t\t\t\t\t\t\t<div class=\"noimage image_preview_badge warning\">No English image uploaded.</div>\n\t\t\t\t\t</div>\n\t\t<div class=\"image_language_col\">\n\t\t\t\t\t</div>\n\t</div>\n\t</div>\n<div class=\"section\">\n\t<div class=\"instructions\">\n\t\t<div class=\"title2\">\n\t\t\tLibrary Header <span class=\"required\">*</span>\t\t</div>\n\t\t<div class=\"titleHelper\">\n\t\t\t920px wide x 430px tall\t\t\t\t\t</div>\n\t\t<br clear=\"left\">\n\t\t<div class=\"grayRule\"> </div>\n\t\t\n\t\t\t\t\t\t<div class=\"newformrow\">\n\t\t\t\t\t<div class=\"formlabel graphical_asset_desc_label\">Design:</div>\n\t\t\t\t\t<div class=\"formdata\">This image should focus on the branding of your product. For best results, please use similar artwork to the Library Capsule and make sure the logo is clearly legible.</div>\n\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class=\"newformrow\">\n\t\t\t\t\t<div class=\"formlabel graphical_asset_desc_label\">Usage:</div>\n\t\t\t\t\t<div class=\"formdata\">Appears in various places in the Steam Client Library, including Recent Games. If not set, then the Header Capsule is used.</div>\n\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class=\"newformrow\">\n\t\t\t\t\t<div class=\"formlabel graphical_asset_desc_label\">Size:</div>\n\t\t\t\t\t<div class=\"formdata\">920px x 430px</div>\n\t\t\t\t</div>\n\t\t\t\t</div>\n\t<br>\n\t<div class=\"image_type_section\">\n\t\t<div class=\"image_preview_col library_header\">\n\t\t\t\t\t\t\t<div class=\"noimage image_preview_badge warning\">No English image uploaded.</div>\n\t\t\t\t\t</div>\n\t\t<div class=\"image_language_col\">\n\t\t\t\t\t</div>\n\t</div>\n\t</div>\n<div class=\"section\">\n\t<div class=\"instructions\">\n\t\t<div class=\"title2\">\n\t\t\tLibrary Hero <span class=\"required\">*</span>\t\t</div>\n\t\t<div class=\"titleHelper\">\n\t\t\t3840px wide x 1240px tall\t\t\t\t\t</div>\n\t\t<br clear=\"left\">\n\t\t<div class=\"grayRule\"> </div>\n\t\t\t\t\t<div class=\"formrow text\">\n\t\t\t\tThe hero graphic and logo are layered and move independently when the page is scrolled, creating a subtle parallax effect.  Consider how the product logo will be placed on top of the hero image (left bottom corner or centered).  You'll want to ensure the logo is both visible and legible against the background.\t\t\t</div>\n\t\t\n\t\t\t\t\t\t<div class=\"newformrow\">\n\t\t\t\t\t<div class=\"formlabel graphical_asset_desc_label\">Design:</div>\n\t\t\t\t\t<div class=\"formdata\">This should be a visually rich image that is easily recognizable.  For best results, please use the key art that is used for any retail boxes or marketing.  Do not include quotes or other strings of text.<br><br>\n\t\t\t\t\t\t\t\t\t\t\t\tAt the center of the template is a \"safe area\" of 860px x 380px.  This area will remain uncropped across scaling and resizing of the Steam client window.  Artwork should extend across the entire template, but critical content should be within the safe area.  For ex: a main character's face should be entirely in the safe area or risk being cropped.<br><br>\n\t\t\t\t\t\t\t\t\t\t\t\t<em>Library Hero image should not contain any text or logos. Your logo to display at the top of your library detail page should be uploaded separately in the Library Logo file (details below).</em></div>\n\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class=\"newformrow\">\n\t\t\t\t\t<div class=\"formlabel graphical_asset_desc_label\">Usage:</div>\n\t\t\t\t\t<div class=\"formdata\">Appears at the top of a user's library details page for this product.</div>\n\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class=\"newformrow\">\n\t\t\t\t\t<div class=\"formlabel graphical_asset_desc_label\">Size:</div>\n\t\t\t\t\t<div class=\"formdata\">3840px x 1240px (an additional half-size 1920px x 620px PNG will be auto-generated from larger file)</div>\n\t\t\t\t</div>\n\t\t\t\t</div>\n\t<br>\n\t<div class=\"image_type_section\">\n\t\t<div class=\"image_preview_col library_hero\">\n\t\t\t\t\t\t\t<div class=\"noimage image_preview_badge warning\">No English image uploaded.</div>\n\t\t\t\t\t</div>\n\t\t<div class=\"image_language_col\">\n\t\t\t\t\t</div>\n\t</div>\n\t</div>\n<div class=\"section\">\n\t<div class=\"instructions\">\n\t\t<div class=\"title2\">\n\t\t\tLibrary Logo <span class=\"required\">*</span>\t\t</div>\n\t\t<div class=\"titleHelper\">\n\t\t\tEither 1280px wide and/or 720px tall\t\t\t\t\t</div>\n\t\t<br clear=\"left\">\n\t\t<div class=\"grayRule\"> </div>\n\t\t\t\t\t<div class=\"formrow text\">\n\t\t\t\tAfter upload, you can use the preview tool to select the logo's position.  Options include: left bottom corner, centered top, centered middle, and centered bottom.<br><br>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t<strong>Note:</strong> If a hero graphic and logo are not uploaded, the hero area will display a screenshot from the store, with the application name in text overlaid in the bottom left corner.\t\t\t</div>\n\t\t\n\t\t\t\t\t\t<div class=\"newformrow\">\n\t\t\t\t\t<div class=\"formlabel graphical_asset_desc_label\">Design:</div>\n\t\t\t\t\t<div class=\"formdata\">For best results, use the logo that is being used for any retail boxes or marketing. You’ll want to ensure the logo is both visible and legible against the hero graphic background, sometimes a drop shadow can help. The PNG image should have a transparent background. You should use the best aspect ratio for your art, however the logo must be either 1280px wide and/or 720px tall.</div>\n\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class=\"newformrow\">\n\t\t\t\t\t<div class=\"formlabel graphical_asset_desc_label\">Usage:</div>\n\t\t\t\t\t<div class=\"formdata\">Appears at the top of a user's library details page for this product, placed on top of the hero graphic.</div>\n\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class=\"newformrow\">\n\t\t\t\t\t<div class=\"formlabel graphical_asset_desc_label\">Size:</div>\n\t\t\t\t\t<div class=\"formdata\">Either 1280px wide and/or 720px tall (an additional half-size PNG will be auto-generated based on your logo's aspect ratio).</div>\n\t\t\t\t</div>\n\t\t\t\t</div>\n\t<br>\n\t<div class=\"image_type_section\">\n\t\t<div class=\"image_preview_col library_logo\">\n\t\t\t\t\t\t\t<div class=\"noimage image_preview_badge warning\">No English image uploaded.</div>\n\t\t\t\t\t</div>\n\t\t<div class=\"image_language_col\">\n\t\t\t\t\t</div>\n\t</div>\n\t</div>\n\n<div class=\"section\">\n\t<div class=\"instructions\">\n\t\t<div class=\"title2\">\n\t\t\tPlacement Tool <span class=\"required\">*</span>\t\t</div>\n\t\t<br clear=\"left\">\n\t\t<div class=\"grayRule\"> </div>\n\t\t<div class=\"formrow text\">\n\t\t\t<p>The four green anchor points relate to the four possible positions your logo can be pinned.  Bottom-left, top center, mid-center, and bottom-center.</p>\n\t\t\t<p>In most cases, the bottom-left position should be used.</p>\n\t\t\t<p>\n\t\t\t\tYou may want a centered logo if...\t\t\t<ul>\n\t\t\t\t<li>Your logo is symmetrical or close to symmetrical or a logo that's contained in a circle.</li>\n\t\t\t\t<li>Your background header image has more of the interesting parts on the outside edges and the center has areas of rest.</li>\n\t\t\t\t<li>Your background header image is symmetrically balanced and positioning the logo in the bottom-left throws the balance off.</li>\n\t\t\t</ul>\n\t\t\t</p>\n\t\t\t<p>Once you have determined your logo position, use the blue logo box to size your logo appropriately. The blue box acts as a bounding box for the logo, it will not scale outside this box. The right edge of the blue box determines the maximum proportion the logo will scale to compared to the background hero graphic (this is useful if there is background art you don’t want the logo to overlap.) The top edge of the blue box determines the maximum size the logo will scale to (this is useful if you are finding the logo is too big when the window has been scaled up.)</p>\n\t\t\t<p>Typically you can take the top edge and leave it higher than the bounds of the logo. Play around with it and try scaling your window to get a sense for how your logo will adjust as the window scale changes.</p>\n\t\t\t<p>Once you are happy with your logo position, proportion, and scale, hit the save button to commit your changes.</p>\n\n\t\t\t<script type=\"text/javascript\">\n\t\t\t\tfunction ShowLibraryLogoEditPopup()\n\t\t\t\t{\n\t\t\t\t\twindow.open( 'https://partner.steamgames.com/admin/game/librarylogoeditorpopup/1000000', 'LibraryLogoPositionEdit', 'width=1230,height=720,menu=no,resize=yes,scrollbars=yes' );\n\t\t\t\t}\n\t\t\t</script>\n\n\t\t\t<div class=\"formrow launch_library_placement_tool\">\n\t\t\t\t<button class=\"btn_blue_steamui btn_medium\" type=\"button\" onclick=\"ShowLibraryLogoEditPopup()\">\n\t\t\t\t\t<span>Open Placement Tool</span>\n\t\t\t\t</button>\n\t\t\t</div>\n\t\t\t<div class=\"formrow\" style=\"text-align: center\">\n\t\t\t\tExamples:\t\t\t</div>\n\t\t\t<div class=\"formrow\" style=\"text-align: center\">\n\t\t\t\t<img src=\"https://partner.steamgames.com/public/images/storeadmin_libraryhero_examples.png\">\n\t\t\t</div>\n\n\n\t\t</div>\n\t</div>\n</div>\n\n<div class=\"section\">\n\t<div class=\"formrow\">\n\n\t</div>\n</div>\n\t\t\t</div>\n\t\t\n\t\t\t\t\t<div class=\"graphical_assets_tab_content\" data-tab=\"broadcast\">\n\t\t\t\t<div class=\"section\" id=\"broadcast_images\">\n\t<h2 class=\"inline\">Steam Broadcast (Beta)</h2> <span> Two images, each 199px wide x 433px tall</span>\n\t<div class=\"grayRule\"> </div>\n\t<div class=\"formrow\">The live broadcast will appear on the store page above the trailer and the screenshot section. The broadcast video is smaller than the width of the store page. It is centered with customizable artwork space on the left and right of the video. To customize with your own artwork, drag & drop images at the top of this page and choose the 'broadcast panel' and the right/left direction from the drop-down.</div>\n\t<div class=\"broadcast_template_container\">\n\t\t\t\t\t<div class=\"broadcast_template_radio\">\n\t\t\t\t<input id=\"broadcast_template_0\" type=\"radio\" name=\"app[broadcast][sidepanel_template]\" value=\"0\" checked/>\n\t\t\t\t<label for=\"broadcast_template_0\">Steam Artwork Template 1</label>\n\t\t\t</div>\n\t\t\t\t\t<div class=\"broadcast_template_radio\">\n\t\t\t\t<input id=\"broadcast_template_1\" type=\"radio\" name=\"app[broadcast][sidepanel_template]\" value=\"1\" />\n\t\t\t\t<label for=\"broadcast_template_1\">Steam Artwork Template 2</label>\n\t\t\t</div>\n\t\t\t\t\t<div class=\"broadcast_template_radio\">\n\t\t\t\t<input id=\"broadcast_template_2\" type=\"radio\" name=\"app[broadcast][sidepanel_template]\" value=\"2\" />\n\t\t\t\t<label for=\"broadcast_template_2\">Steam Artwork Template 3</label>\n\t\t\t</div>\n\t\t\t\t<div class=\"broadcast_template_radio\">\n\t\t\t<input id=\"broadcast_template_custom\" type=\"radio\" name=\"app[broadcast][sidepanel_template]\" value=\"custom\"  disabled/>\n\t\t\t<label for=\"broadcast_template_custom\">No custom artwork available (requires both left and right panels)</label>\n\t\t</div>\n\t\t<br/>\n\n\t\t<div class=\"partner_broadcast_container\">\n\t\t\t<table class=\"partner_broadcast_table\">\n\t\t\t\t<tr>\n\t\t\t\t\t<td class=\"partner_broadcast_col\">Left Panel:</td>\n\t\t\t\t\t<td class=\"partner_broadcast_col\">Example Broadcast:</td>\n\t\t\t\t\t<td class=\"partner_broadcast_col\">Right Panel:</td>\n\t\t\t\t</tr>\n\t\t\t\t<tr>\n\t\t\t\t\t<td class=\"partner_broadcast_col\"><img class=\"partner_broadcast_side_panel\" id=\"broadcast_left_panel\" src=\"https://partner.steamgames.com/public/images/broadcast/Template_Left1.jpg\" alt=\"Broadcast left Panel\"></td>\n\t\t\t\t\t<td class=\"partner_broadcast_col\"><img id=\"broadcast_dummy_previous\" src=\"https://partner.steamgames.com/public/images/broadcast/broadcast_middle_preview.png\"></td>\n\t\t\t\t\t<td class=\"partner_broadcast_col\"><img class=\"partner_broadcast_side_panel\" id=\"broadcast_right_panel\" src=\"https://partner.steamgames.com/public/images/broadcast/Template_Right1.jpg\" alt=\"Broadcast right Panel\"></td>\n\t\t\t\t</tr>\n\t\t\t</table>\n\t\t</div>\n\t</div>\n\t<div class=\"formrow\">\n\t\t<input class=\"btn_green_white_innerfade btn_border_2px btn_medium xtra_padding\" type=\"submit\" value=\"Save Changes\">\n\t</div>\n</div>\n<script type=\"application/javascript\">\n\t\t$J( document ).ready( function() {\n\t\t$J('input:radio[name=\"app[broadcast][sidepanel_template]\"]' ).change( function(){\n\t\t\tvar left = $J(\"#broadcast_left_panel\");\n\t\t\tvar right = $J(\"#broadcast_right_panel\");\n\t\t\tif( $J(this).val() === \"custom\" )\n\t\t\t{\n\t\t\t\tleft.attr( \"src\", \"\" );\n\t\t\t\tright.attr( \"src\", \"\" );\n\t\t\t}\n\t\t\telse\n\t\t\t{\n\t\t\t\tleft.attr( \"src\" , \"https://partner.steamgames.com/public/images/broadcast/Template_Left\" + ( parseInt( $J(this).val() ) + 1) + \".jpg\");\n\t\t\t\tright.attr( \"src\" , \"https://partner.steamgames.com/public/images/broadcast/Template_Right\" + ( parseInt( $J(this).val() ) + 1) + \".jpg\");\n\t\t\t}\n\t\t});\n\t});\n</script>\n\t\t\t</div>\n\t\t\n\t</div>\n</div>\n\n<script>\n\tif ( BBrowserSupportsFormData() )\n\t{\n\t\tjQuery(document).ready( function()\n\t\t{\n\t\t\t$J( '#game_image_drop' ).bind( 'dragenter', OnImageDragEnter );\n\t\t\t$J( '#game_image_drop' ).bind( 'dragleave', OnImageDragLeave );\n\t\t\t$J( '#game_image_drop' ).bind( 'dragover', OnImageDragOver );\n\t\t\t$J( '#game_image_drop' ).bind( 'drop', OnImageDrop );\n\n\t\t\t$J( '.screenshot_loc_drag_drop' ).bind( 'dragenter', OnImageDragEnter );\n\t\t\t$J( '.screenshot_loc_drag_drop' ).bind( 'dragleave', OnImageDragLeave );\n\t\t\t$J( '.screenshot_loc_drag_drop' ).bind( 'dragover', OnImageDragOver );\n\t\t\t$J( '.screenshot_loc_drag_drop' ).bind( 'drop', OnScreenshotDrop );\n\t\t});\n\t}\n\telse\n\t{\n\t\t$J( \"#ScreenshotNoFormData\" ).show();\n\t\t$J( \"#ScreenshotFormData\" ).hide();\n\t}\n\n\t// highlight specified subtab if specified on query\n\tconst urlParams = new URLSearchParams( window.location.search );\n\tconst sSubTab = urlParams.get( 'subtab' );\n\tif ( sSubTab )\n\t{\n\t\tconst fnIsSubTab = function() { return $J( this ).data( 'tab' ) === sSubTab; };\n\t\t$J( '.graphical_assets_tab' ).filter( fnIsSubTab ).addClass( 'active' ).siblings().removeClass( 'active' );\n\t\t$J( '.graphical_assets_tab_content' ).filter( fnIsSubTab ).addClass( 'active' ).siblings().removeClass( 'active' );\n\n\t\tif ( sSubTab !== 'store' )\n\t\t\tAgreeToBaseAssetsUpload();\n\t}\n</script>\n\n<div  data-featuretarget=\"storeadmin-graphicalassets-confirmdialog\" data-props=\"{&quot;itemid&quot;:&quot;2000000&quot;,&quot;apptype&quot;:&quot;Game&quot;,&quot;altasset&quot;:&quot;&quot;,&quot;altpostfix&quot;:&quot;&quot;}\"></div></div>\n\n\n\t<div class=\"tab_content \" id=\"tab_specialsettings_content\">\n\t\t<script type=\"text/javascript\">\n\tfunction OnDemoNameCompletion( demoAppIdInputId ) {\n\t\t$J( '#next_demo_show_above_purchase' ).val( !!$J( demoAppIdInputId ).val() );\n    }\n</script>\n\n\n\t\n\t\n\t\n\n\n\n\t<div class=\"section\" id=\"pinned_bundles\">\n\t\t<h2>Pinned bundles</h2>\n\t\t<div class=\"grayRule\"></div>\n\t\t<div class=\"sectionDescription\">\n\t\t\t<p>A maximum of three bundles will appear on your product store page. By default, bundles are ordered by price starting with the least expensive bundle for the user viewing the page. If you would like to pin any bundles to appear at the top of the list, select them here.</p>\n\t\t</div>\n\n\t\t<div  data-featuretarget=\"storeadmin-pinnedbundles-edit\" data-props=\"{&quot;rgPinnedBundles&quot;:[],&quot;rgEnabledBundles&quot;:[]}\"></div>\t</div>\n\n\t<div class=\"section\" id=\"downloadable_content\">\n\t\t<h2>Downloadable Content</h2>\n\t\t<div class=\"grayRule\"></div>\n\t\t<div class=\"sectionDescription\">\n\t\t\t<p>If you have downloadable content for this application, it should be added here in order to show up on this application's store page as a purchasable option.\t\t\t\tThis will also be used for the default ordering of DLC in <a href='https://store.steampowered.com/dlc/1000000' target='_blank'>the DLC Browse page</a>. You can customize the DLC browse page. <a href='https://partner.steamgames.com//doc/store/application/dlc/browse' target='_blank'>Learn more here</a>.\t\t\t</p>\n\t\t\t<p>Highlight your top-most item in this list to make it appear as a larger format, which includes the capsule. <span class=\"new\">NEW!</span></p>\n\t\t</div>\n\n\t\t<div  data-featuretarget=\"storeadmin-dlc-edit\" data-props=\"{&quot;rgDLC&quot;:[],&quot;parentappid&quot;:&quot;1000000&quot;}\"></div>\t</div>\n\n\t<div class=\"section\" id=\"associated_demos\">\n\t\t<h2>Associated Demos</h2>\n\t\t<div class=\"grayRule\"></div>\n\t\t<div class=\"sectionDescription\">If you have a demo for this application, it should be added here in order to show up on this application's store page. Enter the demo title or appID into the field and select the desired application from the drop-down list to select.</div>\n\n\t\t<div class=\"boxlist\">\n\t\t\t\t\t</div>\n\t\t<div class=\"formrow shaded\">\n\t\t\t\t\t<input type=\"text\" id=\"app_related_items_demos_0_itemid__compl\" name=\"app[related_items][demos][0][itemid]_compl\" size=\"45\" onfocus=\"AutocompleteOnFocus( this );\" value=\"\" placeholder=\"\">\n\t\t<div class=\"autocomplete\" id=\"app_related_items_demos_0_itemid__list\" style=\"display: none;\"></div>\n\t\t<input name=\"app[related_items][demos][0][itemid]\" id=\"app_related_items_demos_0_itemid__target\" type=\"hidden\" value=\"\" onchange=\"OnDemoNameCompletion( '#app_related_items_demos_0_itemid__target' )\">\n\t\t<input id=\"app_related_items_demos_0_itemid__compl_check\" type=\"hidden\" value=\"\">\n\n\t\t\t\t\t<input type=\"hidden\" name=\"app[related_items][demos][0][show_above_purchase]\" id=\"next_demo_show_above_purchase\" value=\"\"/>\n\t\t\t<input class=\"btn_darkblue_white_innerfade btn_small_thin\" type=\"submit\"\n\t\t\t\t   value=\"Add demo\">\n\t\t\tAssociate selected demo with this application\t\t</div>\n\t</div>\n\n\n\t<script>\n\t\tfunction AjaxGetAssociatedPlaytest()\n\t\t{\n\t\t\t$J( '#playtest_result' ).removeClass( 'errormsg' );\n\t\t\t$J( '#playtest_result' ).html( 'Loading...' );\n\n\t\t\t$J.post( 'https://partner.steamgames.com/game/ajaximportplaytest/2000000', {\n\t\t\t\tsessionid: g_sessionID }\n\t\t\t).done( function( response ) {\n\t\t\t\tif ( response.success == 1 )\n\t\t\t\t{\n\t\t\t\t\t$J( '#playtest_result' ).addClass( 'successmsg' );\n\t\t\t\t\t$J( '#playtest_result' ).html( 'Ok' );\n\t\t\t\t\t// reload so the \"this requires publish\" warning shows\n\t\t\t\t\twindow.location.reload();\n\t\t\t\t}\n\t\t\t\telse\n\t\t\t\t{\n\t\t\t\t\t$J( '#playtest_result' ).addClass( 'errormsg' );\n\t\t\t\t\tif ( response.success == 42 )\n\t\t\t\t\t{\n\t\t\t\t\t\t$J( '#playtest_result' ).html( 'Oops! No associated Playtest found.' );\n\t\t\t\t\t}\n\t\t\t\t\telse if ( response.success == 11 )\n\t\t\t\t\t{\n\t\t\t\t\t\t$J( '#playtest_result' ).html( 'Your Playtest app cannot be shown here because it is Unreleased.' );\n\t\t\t\t\t}\n\t\t\t\t\telse\n\t\t\t\t\t{\n\t\t\t\t\t\t$J( '#playtest_result' ).html( 'An error occurred. Please try again.' );\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t} );\n\t\t}\n\t</script>\n\n\t<div class=\"section\" id=\"associated_playtest\">\n\t\t<h2 class=\"inline\">\n\t\t\tSteam Playtest\t\t</h2>\n\n\t\t<span><a href=\"https://partner.steamgames.com/doc/features/playtest\" target=\"_blank\">(Read More...)</a></span>\n\n\t\t<div class=\"grayRule\"></div>\n\t\t<div class=\"sectionDescription\">You can offer limited access to a pool of testers that want to help test your game.</div>\n\n\t\t\t\t\t<div>Create or configure the Playtest for your game on the <a href=\"https://partner.steamgames.com/apps/associated/1000000\">Associated Apps page</a>.</div>\n\t\t\t<div>When you are ready to offer access to your Playtest on this store page, <a href=\"\" onclick=\"AjaxGetAssociatedPlaytest();return false;\">click here to set up visibility</a>. Note that this requires your Playtest's store presence to be approved for release and will make your Playtest publicly known, even if it is not visible yet.</div>\n\t\t\t<div id=\"playtest_result\"></div>\n\t\t\t\t</div>\n\n\t<div class=\"section instructions\">\n\t\t<h2 class=\"inline\">Steam Broadcast (Beta)</h2><span><a href=\"https://partner.steamgames.com/doc/store/broadcast\" target=\"_blank\">(Read More...)</a></span>\n\t\t<div class=\"grayRule\"> </div>\n\t\t<p>Store broadcast allows the hosting of a live stream directly on this games product page. You can customize the artwork shown surrounding the broadcast window in the 'Graphical Assets' tab.</p>\n\n\t\t<h4>Broadcaster Allow List<span id=\"broadcast_dirty\" style=\"display:none;\" >  **Modified<a  data-tooltip-text=\"You have changed the list of broadcasters or have re-ordered them. Remember to SAVE before leaving the page to keep your changes. Save is NOT automatic. Remember to Publish the App if you want the store to see the new ordered list of broadcasters.\"  class=\"ttip\">(?)</a>**</span></h4>\n\t\t<p>Add broadcasters that are permitted to stream on your product page across the Steam store.  Their live content will automatically appear as long as the streamer has chosen this game to stream by either 1) explicitly choosing it during the RTMP setup or 2) by using the Steam client built-in streaming capabilities while play the game. You can order the allow list by dragging the elements. The rank provides Steam guidance on which streamer to feature if more than one is streaming simultaneously. You can allow up to 100 streamers. </p>\n\t\t\t\t<div class=\"broadcasters_table\" id=\"broadcasters_table\">\n\t\t\t<div class=\"heading ui-state-disabled\">\n\t\t\t\t<div class=\"ui-state-disabled\">&nbsp;</div>\n\t\t\t\t<div class=\"ui-state-disabled\">Rank</div>\n\t\t\t\t<div class=\"ui-state-disabled\">Avatar</div>\n\t\t\t\t<div class=\"ui-state-disabled\">Broadcaster Persona</div>\n\t\t\t\t<div class=\"ui-state-disabled\">Actions</div>\n\t\t\t</div>\n\t\t</div>\n\t\t<br/>\n\t\t<div class=\"broadcaster_id_panel\">\n\t\t\t<button type=\"button\" onclick=\"g_BroadcasterWhiteList.AddBroadcaster( {&quot;m_strAvatarImgURL&quot;:&quot;https:\\/\\/avatars.akamai.steamstatic.com\\/ffffffffffffffffffffffffffffffffffff0009_medium.jpg&quot;,&quot;m_strPersonaName&quot;:&quot;Redacted&quot;,&quot;m_nAccountID&quot;:100000001,&quot;m_strSteamID&quot;:&quot;76561190000000001&quot;} ); return false;\">Add me as a Broadcaster</button>\n\t\t\t<div id=\"choose_friend_throbber\" style=\"display: none;\">\n\t\t\t\tLoading... <img class=\"throbber\" src=\"https://store.akamai.steamstatic.com//public/shared/images/login/throbber.gif\" alt=\"\" >\n\t\t\t</div>\n\t\t\t<button type=\"button\" onclick=\"g_BroadcasterWhiteList.ClearAll(); return false\">Clear List</button>\n\t\t\t<button type=\"button\" onclick=\"g_BroadcasterWhiteList.ChooseBroadcasterFromFriends( '76561190000000001', '2000000'); return false;\">Choose broadcaster to add from Steam friends list</button>\n\t\t</div>\n\t\t\t\t<br/>\n\t\t<br/>\n\t\t<h4>Broadcast Chat on Product Page Visibility (Beta): </h4>\n<div class=\"formrow\">\n\t<p>Controls whether the broadcast chat is displayed on this product page beside the live broadcast. If the chat is visible by default, it may encourage your audience to engage with your broadcaster. You may also decide to hide it and then let the viewer decide whether to open it. Or you can remove chat all together from the product page; note that the chat will always be accessible from the live broadcast on the community page.</p>\n\t<div class=\"formdata\">\n\t\t<input type=\"radio\" name=\"app[broadcast][chat_visibility]\" size=\"20\" value=\"show\" >\n\t</div>\n\t<div class=\"formlabel\">Show Chat by Default</div>\n\t<div class=\"formdata\">\n\t\t<input type=\"radio\" name=\"app[broadcast][chat_visibility]\" size=\"20\" value=\"hide\" checked='checked'>\n\t</div>\n\t<div class=\"formlabel\">Hide Chat by Default</div>\n\t<div class=\"formdata\">\n\t\t<input type=\"radio\" name=\"app[broadcast][chat_visibility]\" size=\"20\" value=\"remove\" >\n\t</div>\n\t<div class=\"formlabel\">Remove Chat from the Product Page</div>\n</div>\n\t\t<h4>Broadcast Title (Beta):</h4>\n\t\t<div class=\"formrow\">\n\t\t\t<p>The title will appear above the live broadcast on the product page. Either create a custom title up to 100 characters or choose from our default title list. The default titles have localized text.</p>\n\t\t\t<select name=\"app[broadcast][title_choice]\" id=\"app_broadcast_title_choice__entry\">\n<option selected=\"selected\" value=\"1\">Now Broadcasting: Watch the developer play</option>\n<option value=\"2\">Now Broadcasting: Watch the community play</option>\n<option value=\"3\">Now Broadcasting: Watch this competitive match</option>\n<option value=\"4\">Now Broadcasting: Watch this speed run</option>\n<option value=\"5\">Now Broadcasting</option>\n<option value=\"6\">Now Broadcasting: Chat with the Developers</option>\n<option value=\"7\">Now Broadcasting: Join the AMA</option>\n<option value=\"custom\">Use Custom Title</option>\n</select>\t\t\t<p>\n\t\t\t\tEnter Custom Broadcast Title:\n\t\t\t\t<div id=\"app_broadcast_title_custom__area\" class=\"LocTextArea\"><input type=\"text\" id=\"app_broadcast_title_custom__textarea\" onchange=\"OnLocTextChanged( 'app_broadcast_title_custom_' )\"><input type=\"hidden\" id=\"app_broadcast_title_custom__currentlanguage\"><input type=\"hidden\" id=\"app_broadcast_title_custom_english__hidden\" name=\"app[broadcast][title_custom][english]\" value=\"\" lang=\"en\"><input type=\"hidden\" id=\"app_broadcast_title_custom_french__hidden\" name=\"app[broadcast][title_custom][french]\" value=\"\" lang=\"fr\"><input type=\"hidden\" id=\"app_broadcast_title_custom_italian__hidden\" name=\"app[broadcast][title_custom][italian]\" value=\"\" lang=\"it\"><input type=\"hidden\" id=\"app_broadcast_title_custom_german__hidden\" name=\"app[broadcast][title_custom][german]\" value=\"\" lang=\"de\"><input type=\"hidden\" id=\"app_broadcast_title_custom_spanish__hidden\" name=\"app[broadcast][title_custom][spanish]\" value=\"\" lang=\"es\"><input type=\"hidden\" id=\"app_broadcast_title_custom_bulgarian__hidden\" name=\"app[broadcast][title_custom][bulgarian]\" value=\"\" lang=\"bg\"><input type=\"hidden\" id=\"app_broadcast_title_custom_czech__hidden\" name=\"app[broadcast][title_custom][czech]\" value=\"\" lang=\"cs\"><input type=\"hidden\" id=\"app_broadcast_title_custom_danish__hidden\" name=\"app[broadcast][title_custom][danish]\" value=\"\" lang=\"da\"><input type=\"hidden\" id=\"app_broadcast_title_custom_dutch__hidden\" name=\"app[broadcast][title_custom][dutch]\" value=\"\" lang=\"nl\"><input type=\"hidden\" id=\"app_broadcast_title_custom_finnish__hidden\" name=\"app[broadcast][title_custom][finnish]\" value=\"\" lang=\"fi\"><input type=\"hidden\" id=\"app_broadcast_title_custom_greek__hidden\" name=\"app[broadcast][title_custom][greek]\" value=\"\" lang=\"el\"><input type=\"hidden\" id=\"app_broadcast_title_custom_hungarian__hidden\" name=\"app[broadcast][title_custom][hungarian]\" value=\"\" lang=\"hu\"><input type=\"hidden\" id=\"app_broadcast_title_custom_indonesian__hidden\" name=\"app[broadcast][title_custom][indonesian]\" value=\"\" lang=\"id\"><input type=\"hidden\" id=\"app_broadcast_title_custom_japanese__hidden\" name=\"app[broadcast][title_custom][japanese]\" value=\"\" lang=\"ja\"><input type=\"hidden\" id=\"app_broadcast_title_custom_koreana__hidden\" name=\"app[broadcast][title_custom][koreana]\" value=\"\" lang=\"ko\"><input type=\"hidden\" id=\"app_broadcast_title_custom_malay__hidden\" name=\"app[broadcast][title_custom][malay]\" value=\"\" lang=\"ms\"><input type=\"hidden\" id=\"app_broadcast_title_custom_norwegian__hidden\" name=\"app[broadcast][title_custom][norwegian]\" value=\"\" lang=\"no\"><input type=\"hidden\" id=\"app_broadcast_title_custom_polish__hidden\" name=\"app[broadcast][title_custom][polish]\" value=\"\" lang=\"pl\"><input type=\"hidden\" id=\"app_broadcast_title_custom_brazilian__hidden\" name=\"app[broadcast][title_custom][brazilian]\" value=\"\" lang=\"pt-br\"><input type=\"hidden\" id=\"app_broadcast_title_custom_portuguese__hidden\" name=\"app[broadcast][title_custom][portuguese]\" value=\"\" lang=\"pt\"><input type=\"hidden\" id=\"app_broadcast_title_custom_romanian__hidden\" name=\"app[broadcast][title_custom][romanian]\" value=\"\" lang=\"ro\"><input type=\"hidden\" id=\"app_broadcast_title_custom_russian__hidden\" name=\"app[broadcast][title_custom][russian]\" value=\"\" lang=\"ru\"><input type=\"hidden\" id=\"app_broadcast_title_custom_schinese__hidden\" name=\"app[broadcast][title_custom][schinese]\" value=\"\" lang=\"zh-cn\"><input type=\"hidden\" id=\"app_broadcast_title_custom_latam__hidden\" name=\"app[broadcast][title_custom][latam]\" value=\"\" lang=\"es-419\"><input type=\"hidden\" id=\"app_broadcast_title_custom_swedish__hidden\" name=\"app[broadcast][title_custom][swedish]\" value=\"\" lang=\"sv\"><input type=\"hidden\" id=\"app_broadcast_title_custom_thai__hidden\" name=\"app[broadcast][title_custom][thai]\" value=\"\" lang=\"th\"><input type=\"hidden\" id=\"app_broadcast_title_custom_tchinese__hidden\" name=\"app[broadcast][title_custom][tchinese]\" value=\"\" lang=\"zh-tw\"><input type=\"hidden\" id=\"app_broadcast_title_custom_turkish__hidden\" name=\"app[broadcast][title_custom][turkish]\" value=\"[turkish text removed]\" lang=\"tr\"><input type=\"hidden\" id=\"app_broadcast_title_custom_ukrainian__hidden\" name=\"app[broadcast][title_custom][ukrainian]\" value=\"\" lang=\"uk\"><input type=\"hidden\" id=\"app_broadcast_title_custom_vietnamese__hidden\" name=\"app[broadcast][title_custom][vietnamese]\" value=\"\" lang=\"vi\"><select id=\"app_broadcast_title_custom__select\" class=\"LocTextAreaLangSelect\" onfocus=\"LocUpdateLangThatHaveText( 'app_broadcast_title_custom_' )\" onchange=\"OnLocLanguageSelect( 'app_broadcast_title_custom_' )\"><option id=\"app_broadcast_title_custom_english__option\" value=\"english\">English</option><option id=\"app_broadcast_title_custom_french__option\" value=\"french\">French</option><option id=\"app_broadcast_title_custom_italian__option\" value=\"italian\">Italian</option><option id=\"app_broadcast_title_custom_german__option\" value=\"german\">German</option><option id=\"app_broadcast_title_custom_spanish__option\" value=\"spanish\">Spanish - Spain</option><option id=\"app_broadcast_title_custom_bulgarian__option\" value=\"bulgarian\">Bulgarian</option><option id=\"app_broadcast_title_custom_czech__option\" value=\"czech\">Czech</option><option id=\"app_broadcast_title_custom_danish__option\" value=\"danish\">Danish</option><option id=\"app_broadcast_title_custom_dutch__option\" value=\"dutch\">Dutch</option><option id=\"app_broadcast_title_custom_finnish__option\" value=\"finnish\">Finnish</option><option id=\"app_broadcast_title_custom_greek__option\" value=\"greek\">Greek</option><option id=\"app_broadcast_title_custom_hungarian__option\" value=\"hungarian\">Hungarian</option><option id=\"app_broadcast_title_custom_indonesian__option\" value=\"indonesian\">Indonesian</option><option id=\"app_broadcast_title_custom_japanese__option\" value=\"japanese\">Japanese</option><option id=\"app_broadcast_title_custom_koreana__option\" value=\"koreana\">Korean</option><option id=\"app_broadcast_title_custom_malay__option\" value=\"malay\">Malay</option><option id=\"app_broadcast_title_custom_norwegian__option\" value=\"norwegian\">Norwegian</option><option id=\"app_broadcast_title_custom_polish__option\" value=\"polish\">Polish</option><option id=\"app_broadcast_title_custom_brazilian__option\" value=\"brazilian\">Portuguese - Brazil</option><option id=\"app_broadcast_title_custom_portuguese__option\" value=\"portuguese\">Portuguese - Portugal</option><option id=\"app_broadcast_title_custom_romanian__option\" value=\"romanian\">Romanian</option><option id=\"app_broadcast_title_custom_russian__option\" value=\"russian\">Russian</option><option id=\"app_broadcast_title_custom_schinese__option\" value=\"schinese\">Simplified Chinese</option><option id=\"app_broadcast_title_custom_latam__option\" value=\"latam\">Spanish - Latin America</option><option id=\"app_broadcast_title_custom_swedish__option\" value=\"swedish\">Swedish</option><option id=\"app_broadcast_title_custom_thai__option\" value=\"thai\">Thai</option><option id=\"app_broadcast_title_custom_tchinese__option\" value=\"tchinese\">Traditional Chinese</option><option id=\"app_broadcast_title_custom_turkish__option\" value=\"turkish\">Turkish</option><option id=\"app_broadcast_title_custom_ukrainian__option\" value=\"ukrainian\">Ukrainian</option><option id=\"app_broadcast_title_custom_vietnamese__option\" value=\"vietnamese\">Vietnamese</option></select></div>\t\t\t</p>\n\t\t</div>\n\t</div>\n\n\n<div id=\"creator_homes_edit\" data-featuretarget=\"storeadmin-creator-home-display-edit\" data-props=\"{&quot;appid&quot;:1000000,&quot;rgCreatorHomes&quot;:[],&quot;creatorNames&quot;:{&quot;rgDevelopers&quot;:[],&quot;rgPublishers&quot;:[],&quot;rgFrachises&quot;:[]},&quot;oInputFeatured&quot;:null,&quot;groupvanityinfo&quot;:null}\"></div>\n\n\n\n\n\n\n\n\n\n\n\n<div class=\"form_footer sticky_save_bar\">\n\t<div><input class=\"btn_green_white_innerfade btn_medium xtra_padding\" type=\"submit\" value=\"Save\"></div>\n</div>\n\t</div>\n\n\t<div class=\"tab_content \" id=\"tab_localization_content\">\n\t<div class=\"section\">\n\t\t<h2>Localization</h2>\n\t\t<p>Download a JSON file of text that can be localized, modify them in your own tools, and upload them here.</p>\n\t\t<h3>Download</h3>\n\n\t\t<span>Format:</span>\n\t\t<select selected=\"json\" id=\"downloadLocFormat\" class=\"store_localization_download_format_select\">\n\t\t\t<option value=\"json\">JSON</option>\n\t\t\t<option value=\"csv\">CSV</option>\n\t\t</select>\n\t\t<br>\n\t\t<select id=\"downloadLocLanguage\">\n\t\t\t<option value=\"all\">All Languages</option>\n\t\t\t<option value=\"english\">English</option><option value=\"german\">Deutsch (German)</option><option value=\"french\">Français (French)</option><option value=\"italian\">Italiano (Italian)</option><option value=\"koreana\">한국어 (Korean)</option><option value=\"spanish\">Español - España (Spanish - Spain)</option><option value=\"schinese\">简体中文 (Simplified Chinese)</option><option value=\"tchinese\">繁體中文 (Traditional Chinese)</option><option value=\"russian\">Русский (Russian)</option><option value=\"thai\">ไทย (Thai)</option><option value=\"japanese\">日本語 (Japanese)</option><option value=\"portuguese\">Português (Portuguese - Portugal)</option><option value=\"polish\">Polski (Polish)</option><option value=\"danish\">Dansk (Danish)</option><option value=\"dutch\">Nederlands (Dutch)</option><option value=\"finnish\">Suomi (Finnish)</option><option value=\"norwegian\">Norsk (Norwegian)</option><option value=\"swedish\">Svenska (Swedish)</option><option value=\"hungarian\">Magyar (Hungarian)</option><option value=\"czech\">Čeština (Czech)</option><option value=\"romanian\">Română (Romanian)</option><option value=\"turkish\">Türkçe (Turkish)</option><option value=\"brazilian\">Português - Brasil (Portuguese - Brazil)</option><option value=\"bulgarian\">Български (Bulgarian)</option><option value=\"greek\">Ελληνικά (Greek)</option><option value=\"ukrainian\">Українська (Ukrainian)</option><option value=\"vietnamese\">Tiếng Việt (Vietnamese)</option><option value=\"latam\">Español - Latinoamérica (Spanish - Latin America)</option><option value=\"sc_schinese\">Steam China - 简体中文 (Simplified Chinese)</option><option value=\"indonesian\">Bahasa Indonesia (Indonesian)</option><option value=\"malay\">Bahasa Melayu (Malay)</option>\t\t</select>\n\t\t<button type=\"button\" id=\"downloadLocButton\" class=\"btn_darkblue_white_innerfade btn_small_thin\">\n\t\t\tDownload Localization\t\t</button>\n\t\t<br><br>\n\n\t\t<h3>Upload</h3>\n\n\t\t<input type=\"file\" name=\"localization_files[]\" multiple accept=\".json,.csv\">\n\t\t<button type=\"submit\" class=\"btn_darkblue_white_innerfade btn_small_thin\" onclick=\"SetFormAction('uploadloc');\">\n\t\t\tUpload Localization\t\t</button>\n\t</div>\n\n\t</div>\n\n\t<div class=\"tab_content \" id=\"tab_publish_content\">\n\t<div class=\"section\">\n\t\t<h2>Publish</h2>\n\t\t<div class=\"grayRule\"></div>\n\n\t\t\t\t\tThis application has not yet been published to all users. Once public, you will be able to release incremental updates without contacting Valve.\t\t\t</div>\n\t<div class=\"section\">\n\t\t\t\t\n\t\t\n\t\t\t</div>\n\t\t\t<script>\n\t\t\tfunction RequestAppRevision( revision, callback )\n\t\t\t{\n\t\t\t\t$J.ajax( 'https://partner.steamgames.com/admin/game/ajaxgetapprevision/2000000/?revision=' + revision\n\t\t\t\t).done( function( results ) {\n\t\t\t\t\tif ( results.success == 1 )\n\t\t\t\t\t{\n\t\t\t\t\t\tcallback( results.data );\n\t\t\t\t\t}\n\t\t\t\t\telse\n\t\t\t\t\t{\n\t\t\t\t\t\tShowAlertDialog( 'Error', 'There was a problem retrieving revision: ' + revision );\n\t\t\t\t\t}\n\t\t\t\t});\n\t\t\t}\n\n\t\t\tfunction ViewRevision( revision )\n\t\t\t{\n\t\t\t\tvar dialogWait = ShowBlockingWaitDialog( 'Please wait', 'Loading data...' );\n\t\t\t\tRequestAppRevision( revision, function( data ) {\n\t\t\t\t\tdialogWait.Dismiss();\n\t\t\t\t\tvar container = $J('<div/>', {'style': 'max-height: 900px; width: 100%; overflow: scroll;'} );\n\t\t\t\t\t// keyvalues text is not trusted - set it as text so it can't be parsed as markup\n\t\t\t\t\tcontainer.append( $J('<pre/>').text( data ) );\n\t\t\t\t\tShowAlertDialog( 'Revision ' + revision, container);\n\t\t\t\t} );\n\t\t\t}\n\n\t\t\tfunction DiffSelected()\n\t\t\t{\n\t\t\t\tvar selectedRevisions = $J( \"input[name='revisions']:checked\" );\n\n\t\t\t\tif ( selectedRevisions.length != 2 )\n\t\t\t\t{\n\t\t\t\t\tShowAlertDialog( 'Error', 'You must select exactly two revisions to view the differences between them.' );\n\t\t\t\t\treturn;\n\t\t\t\t}\n\n\t\t\t\tvar sectionA = $J( selectedRevisions[0] );\n\t\t\t\tvar sectionB = $J( selectedRevisions[1] );\n\n\t\t\t\tif ( sectionA.val() > sectionB.val() )\n\t\t\t\t{\n\t\t\t\t\tvar sectionTemp = sectionA;\n\t\t\t\t\tsectionA = sectionB;\n\t\t\t\t\tsectionB = sectionTemp;\n\t\t\t\t}\n\n\t\t\t\tvar revisionA = sectionA.val();\n\t\t\t\tvar revisionB = sectionB.val();\n\n\t\t\t\tvar resultsA = null;\n\t\t\t\tvar resultsB = null;\n\n\t\t\t\tvar dialogWait = ShowBlockingWaitDialog( 'Please wait', 'Loading data...' );\n\n\t\t\t\t// request both\n\t\t\t\tRequestAppRevision( revisionA,\n\t\t\t\t\tfunction( results )\t{\n\t\t\t\t\t\tresultsA = results;\n\t\t\t\t\t\tRequestAppRevision( revisionB,\n\t\t\t\t\t\t\tfunction( results ) {\n\t\t\t\t\t\t\t\tresultsB = results;\n\t\t\t\t\t\t\t\tdialogWait.Dismiss();\n\t\t\t\t\t\t\t\tdisplay_diffs( 'Revision ' + revisionA, 'Revision ' + revisionB, resultsA, resultsB );\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t);\n\t\t\t\t\t}\n\t\t\t\t);\n\t\t\t}\n\t\t</script>\n\t\t<div class=\"section\">\n\t\t\t<h2>Publishing history</h2>\n\t\t\t<div class=\"grayRule\"></div>\n\n\t\t\t\n\t\t\t<div class=\"landingTable\">\n\t\t\t\t<div class=\"tr\">\n\t\t\t\t\t<div class=\"th\">&nbsp;</div>\n\t\t\t\t\t<div class=\"th\">Revision</div>\n\t\t\t\t\t<div class=\"th\">Date</div>\n\t\t\t\t\t<div class=\"th\">Actor</div>\n\t\t\t\t\t<div class=\"th\">Notes</div>\n\t\t\t\t\t<div class=\"th\">&nbsp;</div>\n\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t</div>\n\t</div>\n\n\n</div>\n</form>\n\n\n<div id=\"secondary_tab_contents\">\n\t\t<div class=\"tab_content \" id=\"tab_movies_content\">\n\t\t<div class=\"section\" id=\"MovieNoFormData\">\n\tEditing trailer content requires Edge, Chrome or Firefox</div>\n<div class=\"section\" id=\"MovieFormData\" style=\"display: none\">\n\n\t<div class=\"instructions\">\n\t\t<div class=\"title2\">Trailer Guideline and Tips</div><div class=\"titleHelper\"><a href=\"https://partner.steamgames.com/doc/store/trailer\">View Trailer Documentation</a></div>\n\t\t<br clear=\"left\">\n\t\t<div class=\"grayRule\"> </div>\n\n\t\t<div class=\"instructions_table\">\n\t\t\t<div class=\"instructions_table_row\">\n\t\t\t\t<div class=\"instructions_table_cell left\">\n\t\t\t\t\t<strong>Uploading Trailers:</strong>\n\t\t\t\t</div>\n\t\t\t\t<div class=\"instructions_table_cell\">\n\t\t\t\t\t<p>The trailer should be the highest resolution that you have, up to 1920 x 1080 resolution, 30/29.97 or 60/59.94 fps, high bit rate (5,000+ Kbps) and in .mov, .wmv, or .mp4 container files. H.264 video and AAC audio is preferred, but we can transcode from many formats. 16:9 aspect ratio is preferred since the Steam client is optimized for widescreen, but 4:3 aspect ratio is accepted. Please note that audio will be filtered down to regular stereo when we transcode the videos.</p>\n\t\t\t\t</div>\n\t\t\t</div>\n\n\t\t\t<div class=\"instructions_table_row\">\n\t\t\t\t<div class=\"instructions_table_cell left\">\n\t\t\t\t\t<strong>Advanced Settings:</strong>\n\t\t\t\t</div>\n\t\t\t\t<div class=\"instructions_table_cell\">\n\t\t\t\t\t<p><b>Base Video &amp; Language</b> - The \"Base Video\" setting groups multiple trailer videos together, enabling the store to choose only one of the videos depending on the user's configured language. For example, if you have an English, Spanish &amp; German version of the same trailer, set the \"Base Video\" for the English trailer to nothing (empty) and the other two language's \"Base Video\" setting to the name of your English trailer.</p>\n\t\t\t\t\t<p><b>Countries</b> - only needs to be set if you desire to restrict visibility of your trailer to only some countries. This may be desirable if you have PEGI and ESRB rated videos that should each only appear in certain countries. Use <a href=\"http://en.wikipedia.org/wiki/ISO_3166-1_alpha-2\" target=\"_blank\">official ISO listings</a>. (Example: \"DE,FR,US,CA,MX\")</p>\n\t\t\t\t</div>\n\t\t\t</div>\n\n\t\t\t<div class=\"instructions_table_row\">\n\t\t\t\t<div class=\"instructions_table_cell left\">\n\t\t\t\t\t<strong>Tips:</strong>\n\t\t\t\t</div>\n\t\t\t\t<div class=\"instructions_table_cell\">\n\t\t\t\t\t<p>Your first video should get to gameplay or action as quickly as possible. Slow, dramatic introductions might be appropriate for a cinematic trailer on YouTube, but for someone that is in shopping mode, it's much more useful to quickly see what the game is like to play.</p>\n\t\t\t\t\t<p>The store will display trailers in the order below. You can drag & drop to reorder as desired.</p>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t</div>\n\n\t</div>\n\t<br>\n\n\t<div class=\"movie_list_wrapper\">\n\t\t<div id=\"movie_list_processing\">\n\t\t\t<div class=\"throbber\"></div>\n\t\t</div>\n\t\t<div class=\"movie_create_area\">\n\t\t\t<div class=\"movie_create_label\">\n\t\t\t\t<span>Create New Trailer</span>\n\t\t\t</div>\n\t\t\t<form id=\"CreateMovieForm\" method=\"POST\" action=\"https://partner.steamgames.com/admin/game/moviecreate/2000000\">\n\t\t\t\t<input type=\"hidden\" name=\"sessionid\" value=\"ffffffffffffffffffff0001\" />\t\t\t\t<span>Public facing display name:</span>\n\t\t\t\t<input class=\"movie_create_name\" type=\"text\" name=\"name\" value=\"\" placeholder=\"Enter name here...\" />\n\t\t\t\t<button class=\"btn_green_steamui btn_small_thin\" type=\"submit\" onclick=\"return CreateMovieForApp( '#CreateMovieForm' );\"><span>Create</span></button>\n\t\t\t</form>\n\t\t</div>\n\n\t\t<p>\n\n\t\t<div id=\"trailer_list\">\n\t\t\t\t</div>\n\t\t\t</div>\n\n\t</div>\n\n<script language=\"javascript\">\n\n\t\n\t\n\t// Handle MicroTrailer play-on-hover:\n\t$J(document).ready(function()\n\t{\n\n\t\t$J('.hover_microtrailer_video').hover(\n\t\t\tfunction ()\n\t\t\t{\n\t\t\t\t$J(this).addClass( 'with_microtrailer' );\n\t\t\t\tplayPromise = $J(this).get(0).play();\n\t\t\t\tif ( playPromise )\n\t\t\t\t{\n\t\t\t\t\tplayPromise.catch( function( e ) {\n\t\t\t\t\t\t$J(this).removeClass( 'with_microtrailer' );\n\t\t\t\t\t} );\n\t\t\t\t}\n\n\t\t\t\tif($J(this).css(\"opacity\") == 0)\n\t\t\t\t{\n\t\t\t\t\t$J(this).animate({opacity: 1.0}, 500);\n\t\t\t\t}\n\t\t\t},\n\n\t\t\tfunction ()\n\t\t\t{\n\t\t\t\t$J(this).get(0).pause();\n\t\t\t}\n\t\t);\n\t});\n\n\n\n\n\tif ( BBrowserSupportsFormData() )\n\t{\n\t\t$J( \"#MovieNoFormData\" ).hide();\n\t\t$J( \"#MovieFormData\" ).show();\n\n\t\tRegisterMovieDragDrop();\n\t\t\t\tUpdateRelatedMovieSelects();\n\t}\n\n</script>\n\t</div>\n\t\n</div>\n</div>\n\n\n<form id=\"quick_message_update\" method=\"post\" action=\"https://partner.steamgames.com/admin/game/save/2000000\">\n\t<input type=\"hidden\" name=\"sessionid\" value=\"ffffffffffffffffffff0001\" />\t<input type=\"hidden\" id=\"save_redirect\" name=\"save_redirect\" value=\"edit\">\n\t\t</form>\n\n<!-- load dynamic javascript in the footer, these files are slower to load -->\n<script type=\"text/javascript\" src=\"https://partner.steamgames.com/public/javascript/dynamic/storedata.js\"></script>\n<script type=\"text/javascript\" src=\"https://partner.steamgames.com/admin/store/metacritic.js\"></script>\n<script type=\"text/javascript\">\n\tfunction SetFormAction( action )\n\t{\n\t\t$( 'gameform' ).action = 'https://partner.steamgames.com/admin/game/' + action + '/2000000';\n\t}\n\tfunction SaveAndGoto( action )\n\t{\n\t\t$( 'save_redirect' ).value = action;\n\t}\n\tfunction OnPreOrderLabelChange( index )\n\t{\n\t\tvar text = $( 'app_content_sections_'+index+'_label__textarea').value;\n\t\tvar bVisible = ( text == '#label_pre_order_rewards' );\n\t\t$( 'pre_order_rewards_' + index).style.display = bVisible ? 'inherit' : 'none';\n\t}\n\n\tvar g_szBaseUrl = 'https://partner.steamgames.com';\n\n\t// As package and game share the same pages, let's make sure no Save button is disabled.\n\t// Game does not need async enable yet.\n\tReenableSubmitInput( 'Save (disabled)', 'Save' );\n</script>\n<!-- Footer -->\n<div class=\"responsive_footer_ctn\">\n\t\t\t<div class=\"footer_confidentiality_ctn\">\n\t\t\t<h2>Valve Confidential</h2>\n\t\t\t<p>This restricted access page contains Valve confidential information. You must have a non-disclosure and/or license agreement covering confidential information with Valve to use or access this page.</p>\n\t\t</div>\n\t\t<div class=\"responsive_footer_content\" >\n\t\t<div class=\"footer_content_left\">\n\t\t\t<img src=\"https://partner.steamgames.com/public/images/steamworks_logo_white.png\" class=\"logo\" />\n\t\t\t<div class=\"steamworks_desc\" >Steamworks is the set of tools and services built by <a href=\"https://www.valvesoftware.com\">Valve</a> that help you configure, manage, and operate your game on <a href=\"https://store.steampowered.com/\">Steam</a>.</div>\n\t\t\t<div class=\"corporate\">\n\t\t\t\t<a href=\"http://www.valvesoftware.com\"><img src=\"https://partner.steamgames.com/public/images/valve_logo_white_small.png\" /></a><span class=\"vr\"></span><a href=\"https://store.steampowered.com/\"><img src=\"https://partner.steamgames.com/public/images/steam_logo_white_small.png\" /></a>\n\t\t\t</div>\n\t\t</div>\n\n\t\t<div class=\"footer_content_right\">\n\t\t\t<ul>\n\t\t\t\t<li><em>Documentation</em></li>\n\t\t\t\t<li><a href=\"https://partner.steamgames.com/doc/\">Home</a></li>\n\t\t\t\t<li><a href=\"https://partner.steamgames.com/doc/gettingstarted\">Getting Started</a></li>\n\t\t\t\t<li><a href=\"https://partner.steamgames.com/doc/store\">Store Presence</a></li>\n\t\t\t\t<li><a href=\"https://partner.steamgames.com/doc/features\">Features</a></li>\n\t\t\t\t<li><a href=\"https://partner.steamgames.com/doc/finance\">Finance</a></li>\n\t\t\t\t<li><a href=\"https://partner.steamgames.com/doc/marketing\">Sales & Marketing</a></li>\n\t\t\t\t<li><a href=\"https://partner.steamgames.com/doc/sdk\">Steamworks SDK</a></li>\n\t\t\t\t<li><a href=\"https://partner.steamgames.com/pccafe\">Café Licensing</a></li>\n\t\t\t\t<li><a href=\"https://partner.steamgames.com/doc/features/steamvr/info\">Steam VR</a></li>\n\t\t\t</ul>\n\t\t\t<ul>\n\t\t\t\t<li><em>Resources</em></li>\n\t\t\t\t<li><a href=\"https://partner.steamgames.com/vrlicensing\">Steam VR</a></li>\n\t\t\t\t<li><a href=\"https://partner.steamgames.com/pccafe\">S