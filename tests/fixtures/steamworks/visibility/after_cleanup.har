pt type=\"text/javascript\">Object.seal && [ Object, Array, String, Number ].map( function( builtin ) { Object.seal( builtin.prototype ); } );</script><script type=\"text/javascript\" src=\"https://partner.steamgames.com/public/javascript/marketing.js?v=gL5NY0WC6OYI&amp;l=english&amp;_cdn=akamai\"></script>\n\n<script type=\"text/javascript\" src=\"https://partner.steamgames.com/public/javascript/storeadmin.js?v=Se20y3-xsTJy&amp;l=english&amp;_cdn=akamai\"></script>\n\n<script type=\"text/javascript\" src=\"https://partner.steamgames.com/public/javascript/admin.js?v=lMxQ0nFXvFTx&amp;l=english&amp;_cdn=akamai\"></script>\n\n<script type=\"text/javascript\" src=\"https://partner.steamgames.com/public/javascript/webtoolkit.aim.js?v=ZQ03s8ex0ABq&amp;l=english&amp;_cdn=akamai\"></script>\n\n<script type=\"text/javascript\" src=\"https://partner.steamgames.com/public/javascript/newsadmin.js?v=ib6aUpGud549&amp;l=english&amp;_cdn=akamai\"></script>\n\n<script type=\"text/javascript\" src=\"https://partner.steamgames.com/public/javascript/jquery-1.8.3.js?v=hslOGuAZoPRK&amp;l=english&amp;_cdn=akamai\"></script>\n\n<script type=\"text/javascript\" src=\"https://partner.steamgames.com/public/shared/javascript/tooltip.js?v=a9q1REOJMDBo&amp;l=english&amp;_cdn=akamai\"></script>\n\n<script type=\"text/javascript\" src=\"https://partner.steamgames.com/public/shared/javascript/shared_global.js?v=ABylLOrGN4B_&amp;l=english&amp;_cdn=akamai\"></script>\n\n<script type=\"text/javascript\" src=\"https://partner.steamgames.com/public/shared/javascript/shared_responsive_adapter.js?v=asNZNxt9kVQn&amp;l=english&amp;_cdn=akamai\"></script>\n\n<script type=\"text/javascript\">$J = jQuery.noConflict();\n\t\t\tdocument.addEventListener('DOMContentLoaded', function(event) {\n\t\t\t\tSetupTooltips( { tooltipCSSClass: 'jsTooltip'} );\n\t\t\t});</script><script type=\"text/javascript\" src=\"https://partner.steamgames.com/public/javascript/apps.js?v=JTMAvDwMk1h9&amp;l=english&amp;_cdn=akamai\"></script>\n\n\n<script type=\"text/javascript\">\n\ng_szBaseURL = \"https://partner.steamgames.com\";\ng_AppId = 1000000;\n\nvar g_rgLanguages = {\"english\":\"English\",\"german\":\"German\",\"french\":\"French\",\"italian\":\"Italian\",\"koreana\":\"Korean\",\"spanish\":\"Spanish - Spain\",\"schinese\":\"Simplified Chinese\",\"tchinese\":\"Traditional Chinese\",\"russian\":\"Russian\",\"thai\":\"Thai\",\"japanese\":\"Japanese\",\"portuguese\":\"Portuguese - Portugal\",\"polish\":\"Polish\",\"danish\":\"Danish\",\"dutch\":\"Dutch\",\"finnish\":\"Finnish\",\"norwegian\":\"Norwegian\",\"swedish\":\"Swedish\",\"hungarian\":\"Hungarian\",\"czech\":\"Czech\",\"romanian\":\"Romanian\",\"turkish\":\"[turkish text removed]\",\"arabic\":\"Arabic\",\"brazilian\":\"Portuguese-Brazil\",\"bulgarian\":\"Bulgarian\",\"greek\":\"Greek\",\"ukrainian\":\"Ukrainian\",\"vietnamese\":\"Vietnamese\",\"latam\":\"Spanish - Latin America\",\"sc_schinese\":\"SteamChina - Simplified Chinese\",\"indonesian\":\"Indonesian\",\"malay\":\"Malay\"};\n\n</script>\n\n<script type=\"text/javascript\">\n\n\nvar g_szUniverse = 'public';\n\n\nfunction MaybePublishAppChanges( appID )\n{\n\t$('really_publish').style.display = 'block';\n}\n\nfunction ReallyPublishAppChanges( appid, bPublishImages )\n{\n\t// check confirmation code\n\tvar confirmation = GetElementValue( 'confirmation' );\n\tif ( confirmation != 'STEAMWORKS' )\n\t{\n\t\tShowAlertDialog( 'Publish Changes', \"Please enter confirmation code ('%1$s' sans quotes) to publish to %2$s Steam.\".replace('%1$s', \"STEAMWORKS\").replace('%2$s', \"public\")  );\n\t\treturn false;\n\t}\n\n\tvar waitDialog = ShowBlockingWaitDialog( 'Publishing...', 'Publishing changes to Steam...' );\n\n\tvar elt = $( 'confirmbtn' );\n\telt.disabled = true;\n\telt.value = \"Publishing...\";\n\t$('appOutput').innerHTML = \"\";\n\tAppsAjaxRequest( g_szBaseURL + \"/apps/publish/\" + appid,\n\t\t\t\t\t{\n                        'sessionid': g_sessionID,\n\t\t\t\t\t\t'bPublishImages' : ( bPublishImages ? 1 : 0 ),\n\t\t\t\t\t\t'section': 'technical',\n\t\t\t\t\t\t'change_notes': $J( \"#change_notes\" ).val()\n\n\t\t\t\t\t},\n\t\t\t\t\tfunction( results )\n\t\t\t\t\t{\n\t\t\t\t\t\twaitDialog.Dismiss();\n\t\t\t\t\t\tStandardCallback( results, 'appOutput' );\n\t\t\t\t\t\telt.disabled = false;\n\t\t\t\t\t\telt.value = \"Really Publish\";\n\n\t\t\t\t\t\t$J( \"#pre_publish_actions\" ).hide();\n\t\t\t\t\t\t$J( \"#publish_success\" ).fadeIn();\n\t\t\t\t\t}\n\t\t\t\t);\n}\n\n</script>\n\n</head>\n\n<body>\n<div id=\"pageContainer\">\n<script type=\"text/javascript\">\n\t$J( InitMiniprofileHovers( 'https%3A%2F%2Fpartner.steamgames.com' ) );\n    \tg_sessionID = \"ffffffffffffffffffff0001\";\n</script>\n<!-- anyone using landing_header needs to ensure jquery is loaded prior -->\n<script type=\"text/javascript\" src=\"https://partner.steamgames.com/public/javascript/jquery.cookie.js?v=ND_3CW4DxZHp&amp;l=english&amp;_cdn=akamai\"></script>\n<script type=\"text/javascript\">\n\tg_sessionID = \"ffffffffffffffffffff0001\";\n\tg_rgAllAffiliatedPublishers = {\"900000\":\"Redacted\"};\n\tg_nPrimaryPublisher = 900000;\n\n\tfunction GoToEditPage( page, id )\n\t{\n\t\tif ( checkNumeric( id ) )\n\t\t{\n\t\t\twindow.location.href = \"https://partner.steamgames.com/apps/\" + page + \"/\" + id;\n\t\t}\n\t}\n\n\tfunction checkNumeric( value )\n\t{\n\t\tvar anum=/(^\\d+$)|(^\\d+\\.\\d+$)/\n\t\tif (anum.test(value))\n\t\t\treturn true;\n\t\treturn false;\n\t}\n</script>\n\t<div id=\"headerContainer\" data-config=\"{&quot;EUNIVERSE&quot;:1,&quot;WEB_UNIVERSE&quot;:&quot;public&quot;,&quot;LANGUAGE&quot;:&quot;english&quot;,&quot;COUNTRY&quot;:&quot;TR&quot;,&quot;MEDIA_CDN_COMMUNITY_URL&quot;:&quot;https:\\/\\/shared.akamai.steamstatic.com\\/community_assets\\/&quot;,&quot;MEDIA_CDN_URL&quot;:&quot;https:\\/\\/cdn.akamai.steamstatic.com\\/&quot;,&quot;VIDEO_CDN_URL&quot;:&quot;https:\\/\\/video.akamai.steamstatic.com\\/&quot;,&quot;COMMUNITY_CDN_URL&quot;:&quot;https:\\/\\/