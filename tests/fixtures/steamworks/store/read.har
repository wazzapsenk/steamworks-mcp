ue=\"\"><input type=\"hidden\" id=\"app_content_short_description_schinese__hidden\" lang=\"zh-cn\" name=\"app[content][short_description][schinese]\" value=\"\"><input type=\"hidden\" id=\"app_content_short_description_latam__hidden\" lang=\"es-419\" name=\"app[content][short_description][latam]\" value=\"\"><input type=\"hidden\" id=\"app_content_short_description_swedish__hidden\" lang=\"sv\" name=\"app[content][short_description][swedish]\" value=\"\"><input type=\"hidden\" id=\"app_content_short_description_thai__hidden\" lang=\"th\" name=\"app[content][short_description][thai]\" value=\"\"><input type=\"hidden\" id=\"app_content_short_description_tchinese__hidden\" lang=\"zh-tw\" name=\"app[content][short_description][tchinese]\" value=\"\"><input type=\"hidden\" id=\"app_content_short_description_turkish__hidden\" lang=\"tr\" name=\"app[content][short_description][turkish]\" value=\"[turkish text removed]\"><input type=\"hidden\" id=\"app_content_short_description_ukrainian__hidden\" lang=\"uk\" name=\"app[content][short_description][ukrainian]\" value=\"\"><input type=\"hidden\" id=\"app_content_short_description_vietnamese__hidden\" lang=\"vi\" name=\"app[content][short_description][vietnamese]\" value=\"\"></div>\t\t\t<div id=\"app_content_short_description_length_status\"><span id=\"app_content_short_description_current_length\"></span>/<span id=\"app_content_short_description_max_length\"></span></div>\n\t\t</div>\n\t</div>\n</div>\n\n<script type=\"text/javascript\">\n\t// Warn the user if the short description goes over the recommended length.\n\t$J( function() {\n\t\t$J( \"#app_content_short_description__textarea\" ).on( \"keyup input paste\", function()\n\t\t{\n\t\t\tconst elShortDescriptionText = $J( \"#app_content_short_description__textarea\" );\n\t\t\tconst elCurrentLengthText = $J( \"#app_content_short_description_current_length\" );\n\t\t\tconst elMaxLengthText = $J( \"#app_content_short_description_max_length\" );\n\t\t\tconst elWarningText = $J( \"#app_content_short_description_length_warning\" );\n\n\t\t\tconst nMaxLength = 300;\n\t\t\tconst nCurrentLength = elShortDescriptionText.val().length;\n\n\t\t\tconst strTextAreaErrorClassname = \"textarea_over_limit\";\n\t\t\tconst strWarningTextErrorClassname = \"length_error_msg\";\n\n\t\t\telCurrentLengthText.html(nCurrentLength);\n\t\t\telMaxLengthText.html(nMaxLength);\n\n\t\t\tif ( nCurrentLength > nMaxLength )\n\t\t\t{\n\t\t\t\telShortDescriptionText.addClass( strTextAreaErrorClassname );\n\t\t\t\telWarningText.addClass( strWarningTextErrorClassname );\n\t\t\t\telCurrentLengthText.addClass( strWarningTextErrorClassname );\n\t\t\t}\n\t\t\telse\n\t\t\t{\n\t\t\t\telShortDescriptionText.removeClass( strTextAreaErrorClassname );\n\t\t\t\telWarningText.removeClass( strWarningTextErrorClassname );\n\t\t\t\telCurrentLengthText.removeClass( strWarningTextErrorClassname );\n\t\t\t}\n\t\t});\n\t});\n</script>\n\n\n\n\t<div class=\"subsection\">\n\t\t<h2>Reviews</h2>\n\t\t<div class=\"grayRule\"></div>\n\t\t<div class=\"sectionDescription\">Include the text and links for reviews of the Game that you think would help sell the product. These reviews appear worldwide.</div>\n\t\t\t\t<button type=\"button\" onclick=\"Effect.BlindDown( 'game_description_reviews', {duration: 0.2} ); $(this).hide(); return false;\" style=\"\">Add Reviews</button>\n\t\t\t\t\t<div id=\"game_description_reviews\" style=\"display: none;\">\n\t\t\t\t\t\t\t\t<div class=\"AppReviewRow\">\n\t\t\t\t\t<span class=\"AppReviewOrganization\">Organization</span>\n\t\t\t\t\t<span class=\"AppReviewURL\">URL</span>\n\t\t\t\t\t<span class=\"AppReviewScore\">Score</span>\n\t\t\t\t\t<span class=\"AppReviewQuote\">Quote (no need to include quote marks here)</span>\n\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t<div class=\"AppReviewRow\" id=\"AppReviewRow0\" style=\"\">\n\t\t\t\t\t\t<div class=\"AppReviewOrganization\">\n\t\t\t\t\t\t\t<input type=\"text\" name=\"app[content][reviews][0][site]\" value=\"\" size=\"50\">\n\