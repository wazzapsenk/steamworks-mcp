{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "State",
  "$defs": {
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "file": {
          "title": "File",
          "type": "string"
        },
        "line": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line"
        },
        "note": {
          "default": "",
          "title": "Note",
          "type": "string"
        }
      },
      "required": [
        "file"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "FieldState": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "default": "missing",
          "enum": [
            "missing",
            "draft",
            "needs_review",
            "approved",
            "applied"
          ],
          "title": "Status",
          "type": "string"
        },
        "source": {
          "anyOf": [
            {
              "enum": [
                "scan",
                "user",
                "generated",
                "reference_default",
                "steamworks"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source"
        },
        "confidence": {
          "default": 0.0,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "gate": {
          "anyOf": [
            {
              "maximum": 3,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Gate"
        },
        "execution_mode": {
          "anyOf": [
            {
              "enum": [
                "API",
                "BROWSER",
                "ARTIFACT",
                "MANUAL"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Execution Mode"
        },
        "value_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value Hash"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "title": "Evidence",
          "type": "array"
        },
        "updated_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Updated At"
        },
        "applied_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Applied At"
        },
        "notes": {
          "default": "",
          "title": "Notes",
          "type": "string"
        }
      },
      "title": "FieldState",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "state_version": {
      "const": 1,
      "default": 1,
      "title": "State Version",
      "type": "integer"
    },
    "fields": {
      "additionalProperties": {
        "$ref": "#/$defs/FieldState"
      },
      "title": "Fields",
      "type": "object"
    }
  },
  "type": "object"
}
