tags\"></a>\n\t\t<div class=\"section\" id=\"tags_form\">\n\t\t\t<h2>Tags<span class=\"required\">*</span></h2>\n\t\t\t<div class=\"grayRule\"></div>\n\n                            <div class=\"storeAdminSection\">\n\t\t\t\t<p class=\"add_tags_note DialogBodyText\">\n                    You must add at least <strong>5 tags</strong> to your game.                    <span id=\"tag_status_line\">(You have applied <strong>0 tags</strong>)</span>\n\n                    <!--Tag Wizard-->\n                                            <div id=\"taxonomy_survey\">\n                            <div class=\"DialogBodyText\">Use the Tag Wizard to tag your application. This provides Steam with important information that helps determine where your title is displayed throughout the platform.</div>\n                            <a id=\"TagWizardButton\" onclick=\"OnClickTagWizard(1000000);\" class=\"btn_blue_steamui btn_medium\">\n                                &nbsp;\n                               <span> Tag my Title                                <i class=\"icoExternalBlue\"></i>\n\t\t\t\t\t\t\t\t   </span>\n                                &nbsp;\n                            </a>\n                        </div>\n                                    </p>\n\t\t\t\t</div>\n            \t\t</div>\n\n\t\t\t\t\t<div class=\"section\">\n\t\t\t\t\t\t<input class=\"gamepadsupport_input\" hidden=\"hidden\" id=\"gamepadsupport_input_1\" name=\"app[classification][category][category_18]\" value=\"\">\n\t\t\t<input class=\"gamepadsupport_input\" hidden=\"hidden\" id=\"gamepadsupport_input_2\" name=\"app[classification][category][category_28]\" value=\"\">\n\t\t\t<input class=\"controllersupport_input\" hidden=\"hidden\" id=\"controllersupport_input_3\" name=\"app[classification][category][category_55]\" value=\"\">\n\t\t\t<input class=\"controllersupport_input\" hidden=\"hidden\" id=\"controllersupport_input_4\" name=\"app[classification][category][category_56]\" value=\"\">\n\t\t\t<input class=\"controllersupport_input\" hidden=\"hidden\" id=\"controllersupport_input_5\" name=\"app[classification][category][category_57]\" value=\"\">\n\t\t\t<input class=\"controllersupport_input\" hidden=\"hidden\" id=\"controllersupport_input_6\" name=\"app[classification][category][category_58]\" value=\"\">\n\t\t\t<input class=\"controllersupport_input\" hidden=\"hidden\" id=\"controllersupport_input_7\" name=\"app[classification][category][category_59]\" value=\"\">\n            <input class=\"controllersupport_input\" hidden=\"hidden\" id=\"controllersupport_input_8\" name=\"app[content][keyboardmouse][notice]\" value=\"\">\n\t\t\t<input class=\"controllersupport_input\" hidden=\"hidden\" id=\"controllersupport_input_9\" name=\"app[classification][category][category_60]\" value=\"\">\n\t\t\t<input class=\"controllersupport_input\" hidden=\"hidden\" id=\"controllersupport_input_10\" name=\"app[content][controllertagwizard][v1]\" value=\"\">\n\t\t\t<br><br>\n            <a name=\"controller\"></a>\n\t\t\t<h2 id=\"controller_wizard\">Controller Support</h2>\n\t\t\t<div class=\"grayRule\"> </div>\n\t\t\t<div class=\"controllerOptions storeAdminSection\">\n\t\t\t\t<div  data-featuretarget=\"storeadmin-controllersupportinfo\" data-props=\"{&quot;unAppID&quot;:1000000,&quot;bFullXboxControllerSupport&quot;:false,&quot;bPartialXboxControllerSupport&quot;:false,&quot;bPS4ControllerSupport&quot;:false,&quot;bPS4ControllerBTSupport&quot;:false,&quot;bPS5ControllerSupport&quot;:false,&quot;bPS5ControllerBTSupport&quot;:false,&quot;bSteamInputAPISupport&quot;:false,&quot;bNoKeyboardSupport&quot;:false,&quot;bGamepadPreferred&quot;:false,&quot;bControllerSupportWizardComplete&quot;:false}\"></div>\t\t\t</div>\n\t\t\t<div class=\"statLinkCallOut\">\n\t\t\t\t<div class=\"statIconCtn\">\n\t\t\t\t\t<img src=\"https://partner.steamgames.com/public/images/landing/icon_finances.png\">\n\t\t\t\t</div>\n\t\t\t\t<div class=\"statInstructionsCtn\">\n\t\t\t\t\tController Playtime Stats: For released games, you can find controller playtime stats in the Sales & Activations Reports.<br>\n\t\t\t\t\t<a href=\"https://partner.steampowered.com/app/controllerstats/1000000/\">See Controller Playtime Stats</a>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t</div>\n\t\t\t\t\t\t<div class=\"section\">\n\t\t\t<input hidden=\"hidden\" name=\"app[content][accessibilitywizard][v1]\" value=\"\">\n\t\t\t<input hidden=\"hidden\" name=\"app[content][accessibilitywizard][v2]\" value=\"\">\n\t\t\t<input hidden=\"hidden\" name=\"app[classification][category][category_64]\" value=\"\">\n\t\t\t<input hidden=\"hidden\" name=\"app[classification][category][category_65]\" value=\"\">\n\t\t\t<input hidden=\"hidden\" name=\"app[classification][category][category_66]\" value=\"\">\n\t\t\t<input hidden=\"hidden\" name=\"app[classification][category][category_67]\" value=\"\">\n\t\t\t<input hidden=\"hidden\" name=\"app[classification][category][category_68]\" value=\"\">\n\t\t\t<input hidden=\"hidden\" name=\"app[classification][category][category_69]\" value=\"\">\n\t\t\t<input hidden=\"hidden\" name=\"app[classification][category][category_70]\" value=\"\">\n\t\t\t<input hidden=\"hidden\" name=\"app[classification][category][category_71]\" value=\"\">\n\t\t\t<input hidden=\"hidden\" name=\"app[classification][category][category_72]\" value=\"\">\n\t\t\t<input hidden=\"hidden\" name=\"app[classification][category][category_73]\" value=\"\">\n\t\t\t<input hidden=\"hidden\" name=\"app[classification][category][category_74]\" value=\"\">\n\t\t\t<input hidden=\"hidden\" name=\"app[classification][category][category_75]\" value=\"\">\n\t\t\t<input hidden=\"hidden\" name=\"app[classification][category][category_76]\" value=\"\">\n\t\t\t<input hidden=\"hidden\" name=\"app[classification][category][category_77]\" value=\"\">\n\t\t\t<input hidden=\"hidden\" name=\"app[classification][category][category_78]\" value=\"\">\n\t\t\t<input hidden=\"hidden\" name=\"app[classification][category][category_79]\" value=\"\">\n\t\t\t<input hidden=\"hidden\" name=\"app[classification][category][category_80]\" value=\"\">\n\t\t\t<input hidden=\"hidden\" name=\"app[classification][category][category_81]\" value=\"\">\n\t\t\t<input hidden=\"hidden\" name=\"app[classification][category][category_82]\" value=\"\">\n\t\t\t<h2 id=\"accessibility\">Accessibility</h2>\n\t\t\t<div class=\"grayRule\"> </div>\n\t\t\t<div class=\"storeAdminSection\">\n\t\t\t\t<div  data-featuretarget=\"storeadmin-accessibilityfeatures\" data-props=\"{&quot;bAccessibilityResizableUI&quot;:false,&quot;bAccessibilitySubtitles&quot;:false,&quot;bAccessibilityColorAlternatives&quot;:false,&quot;bAccessibilityCameraComfort&quot;:false,&quot;bAccessibilityBackgroundVolumeControls&quot;:false,&quot;bAccessibilityStereoSound&quot;:false,&quot;bAccessibilitySurroundSound&quot;:false,&quot;bAccessibilityNarratedMenus&quot;:false,&quot;bAccessibilityChatSpeechtoText&quot;:false,&quot;bAccessibilityChatTexttoSpeech&quot;:false,&quot;bAccessibilityPlayableWithoutQuicktimeEvents&quot;:false,&quot;bAccessibilityKeyboardOnlyOption&quot;:false,&quot;bAccessibilityMouseOnlyOption&quot;:false,&quot;bAccessibilityTouchOnlyOption&quot;:false,&quot;bAccessibilityDifficultyLevels&quot;:false,&quot;bAccessibilitySaveAnytime&quot;:false,&quot;bAccessibilityPlayableAtYourOwnPace&quot;:false,&quot;bAccessibilityPlayableWithoutVision&quot;:false,&quot;bAccessibilityContrastControls&quot;:false,&quot;bIsMultiplayer&quot;:false,&quot;bWizardCompleted&quot;:&quot;&quot;,&quot;nLastVersionCompleted&quot;:0}\"></div>\t\t\t</div>\n\t\t</div>\n\t\n\t\t<div class=\"section\" id=\"3p_drm\">\n\t\t<h2>3rd Party DRM\t\t\t\t\t</h2>\n\t\t<div class=\"grayRule\"></div>\n\t\t<p>If your App uses a non-Steam DRM, please enter the details below.</p>\n\t\t<div class=\"formrow\">\n\t\t\t<div class=\"formlabelwide\">DRM Provider:</div>\n\t\t\t<div class=\"formdata\">\n\t\t\t\t\t\t<input type=\"text\" id=\"app_game_3pdrm_provider_\" name=\"app[game][3pdrm][provider]\" value=\"\" size=\"45\"  >\n\t\t<div class=\"autocomplete\" id=\"app_game_3pdrm_provider__list\"></div>\n\n\t\t\t\t\t</div>\n\t\t</div>\n\t\t<div class=\"formrow\">\n\t\t\t<div class=\"formlabelwide\">Machine Activation Limit:</div>\n\t\t\t<div class=\"formdata\">\n\t\t\t\t\t\t<input type=\"text\" id=\"app_game_3pdrm_activation_limit_\" name=\"app[game][3pdrm][activation_limit]\" value=\"\" size=\"45\"  >\n\t\t<div class=\"autocomplete\" id=\"app_game_3pdrm_activation_limit__list\"></div>\n\n\t\t\t\t\t</div>\n\t\t</div>\n\t</div>\n\t\t\t\t<div class=\"section\" id=\"3p_accounts\">\n\t\t\t<h2>3rd Party Accounts</h2>\n\t\t\t<div class=\"grayRule\"></div>\n\t\t\t<p>If your App requires the use of a non-Steam user account to play, please enter the details below.</p>\n\t\t\t<div class=\"formrow\">\n\t\t\t\t<div class=\"formlabelwide\">Service Name:</div>\n\t\t\t\t<div class=\"formdata\">\n\t\t\t\t\t\t\t<input type=\"text\" id=\"app_game_3pacc_provider_\" name=\"app[game][3pacc][provider]\" value=\"\" size=\"45\"  >\n\t\t<div class=\"autocomplete\" id=\"app_game_3pacc_provider__list\"></div>\n\n\t\t\t\t\t\t</div>\n\t\t\t</div>\n\t\t\t<div class=\"formrow\">\n\t\t\t\t<div class=\"formlabelwide\">&nbsp;</div>\n\t\t\t\t<div class=\"formdata\">\n\t\t\t\t\t\t\t<a id=\"checkbox_app_game_3pacc_canlinktosteam_\" href=\"javascript:ToggleCheckbox('checkbox_app_game_3pacc_canlinktosteam_');\" class=\"fancyCheckbox noformatting\" style=\"\">\n\t\t<input type=\"hidden\" name=\"app[game][3pacc][canlinktosteam]\" value=\"\" onchange=\"\" id=\"checkbox_app_game_3pacc_canlinktosteam__input\" >\n\t\t<img id=\"checkbox_app_game_3pacc_canlinktosteam__unchecked\" src=\"https://partner.steamgames.com/public/images/admin_cb_default.gif\" style=\"\" alt=\"\">\n\t\t<img id=\"checkbox_app_game_3pacc_canlinktosteam__checked\" src=\"https://partner.steamgames.com/public/images/admin_cb_default_checked.gif\" style=\"display: none;\" alt=\"x\">\n\t\t\t\t\t<span class=\"fancyCheckboxLabel\">Supports Linking to Steam Account\t\t\t\n\t\t\t\t\t\t</span>\n\t\t\t\t</a>\n\t\t\t\t\t\t\t<br><a class=\"radioBtnDescText\" style=\"color: #b6c5ca\" target=\"_blank\" href=\"https://partner.steamgames.com/doc/features/auth#account_linking\">Documentation on Account Linking</a>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t</div>\n\t\t<div  data-featuretarget=\"storeadmin-anticheat-edit\" data-props=\"{&quot;rgAntiCheatData&quot;:{&quot;type&quot;:&quot;unspecified&quot;,&quot;otherNameLoc&quot;:[],&quot;kernel&quot;:false,&quot;uninstall&quot;:false,&quot;bootprotect&quot;:&quot;none&quot;},&quot;rgSupportedAntiCheatOptions&quot;:{&quot;unspecified&quot;:{&quot;kernel&quot;:false},&quot;none&quot;:{&quot;kernel&quot;:false},&quot;easyac&quot;:{&quot;kernel&quot;:true},&quot;denuvo&quot;:{&quot;kernel&quot;:true},&quot;battleye&quot;:{&quot;kernel&quot;:true},&quot;xigncode&quot;:{&quot;kernel&quot;:true},&quot;punkbuster&quot;:{&quot;kernel&quot;:false},&quot;vac&quot;:{&quot;kernel&quot;:false},&quot;gameguard&quot;:{&quot;kernel&quot;:true},&quot;hackshield&quot;:{&quot;kernel&quot;:true},&quot;ace&quot;:{&quot;kernel&quot;:true},&quot;sard&quot;:{&quot;kernel&quot;:true},&quot;hprotect&quot;:{&quot;kernel&quot;:true},&quot;other&quot;:{&quot;kernel&quot;:false}},&quot;rgLanguages&quot;:[[&quot;english&quot;,&quot;English&quot;],[&quot;french&quot;,&quot;French&quot;],[&quot;italian&quot;,&quot;Italian&quot;],[&quot;german&quot;,&quot;German&quot;],[&quot;spanish&quot;,&quot;Spanish - Spain&quot;],[&quot;bulgarian&quot;,&quot;Bulgarian&quot;],[&quot;czech&quot;,&quot;Czech&quot;],[&quot;danish&quot;,&quot;Danish&quot;],[&quot;dutch&quot;,&quot;Dutch&quot;],[&quot;finnish&quot;,&quot;Finnish&quot;],[&quot;greek&quot;,&quot;Greek&quot;],[&quot;hungarian&quot;,&quot;Hungarian&quot;],[&quot;indonesian&quot;,&quot;Indonesian&quot;],[&quot;japanese&quot;,&quot;Japanese&quot;],[&quot;koreana&quot;,&quot;Korean&quot;],[&quot;malay&quot;,&quot;Malay&quot;],[&quot;norwegian&quot;,&quot;Norwegian&quot;],[&quot;polish&quot;,&quot;Polish&quot;],[&quot;brazilian&quot;,&quot;Portuguese - Brazil&quot;],[&quot;portuguese&quot;,&quot;Portuguese - Portugal&quot;],[&quot;romanian&quot;,&quot;Romanian&quot;],[&quot;russian&quot;,&quot;Russian&quot;],[&quot;schinese&quot;,&quot;Simplified Chinese&quot;],[&quot;latam&quot;,&quot;Spanish - Latin America&quot;],[&quot;swedish&quot;,&quot;Swedish&quot;],[&quot;thai&quot;,&quot;Thai&quot;],[&quot;tchinese&quot;,&quot;Traditional Chinese&quot;],[&quot;turkish&quot;,&quot;Turkish&quot;],[&quot;ukrainian&quot;,&quot;Ukrainian&quot;],[&quot;vietnamese&quot;,&quot;Vietnamese&quot;]],&quot;rgSupportedAntiCheatBootProtections&quot;:[&quot;none&quot;,&quot;secureboot_tpm2&quot;]}\"></div>\t\t\n\t\n\t\t\t<div class=\"section\">\n\t\t\t<h2 class=\"inline\">Legal Lines</h2>\n\t\t\t<div class=\"grayRule\"> </div>\n\t\t\t<div class=\"sectionDescription\">This field may be used to articulate necessary copyright and/or trademark information only.<br>If you need to present the customer with an End User License Agreement (EULA), that should be entered into Steam <a https://partner.steamgames.comtarget=\"_blank\" href=\"https://partner.steamgames.com/apps/eula/1000000\">here</a>.</div>\n\n\t\t\t<div id=\"app_content_legal__area\" class=\"LocTextArea\"><div class=\"LocTextAreaBar\"><select id=\"app_content_legal__select\" class=\"LocTextAreaLangSelect\" onfocus=\"LocUpdateLangThatHaveText( 'app_content_legal_' )\" onchange=\"OnLocLanguageSelect( 'app_content_legal_' )\"><option id=\"app_content_legal_english__option\" value=\"english\">English</option><option id=\"app_content_legal_french__option\" value=\"french\">French</option><option id=\"app_content_legal_italian__option\" value=\"italian\">Italian</option><option id=\"app_content_legal_german__option\" value=\"german\">German</option><option id=\"app_content_legal_spanish__option\" value=\"spanish\">Spanish - Spain</option><option id=\"app_content_legal_bulgarian__option\" value=\"bulgarian\">Bulgarian</option><option id=\"app_content_legal_czech__option\" value=\"czech\">Czech</option><option id=\"app_content_legal_danish__option\" value=\"danish\">Danish</option><option id=\"app_content_legal_dutch__option\" value=\"dutch\">Dutch</option><option id=\"app_content_legal_finnish__option\" value=\"finnish\">Finnish</option><option id=\"app_content_legal_greek__option\" value=\"greek\">Greek</option><option id=\"app_content_legal_hungarian__option\" value=\"hungarian\">Hungarian</option><option id=\"app_content_legal_indonesian__option\" value=\"indonesian\">Indonesian</option><option id=\"app_content_legal_japanese__option\" value=\"japanese\">Japanese</option><option id=\"app_content_legal_koreana__option\" value=\"koreana\">Korean</option><option id=\"app_content_legal_malay__option\" value=\"malay\">Malay</option><option id=\"app_content_legal_norwegian__option\" value=\"norwegian\">Norwegian</option><option id=\"app_content_legal_polish__option\" value=\"polish\">Polish</option><option id=\"app_content_legal_brazilian__option\" value=\"brazilian\">Portuguese - Brazil</option><option id=\"app_content_legal_portuguese__option\" value=\"portuguese\">Portuguese - Portugal</option><option id=\"app_content_legal_romanian__option\" value=\"romanian\">Romanian</option><option id=\"app_content_legal_russian__option\" value=\"russian\">Russian</option><option id=\"app_content_legal_schinese__option\" value=\"schinese\">Simplified Chinese</option><option id=\"app_content_legal_latam__option\" value=\"latam\">Spanish - Latin America</option><option id=\"app_content_legal_swedish__option\" value=\"swedish\">Swedish</option><option id=\"app_content_legal_thai__option\" value=\"thai\">Thai</option><option id=\"app_content_legal_tchinese__option\" value=\"tchinese\">Traditional Chinese</option><option id=\"app_content_legal_turkish__option\" value=\"turkish\">Turkish</option><option id=\"app_content_legal_ukrainian__option\" value=\"ukrainian\">Ukrainian</option><option id=\"app_content_legal_vietnamese__option\" value=\"vietnamese\">Vietnamese</option></select><div style=\"clear: both;\"></div></div><textarea id=\"app_content_legal__textarea\" onchange=\"OnLocTextChanged( 'app_content_legal_' )\"></textarea><input type=\"hidden\" id=\"app_content_legal__currentlanguage\"><input type=\"hidden\" id=\"app_content_legal_english__hidden\" lang=\"en\" name=\"app[content][legal][english]\" value=\"\"><input type=\"hidden\" id=\"app_content_legal_french__hidden\" lang=\"fr\" name=\"app[content][legal][french]\" value=\"\"><input type=\"hidden\" id=\"app_content_legal_italian__hidden\" lang=\"it\" name=\"app[content][legal][italian]\" value=\"\"><input type=\"hidden\" id=\"app_content_legal_german__hidden\" lang=\"de\" name=\"app[content][legal][german]\" value=\"\"><input type=\"hidden\" id=\"app_content_legal_spanish__hidden\" lang=\"es\" name=\"app[content][legal][spanish]\" value=\"\"><input type=\"hidden\" id=\"app_content_legal_bulgarian__hidden\" lang=\"bg\" name=\"app[content][legal][bulgarian]\" value=\"\"><input type=\"hidden\" id=\"app_content_legal_czech__hidden\" lang=\"cs\" name=\"app[content][legal][czech]\" value=\"\"><input type=\"hidden\" id=\"app_content_legal_danish__hidden\" lang=\"da\" name=\"app[content][legal][danish]\" value=\"\"><input type=\"hidden\" id=\"app_content_legal_dutch__hidden\" lang=\"nl\" name=\"app[content][legal][dutch]\" value=\"\"><input type=\"hidden\" id=\"app_content_legal_finnish__hidden\" lang=\"fi\" name=\"app[content][legal][finnish]\" value=\"\"><input type=\"hidden\" id=\"app_content_legal_greek__hidden\" lang=\"el\" name=\"app[content][legal][greek]\" value=\"\"><input type=\"hidden\" id=\"app_content_legal_hungarian__hidden\" lang=\"hu\" name=\"app[content][legal][hungarian]\" value=\"\"><input type=\"hidden\" id=\"app_content_legal_indonesian__hidden\" lang=\"id\" name=\"app[content][legal][indonesian]\" value=\"\"><input type=\"hidden\" id=\"app_content_legal_japanese__hidden\" lang=\"ja\" name=\"app[content][legal][japanese]\" value=\"\"><input type=\"hidden\" id=\"app_content_legal_koreana__hidden\" lang=\"ko\" name=\"app[content][legal][koreana]\" value=\"\"><input type=\"hidden\" id=\"app_content_legal_malay__hidden\" lang=\"ms\" name=\"app[content][legal][malay]\" value=\"\"><input type=\"hidden\" id=\"app_content_legal_norwegian__hidden\" lang=\"no\" name=\"app[content][legal][norwegian]\" value=\"\"><input type=\"hidden\" id=\"app_content_legal_polish__hidden\" lang=\"pl\" name=\"app[content][legal][polish]\" value=\"\"><input type=\"hidden\" id=\"app_content_legal_brazilian__hidden\" lang=\"pt-br\" name=\"app[content][legal][brazilian]\" value=\"\"><input type=\"hidden\" id=\"app_content_legal_portuguese__hidden\" lang=\"pt\" name=\"app[content][legal][portuguese]\" value=\"\"><input type=\"hidden\" id=\"app_content_legal_romanian__hidden\" lang=\"ro\" name=\"app[content][legal][romanian]\" value=\"\"><input type=\"hidden\" id=\"app_content_legal_russian__hidden\" lang=\"ru\" name=\"app[content][legal][russian]\" value=\"\"><input type=\"hidden\" id=\"app_content_legal_schinese__hidden\" lang=\"zh-cn\" name=\"app[content][legal][schinese]\" value=\"\"><input type=\"hidden\" id=\"app_content_legal_latam__hidden\" lang=\"es-419\" name=\"app[content][legal][latam]\" value=\"\"><input type=\"hidden\" id=\"app_content_legal_swedish__hidden\" lang=\"sv\" name=\"app[content][legal][swedish]\" value=\"\"><input type=\"hidden\" id=\"app_content_legal_thai__hidden\" lang=\"th\" name=\"app[content][legal][thai]\" value=\"\"><input type=\"hidden\" id=\"app_content_legal_tchinese__hidden\" lang=\"zh-tw\" name=\"app[content][legal][tchinese]\" value=\"\"><input type=\"hidden\" id=\"app_content_legal_turkish__hidden\" lang=\"tr\" name=\"app[content][legal][turkish]\" value=\"[turkish text removed]\"><input type=\"hidden\" id=\"app_content_legal_ukrainian__hidden\" lang=\"uk\" name=\"app[content][legal][ukrainian]\" value=\"\"><input type=\"hidden\" id=\"app_content_legal_vietnamese__hidden\" lang=\"vi\" name=\"app[content][legal][vietnamese]\" value=\"\"></div>\t\t</div>\n\n\n\t\t<div class=\"section supportInfo\">\n            <a name=\"supportInfo\"></a>\n\t\t\t<h2>Support Contact Info<span class=\"required\">*</span></h2>\n\t\t\t<div class=\"grayRule\"> </div>\n\n\t\t\t<div class=\"sectionDescription\">Please provide one or more ways for customers to contact your support department if they have an issue with this product. This information will be shown to customers that search for your product on the <a href=\"https://support.steampowered.com/\" target=\"_blank\">Steam Support site</a>. Any website URL entered should start with \"http://\" or \"https://\"</div>\n\n\t\t\t<table>\n\t\t\t\t<tr>\n\t\t\t\t\t<td width=\"30%\">Support Website URL:</td>\n\t\t\t\t\t<td width=\"70%\"><input style=\"width:400px;\" name=\"app[content][support_info][url]\" id=\"app[content][support_info][url]\" value=\"\"></input></td>\n\t\t\t\t</tr>\n\t\t\t\t<tr>\n\t\t\t\t\t<td width=\"30%\">Support Email:</td>\n\t\t\t\t\t<td width=\"70%\"><input style=\"width:400px;\" name=\"app[content][support_info][email]\" id=\"app[content][support_info][email]\" value=\"\"></input></td>\n\t\t\t\t</tr>\n\t\t\t\t<tr>\n\t\t\t\t\t<td width=\"30%\">Support Phone #:</td>\n\t\t\t\t\t<td width=\"70%\"><input style=\"width:400px;\" name=\"app[content][support_info][phone]\" id=\"app[content][support_info][phone]\" value=\"\"></input></td>\n\t\t\t\t</tr>\n\t\t\t</table>\n\t\t</div>\n\t\n\t\n\t<div class=\"form_footer sticky_save_bar\">\n\t\t<div><input class=\"btn_green_white_innerfade btn_medium xtra_padding\" type=\"submit\" value=\"Save\" id=\"submitBtn\"></div>\n\t</div>\n</div>\n\n<div class=\"tab_content \" id=\"tab_description_content\">\n\t\n<div class=\"section\">\n\t        <div class=\"instructions\">\n            <div class=\"title2\">About This Game<span class=\"required\">*</span></div>\n            <br clear=\"left\">\n            <div class=\"grayRule\"> </div>\n\n\t\t\t\n            <div class=\"instructions_table\">\n                <div class=\"instructions_table_row\">\n                    <div class=\"instructions_table_cell left\">\n                        <strong>Overview:</strong>\n                    </div>\n                    <div class=\"instructions_table_cell\">\n                        <p>Use this space to describe your Game. Typically it is a good idea to start with a brief overview--if customers read nothing else, it should give them a pretty good idea of what your Game is about. Then you can go into more detail, add a list of key features, and whatever else you feel is relevant to describing your product.</p>\n                        <div class=\"sectionDescription alertText\">Note: From this section, you should not include links to other websites, QR codes, or any other images advertising your social media. Please use the fields under the 'Basic Info' tab or post additional links within your Steam Community.</div>\n                    </div>\n                </div>\n\n                <div class=\"instructions_table_row\">\n                    <div class=\"instructions_table_cell left\">\n                        <strong>Localization:</strong>\n                    </div>\n                    <div class=\"instructions_table_cell\">\n                        <p>To add localized versions of your text, select the desired language from the drop-down box to the right and insert your text into the description field for that language. Or you can bulk upload localized text under the Localization tab above.</p>\n                    </div>\n                </div>\n            </div>\n\n\t\t\t<div class=\"instructions\" id=\"custom\">\n\t\t\t\t<div class=\"title3\" >Uploading Custom Images</div>\n\t\t\t\t<div class=\"grayRule\"></div>\n\n\t\t\t\t<div class=\"instructions_table\">\n\t\t\t\t\t<div class=\"instructions_table_row\">\n\t\t\t\t\t\t<div class=\"instructions_table_cell left\">\n\t\t\t\t\t\t\t<strong>Overview:</strong>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class=\"instructions_table_cell\">\n\t\t\t\t\t\t\t<p>Use the space below to upload and manage custom images for use in the About This Game, Special Announcements, and Awards sections. Images uploaded here can be inserted by clicking the <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 36 36\" fill=\"none\" class=\"inline_svg\"><path d=\"M2 6.05005V30.05H34V6.05005H2ZM25 10.05C25.5933 10.05 26.1734 10.226 26.6667 10.5556C27.1601 10.8853 27.5446 11.3538 27.7716 11.902C27.9987 12.4502 28.0581 13.0534 27.9424 13.6353C27.8266 14.2173 27.5409 14.7518 27.1213 15.1714C26.7018 15.5909 26.1672 15.8766 25.5853 15.9924C25.0033 16.1082 24.4001 16.0488 23.8519 15.8217C23.3038 15.5946 22.8352 15.2101 22.5056 14.7168C22.1759 14.2234 22 13.6434 22 13.05C22 12.2544 22.3161 11.4913 22.8787 10.9287C23.4413 10.3661 24.2044 10.05 25 10.05ZM23 26.05H6L14.5 15.05L19.4 21.39L22 18.05L28.22 26.05H23Z\" fill=\"currentColor\"></path></svg> image button in the row of formatting options above the description editor.</p>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\n\t\t\t\t\t<div class=\"instructions_table_row\">\n\t\t\t\t\t\t<div class=\"instructions_table_cell left\">\n\t\t\t\t\t\t\t<strong>Design:</strong>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class=\"instructions_table_cell\">\n\t\t\t\t\t\t\t<p>Please take care with the size of images you upload and display on your store page. Every image increases the time taken to load the page and could cause customers to abandon the visit.</p>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\n\t\t\t\t\t<div class=\"instructions_table_row\">\n\t\t\t\t\t\t<div class=\"instructions_table_cell left\">\n\t\t\t\t\t\t\t<strong>Format:</strong>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class=\"instructions_table_cell\">\n\t\t\t\t\t\t\t<p>Static formats: PNG, JPG, GIF, WEBP.<br>Animated formats: MP4, and WEBM formats are supported at this time, however, animations will only display in the About This and Special Announcement sections of the store page. For animated assets with transparency, please use Webm (with vp9 encoding), APNG, or GIF.</p>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\n\t\t\t\t\t<div class=\"instructions_table_row\">\n\t\t\t\t\t\t<div class=\"instructions_table_cell left\">\n\t\t\t\t\t\t\t<strong>Size:</strong>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class=\"instructions_table_cell\">\n\t\t\t\t\t\t\t<p>On desktop, your description area is 780px wide, but we recommend uploading higher resolution assets.<br>New assets uploaded that are wider than 1600px will be clickable on the store page to open a viewer for the larger version.<br>Assets of any dimensions can be uploaded, but will be resized down to a maximum of 4096x8192.<br>Animated assets can be a maximum of 12 seconds in duration.</p>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\n\t\t\t\t\t<div class=\"instructions_table_row\">\n\t\t\t\t\t\t<div class=\"instructions_table_cell left\">\n\t\t\t\t\t\t\t<strong>Localization:</strong>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class=\"instructions_table_cell\">\n\t\t\t\t\t\t\t<p>Name your assets with a Steam <a href=\"https://partner.steamgames.com/doc/store/localization/languages\" target=\"_blank\">language code</a> (e.g. myimage_dutch.jpg) and they will automatically be grouped by language. The group can be referenced in the description and will automatically pick the right image from the group for the language.</p>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<p>For more information, see <a href=\"https://partner.steamgames.com/doc/store/page/assets\" target=\"_blank\">Store Page Extra Asset Management</a> documentation.</p>\n\t\t\t</div>\n        </div>\n        <div class=\"descriptionRow\">\n\t\t\t<div  data-featuretarget=\"storeadmin-app-description-editor\" data-props=\"{&quot;editorType&quot;:&quot;aboutthegame&quot;,&quot;rgLanguages&quot;:[[&quot;english&quot;,&quot;English&quot;],[&quot;french&quot;,&quot;French&quot;],[&quot;italian&quot;,&quot;Italian&quot;],[&quot;german&quot;,&quot;German&quot;],[&quot;spanish&quot;,&quot;Spanish - Spain&quot;],[&quot;bulgarian&quot;,&quot;Bulgarian&quot;],[&quot;czech&quot;,&quot;Czech&quot;],[&quot;danish&quot;,&quot;Danish&quot;],[&quot;dutch&quot;,&quot;Dutch&quot;],[&quot;finnish&quot;,&quot;Finnish&quot;],[&quot;greek&quot;,&quot;Greek&quot;],[&quot;hungarian&quot;,&quot;Hungarian&quot;],[&quot;indonesian&quot;,&quot;Indonesian&quot;],[&quot;japanese&quot;,&quot;Japanese&quot;],[&quot;koreana&quot;,&quot;Korean&quot;],[&quot;malay&quot;,&quot;Malay&quot;],[&quot;norwegian&quot;,&quot;Norwegian&quot;],[&quot;polish&quot;,&quot;Polish&quot;],[&quot;brazilian&quot;,&quot;Portuguese - Brazil&quot;],[&quot;portuguese&quot;,&quot;Portuguese - Portugal&quot;],[&quot;romanian&quot;,&quot;Romanian&quot;],[&quot;russian&quot;,&quot;Russian&quot;],[&quot;schinese&quot;,&quot;Simplified Chinese&quot;],[&quot;latam&quot;,&quot;Spanish - Latin America&quot;],[&quot;swedish&quot;,&quot;Swedish&quot;],[&quot;thai&quot;,&quot;Thai&quot;],[&quot;tchinese&quot;,&quot;Traditional Chinese&quot;],[&quot;turkish&quot;,&quot;Turkish&quot;],[&quot;ukrainian&quot;,&quot;Ukrainian&quot;],[&quot;vietnamese&quot;,&quot;Vietnamese&quot;]],&quot;value&quot;:[[&quot;english&quot;,&quot;[p]steamworks-mcp test: About This Game placeholder.[/p]&quot;],[&quot;turkish&quot;,&[turkish text removed]&quot;],[&quot;german&quot;,&quot;steamworks-mcp-Test (2): Platzhalter für „Über dieses Spiel“.&quot;]],&quot;strNamePrefix&quot;:&quot;app&quot;,&quot;rgPath&quot;:[&quot;content&quot;,&quot;about&quot;],&quot;asset_mtime&quot;:0}\"></div>\t\t\t<div class=\"section\">\n\t\t\t\t<div class=\"title2\">Upload Custom Images</div>\n\t\t\t\t<br clear=\"left\">\n\t\t\t\t<div class=\"grayRule\"></div>\n\n\t\t\t\t<div  data-featuretarget=\"storeadmin-app-extraassetslist\" data-props=\"{&quot;asset_mtime&quot;:0,&quot;assets_list&quot;:[]}\"></div>\t\t\t\t\t\t\t</div>\n\t\t</div>\n\t\n\t\n    <div class=\"instructions\">\n        <div class=\"title2\">Short Description<span class=\"required\">*</span></div>\n        <br clear=\"left\">\n        <div class=\"grayRule\"> </div>\n\n        \n        <div class=\"instructions_table\">\n            <div class=\"instructions_table_row\">\n                <div class=\"instructions_table_cell left\">\n                    <strong>Overview:</strong>\n                </div>\n                <div class=\"instructions_table_cell\">\n                    <p>The short description appears immediately below your branding image in the upper-right corner of your store page. It may also be used if your game is listed on certain kinds of sales and promotions pages. The short description should be in sentence format and in plaintext. Avoid using white space formatting, bullet points, or other stylistic choices as they will not render properly.</p>\n\n                </div>\n            </div>\n\n            <div class=\"instructions_table_row\">\n                <div class=\"instructions_table_cell left\">\n                    <strong>Design:</strong>\n                </div>\n                <div class=\"instructions_table_cell\">\n                    <p>Use the space to describe the mechanics and genre of your game. Here are a couple of tips for crafting your short description:\n                                              <ul><li>Identify your game’s genre and theme (eg. \"A sci-fi turn-based strategy game\")</li>\n                                              <li>Use specific verbs detailing your game’s primary mechanics and player actions</li>\n                                              <li>Communicate the essential appeal of your game</li>\n                                              <li>Save details regarding your game’s story and setting for your longer description</li>\n                                              </ul></p>\n                </div>\n            </div>\n\n            <div class=\"instructions_table_row\">\n                <div class=\"instructions_table_cell left\">\n                    <strong>Localization:</strong>\n                </div>\n                <div class=\"instructions_table_cell\">\n                    <p>To add localized versions of your text, select the desired language from the drop-down box to the right and insert your text into the description field for that language. Or you can bulk upload localized text under the Localization tab above.</p>\n                </div>\n            </div>\n\n        </div>\n    </div>\n    <br>\n\n\t<div class=\"subsection\">\n\t\t<div class=\"newformrow\">\n\t\t\t<p id=\"app_content_short_description_length_warning\">Length: 200-300 characters</p>\n\t\t\t<div id=\"app_content_short_description__area\" class=\"LocTextArea\"><div class=\"LocTextAreaBar\"><select id=\"app_content_short_description__select\" class=\"LocTextAreaLangSelect\" onfocus=\"LocUpdateLangThatHaveText( 'app_content_short_description_' )\" onchange=\"OnLocLanguageSelect( 'app_content_short_description_' )\"><option id=\"app_content_short_description_english__option\" value=\"english\">English</option><option id=\"app_content_short_description_french__option\" value=\"french\">French</option><option id=\"app_content_short_description_italian__option\" value=\"italian\">Italian</option><option id=\"app_content_short_description_german__option\" value=\"german\">German</option><option id=\"app_content_short_description_spanish__option\" value=\"spanish\">Spanish - Spain</option><option id=\"app_content_short_description_bulgarian__option\" value=\"bulgarian\">Bulgarian</option><option id=\"app_content_short_description_czech__option\" value=\"czech\">Czech</option><option id=\"app_content_short_description_danish__option\" value=\"danish\">Danish</option><option id=\"app_content_short_description_dutch__option\" value=\"dutch\">Dutch</option><option id=\"app_content_short_description_finnish__option\" value=\"finnish\">Finnish</option><option id=\"app_content_short_description_greek__option\" value=\"greek\">Greek</option><option id=\"app_content_short_description_hungarian__option\" value=\"hungarian\">Hungarian</option><option id=\"app_content_short_description_indonesian__option\" value=\"indonesian\">Indonesian</option><option id=\"app_content_short_description_japanese__option\" value=\"japanese\">Japanese</option><option id=\"app_content_short_description_koreana__option\" value=\"koreana\">Korean</option><option id=\"app_content_short_description_malay__option\" value=\"malay\">Malay</option><option id=\"app_content_short_description_norwegian__option\" value=\"norwegian\">Norwegian</option><option id=\"app_content_short_description_polish__option\" value=\"polish\">Polish</option><option id=\"app_content_short_description_brazilian__option\" value=\"brazilian\">Portuguese - Brazil</option><option id=\"app_content_short_description_portuguese__option\" value=\"portuguese\">Portuguese - Portugal</option><option id=\"app_content_short_description_romanian__option\" value=\"romanian\">Romanian</option><option id=\"app_content_short_description_russian__option\" value=\"russian\">Russian</option><option id=\"app_content_short_description_schinese__option\" value=\"schinese\">Simplified Chinese</option><option id=\"app_content_short_description_latam__option\" value=\"latam\">Spanish - Latin America</option><option id=\"app_content_short_description_swedish__option\" value=\"swedish\">Swedish</option><option id=\"app_content_short_description_thai__option\" value=\"thai\">Thai</option><option id=\"app_content_short_description_tchinese__option\" value=\"tchinese\">Traditional Chinese</option><option id=\"app_content_short_description_turkish__option\" value=\"turkish\">Turkish</option><option id=\"app_content_short_description_ukrainian__option\" value=\"ukrainian\">Ukrainian</option><option id=\"app_content_short_description_vietnamese__option\" value=\"vietnamese\">Vietnamese</option></select><div style=\"clear: both;\"></div></div><textarea id=\"app_content_short_description__textarea\" onchange=\"OnLocTextChanged( 'app_content_short_description_' )\"></textarea><input type=\"hidden\" id=\"app_content_short_description__currentlanguage\"><input type=\"hidden\" id=\"app_content_short_description_english__hidden\" lang=\"en\" name=\"app[content][short_description][english]\" value=\"[steamworks-mcp test] ExampleGame is a fast arcade shooter where every shot ricochets. Bank shots off walls, chain combos across the arena and climb the daily leaderboards. Placeholder text written by an automated test.\"><input type=\"hidden\" id=\"app_content_short_description_french__hidden\" lang=\"fr\" name=\"app[content][short_description][french]\" value=\"\"><input type=\"hidden\" id=\"app_content_short_description_italian__hidden\" lang=\"it\" name=\"app[content][short_description][italian]\" value=\"\"><input type=\"hidden\" id=\"app_content_short_description_german__hidden\" lang=\"de\" name=\"app[content][short_description][german]\" value=\"[steamworks-mcp test] ExampleGame ist ein schneller Arcade-Shooter, in dem jeder Schuss abprallt. Spiele Bandenschüsse über die Wände, verkette Combos in der Arena und erklimme die täglichen Bestenlisten. Platzhaltertext eines automatisierten Tests.\"><input type=\"hidden\" id=\"app_content_short_description_spanish__hidden\" lang=\"es\" name=\"app[content][short_description][spanish]\" value=\"\"><input type=\"hidden\" id=\"app_content_short_description_bulgarian__hidden\" lang=\"bg\" name=\"app[content][short_description][bulgarian]\" value=\"\"><input type=\"hidden\" id=\"app_content_short_description_czech__hidden\" lang=\"cs\" name=\"app[content][short_description][czech]\" value=\"\"><input type=\"hidden\" id=\"app_content_short_description_danish__hidden\" lang=\"da\" name=\"app[content][short_description][danish]\" value=\"\"><input type=\"hidden\" id=\"app_content_short_description_dutch__hidden\" lang=\"nl\" name=\"ap