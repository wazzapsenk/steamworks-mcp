            "text": "{\"itemid\":\"2000000\",\"languages\":{\"english\":{\"app[content][about]\":\"[p]steamworks-mcp test: About This Game placeholder.[/p]\",\"app[content][short_description]\":\"[steamworks-mcp test] ExampleGame is a fast arcade shooter where every shot ricochets. Bank shots off walls, chain combos across the arena and climb the daily leaderboards. Placeholder text written by an automated test. (recording)\"},\"french\":{\"app[content][about]\":\"\",\"app[content][short_description]\":\"\"},\"italian\":{\"app[content][about]\":\"\",\"app[content][short_description]\":\"\"},\"german\":{\"app[content][about]\":\"steamworks-mcp-Test (2): Platzhalter für „Über dieses Spiel“.\",\"app[content][short_description]\":\"[steamworks-mcp test] ExampleGame ist ein schneller Arcade-Shooter, in dem jeder Schuss abprallt. Spiele Bandenschüsse über die Wände, verkette Combos in der Arena und erklimme die täglichen Bestenlisten. Platzhaltertext eines automatisierten Tests.\"},\"spanish\":{\"app[content][about]\":\"\",\"app[content][short_description]\":\"\"},\"bulgarian\":{\"app[content][about]\":\"\",\"app[content][short_description]\":\"\"},\"czech\":{\"app[content][about]\":\"\",\"app[content][short_description]\":\"\"},\"danish\":{\"app[content][about]\":\"\",\"app[content][short_description]\":\"\"},\"dutch\":{\"app[content][about]\":\"\",\"app[content][short_description]\":\"\"},\"finnish\":{\"app[content][about]\":\"\",\"app[content][short_description]\":\"\"},\"greek\":{\"app[content][about]\":\"\",\"app[content][short_description]\":\"\"},\"hungarian\":{\"app[content][about]\":\"\",\"app[content][short_description]\":\"\"},\"indonesian\":{\"app[content][about]\":\"\",\"app[content][short_description]\":\"\"},\"japanese\":{\"app[content][about]\":\"\",\"app[content][short_description]\":\"\"},\"koreana\":{\"app[content][about]\":\"\",\"app[content][short_description]\":\"\"},\"malay\":{\"app[content][about]\":\"\",\"app[content][short_description]\":\"\"},\"