_malay__option\" value=\"malay\">Malay</option><option id=\"app_content_reviews_2_quote_norwegian__option\" value=\"norwegian\">Norwegian</option><option id=\"app_content_reviews_2_quote_polish__option\" value=\"polish\">Polish</option><option id=\"app_content_reviews_2_quote_brazilian__option\" value=\"brazilian\">Portuguese - Brazil</option><option id=\"app_content_reviews_2_quote_portuguese__option\" value=\"portuguese\">Portuguese - Portugal</option><option id=\"app_content_reviews_2_quote_romanian__option\" value=\"romanian\">Romanian</option><option id=\"app_content_reviews_2_quote_russian__option\" value=\"russian\">Russian</option><option id=\"app_content_reviews_2_quote_schinese__option\" value=\"schinese\">Simplified Chinese</option><option id=\"app_content_reviews_2_quote_latam__option\" value=\"latam\">Spanish - Latin America</option><option id=\"app_content_reviews_2_quote_swedish__option\" value=\"swedish\">Swedish</option><option id=\"app_content_reviews_2_quote_thai__option\" value=\"thai\">Thai</option><option id=\"app_content_reviews_2_quote_tchinese__option\" value=\"tchinese\">Traditional Chinese</option><option id=\"app_content_reviews_2_quote_turkish__option\" value=\"turkish\">Turkish</option><option id=\"app_content_reviews_2_quote_ukrainian__option\" value=\"ukrainian\">Ukrainian</option><option id=\"app_content_reviews_2_quote_vietnamese__option\" value=\"vietnamese\">Vietnamese</option></select></div>\t\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</div>\n\t\t\t</div>\n\n\t<div class=\"subsection\">\n\t\t<h2>Awards</h2>\n\t\t<div class=\"grayRule\"></div>\n\t\t<div class=\"sectionDescription\">Has the Game received any significant awards or recognition that we should call out on the product page?</div>\n\t\t<button type=\"button\" onclick=\"Effect.BlindDown( 'game_description_awards', {duration: 0.2} ); $(this).hide(); return false;\" style=\"\">Add award info\t\t</button>\n\t\t<div id=\"game_description_awards\" style=\"display: none;\">\n\t\t\t<div  data-featuretarget=\"storeadmin-app-description-editor\" data-props=\"{&quot;editorType&quot;:&quot;awards&quot;,&quot;rgLanguages&quot;:[[&quot;english&quot;,&quot;English&quot;],[&quot;french&quot;,&quot;French&quot;],[&quot;italian&quot;,&quot;Italian&quot;],[&quot;german&quot;,&quot;German&quot;],[&quot;spanish&quot;,&quot;Spanish - Spain&quot;],[&quot;bulgarian&quot;,&quot;Bulgarian&quot;],[&quot;czech&quot;,&quot;Czech&quot;],[&quot;danish&quot;,&quot;Danish&quot;],[&quot;dutch&quot;,&quot;Dutch&quot;],[&quot;finnish&quot;,&quot;Finnish&quot;],[&quot;greek&quot;,&quot;Greek&quot;],[&quot;hungarian&quot;,&quot;Hungarian&quot;],[&quot;indonesian&quot;,&quot;Indonesian&quot;],[&quot;japanese&quot;,&quot;Japanese&quot;],[&quot;koreana&quot;,&quot;Korean&quot;],[&quot;malay&quot;,&quot;Malay&quot;],[&quot;norwegian&quot;,&quot;Norwegian&quot;],[&quot;polish&quot;,&quot;Polish&quot;],[&quot;brazilian&quot;,&quot;Portuguese - Brazil&quot;],[&quot;portuguese&quot;,&quot;Portuguese - Portugal&quot;],[&quot;romanian&quot;,&quot;Romanian&quot;],[&quot;russian&quot;,&quot;Russian&quot;],[&quot;schinese&quot;,&quot;Simplified Chinese&quot;],[&quot;latam&quot;,&quot;Spanish - Latin America&quot;],[&quot;swedish&quot;,&quot;Swedish&quot;],[&quot;thai&quot;,&quot;Thai&quot;],[&quot;tchinese&quot;,&quot;Traditional Chinese&quot;],[&quot;turkish&quot;,&quot;Turkish&quot;],[&quot;ukrainian&quot;,&quot;Ukrainian&quot;],[&quot;vietnamese&quot;,&quot;Vietnamese&quot;]],&quot;value&quot;:[],&quot;strNamePrefix&quot;:&quot;app&quot;,&quot;rgPath&quot;:[&quot;content&quot;,&quot;awards&quot;,&quot;short&quot;],&quot;asset_mtime&quot;:0}\"></div>\t\t</div>\n\t</div>\n\n\t\n\t\t<div class=\"subsection\">\n\t\t<h2>Special Announcement Section</h2>\n\t\t<div class=\"grayRule\"></div>\n\t\t<div class=\"sectionDescription\">This is for special announcements or features that you want to call out above your product description. These are typically used to show information about special editions, pre-purchase offers, or to present a banner for Workshop integration.</div>\n\t\t<div class=\"sectionDescription\">You can add more than one by filling in the information and hitting 'save'.</div>\n\t\t<div class=\"sectionDescription\">You can upload custom images by simply dragging or pasting them in. For details on supported formats, sizes, and design, please see details above under <a href=\"#custom\">Uploading Custom Images</a> above.</div>\n\n\t\t<button type=\"button\" onclick=\"Effect.BlindDown( 'game_description_preorder', {duration: 0.2} ); $(this).hide(); return false;\" style=\"\">Add a section</button>\n\t\t\t\t<div id=\"game_description_preorder\" style=\"display: none;\">\n\t\t\t<div class=\"boxlist\">\n\t\t\t\t\t\t\t\t\t<div class=\"boxlist_item \">\n\t\t\t\t\t\t<div class=\"boxlist_title\">\n\t\t\t\t\t\t\t<div class=\"boxlist_controls\">\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class=\"boxlist_content\">\n\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t<div class=\"specialannouncementarea\">\n\t\t\t\t\t\t\t\t<div class=\"newformrow\">\n\t\t\t\t\t\t\t\t\t<div class=\"formlabel\">Section Header:</div>\n\t\t\t\t\t\t\t\t\t<div class=\"formdata\">\n\t\t\t\t\t\t\t\t\t\t<div class=\"newformrow\">\n\t\t\t\t\t\t\t\t\t\t\t<div style=\"float: right;\">\n\t\t\t\t\t\t\t\t\t\t\t\t<a href=\"javascript:SubmitQuickMessageUpdate({'app[content][sections][0]': ''});\">Delete</a>\n\t\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t\t\t<div id=\"app_content_sections_0_label__area\" class=\"LocTextArea\"><input type=\"text\" id=\"app_content_sections_0_label__textarea\" onchange=\"OnLocTextChanged( 'app_content_sections_0_label_' )\"><input type=\"hidden\" id=\"app_content_sections_0_label__currentlanguage\"><input type=\"hidden\" id=\"app_content_sections_0_label_english__hidden\" name=\"app[content][sections][0][label][english]\" value=\"\" lang=\"en\"><input type=\"hidden\" id=\"app_content_sections_0_label_french__hidden\" name=\"app[content][sections][0][label][french]\" value=\"\" lang=\"fr\"><input type=\"hidden\" id=\"app_content_sections_0_label_italian__hidden\" name=\"app[content][sections][0][label][italian]\" value=\"\" lang=\"it\"><input type=\"hidden\" id=\"app_content_sections_0_label_german__hidden\" name=\"app[content][sections][0][label][german]\" value=\"\" lang=\"de\"><input type=\"hidden\" id=\"app_content_sections_0_label_spanish__hidden\" name=\"app[content][sections][0][label][spanish]\" value=\"\" lang=\"es\"><input type=\"hidden\" id=\"app_content_sections_0_label_bulgarian__hidden\" name=\"app[content][sections][0][label][bulgarian]\" value=\"\" lang=\"bg\"><input type=\"hidden\" id=\"app_content_sections_0_label_czech__hidden\" name=\"app[content][sections][0][label][czech]\" value=\"\" lang=\"cs\"><input type=\"hidden\" id=\"app_content_sections_0_label_danish__hidden\" name=\"app[content][sections][0][label][danish]\" value=\"\" lang=\"da\"><input type=\"hidden\" id=\"app_content_sections_0_label_dutch__hidden\" name=\"app[content][sections][0][label][dutch]\" value=\"\" lang=\"nl\"><input type=\"hidden\" id=\"app_content_sections_0_label_finnish__hidden\" name=\"app[content][sections][0][label][finnish]\" value=\"\" lang=\"fi\"><input type=\"hidden\" id=\"app_content_sections_0_label_greek__hidden\" name=\"app[content][sections][0][label][greek]\" value=\"\" lang=\"el\"><input type=\"hidden\" id=\"app_content_sections_0_label_hungarian__hidden\" name=\"app[content][sections][0][label][hungarian]\" value=\"\" lang=\"hu\"><input type=\"hidden\" id=\"app_content_sections_0_label_indonesian__hidden\" name=\"app[content][sections][0][label][indonesian]\" value=\"\" lang=\"id\"><input type=\"hidden\" id=\"app_content_sections_0_label_japanese__hidden\" name=\"app[content][sections][0][label][japanese]\" value=\"\" lang=\"ja\"><input type=\"hidden\" id=\"app_content_sections_0_label_koreana__hidden\" name=\"app[content][sections][0][label][koreana]\" value=\"\" lang=\"ko\"><input type=\"hidden\" id=\"app_content_sections_0_label_malay__hidden\" name=\"app[content][sections][0][label][malay]\" value=\"\" lang=\"ms\"><input type=\"hidden\" id=\"app_content_sections_0_label_norwegian__hidden\" name=\"app[content][sections][0][label][norwegian]\" value=\"\" lang=\"no\"><input type=\"hidden\" id=\"app_content_sections_0_label_polish__hidden\" name=\"app[content][sections][0][label][polish]\" value=\"\" lang=\"pl\"><input type=\"hidden\" id=\"app_content_sections_0_label_brazilian__hidden\" name=\"app[content][sections][0][label][brazilian]\" value=\"\" lang=\"pt-br\"><input type=\"hidden\" id=\"app_content_sections_0_label_portuguese__hidden\" name=\"app[content][sections][0][label][portuguese]\" value=\"\" lang=\"pt\"><input type=\"hidden\" id=\"app_content_sections_0_label_romanian__hidden\" name=\"app[content][sections][0][label][romanian]\" value=\"\" lang=\"ro\"><input type=\"hidden\" id=\"app_content_sections_0_label_russian__hidden\" name=\"app[content][sections][0][label][russian]\" value=\"\" lang=\"ru\"><input type=\"hidden\" id=\"app_content_sections_0_label_schinese__hidden\" name=\"app[content][sections][0][label][schinese]\" value=\"\" lang=\"zh-cn\"><input type=\"hidden\" id=\"app_content_sections_0_label_latam__hidden\" name=\"app[content][sections][0][label][latam]\" value=\"\" lang=\"es-419\"><input type=\"hidden\" id=\"app_content_sections_0_label_swedish__hidden\" name=\"app[content][sections][0][label][swedish]\" value=\"\" lang=\"sv\"><input type=\"hidden\" id=\"app_content_sections_0_label_thai__hidden\" name=\"app[content][sections][0][label][thai]\" value=\"\" lang=\"th\"><input type=\"hidden\" id=\"app_content_sections_0_label_tchinese__hidden\" name=\"app[content][sections][0][label][tchinese]\" value=\"\" lang=\"zh-tw\"><input type=\"hidden\" id=\"app_content_sections_0_label_turkish__hidden\" name=\"app[content][sections][0][label][turkish]\" value=\"[turkish text removed]\" lang=\"tr\"><input type=\"hidden\" id=\"app_content_sections_0_label_ukrainian__hidden\" name=\"app[content][sections][0][label][ukrainian]\" value=\"\" lang=\"uk\"><input type=\"hidden\" id=\"app_content_sections_0_label_vietnamese__hidden\" name=\"app[content][sections][0][label][vietnamese]\" value=\"\" lang=\"vi\"><select id=\"app_content_sections_0_label__select\" class=\"LocTextAreaLangSelect\" onfocus=\"LocUpdateLangThatHaveText( 'app_content_sections_0_label_' )\" onchange=\"OnLocLanguageSelect( 'app_content_sections_0_label_' )\"><option id=\"app_content_sections_0_label_english__option\" value=\"english\">English</option><option id=\"app_content_sections_0_label_french__option\" value=\"french\">French</option><option id=\"app_content_sections_0_label_italian__option\" value=\"italian\">Italian</option><option id=\"app_content_sections_0_label_german__option\" value=\"german\">German</option><option id=\"app_content_sections_0_label_spanish__option\" value=\"spanish\">Spanish - Spain</option><option id=\"app_content_sections_0_label_bulgarian__option\" value=\"bulgarian\">Bulgarian</option><option id=\"app_content_sections_0_label_czech__option\" value=\"czech\">Czech</option><option id=\"app_content_sections_0_label_danish__option\" value=\"danish\">Danish</option><option id=\"app_content_sections_0_label_dutch__option\" value=\"dutch\">Dutch</option><option id=\"app_content_sections_0_label_finnish__option\" value=\"finnish\">Finnish</option><option id=\"app_content_sections_0_label_greek__option\" value=\"greek\">Greek</option><option id=\"app_content_sections_0_label_hungarian__option\" value=\"hungarian\">Hungarian</option><option id=\"app_content_sections_0_label_indonesian__option\" value=\"indonesian\">Indonesian</option><option id=\"app_content_sections_0_label_japanese__option\" value=\"japanese\">Japanese</option><option id=\"app_content_sections_0_label_koreana__option\" value=\"koreana\">Korean</option><option id=\"app_content_sections_0_label_malay__option\" value=\"malay\">Malay</option><option id=\"app_content_sections_0_label_norwegian__option\" value=\"norwegian\">Norwegian</option><option id=\"app_content_sections_0_label_polish__option\" value=\"polish\">Polish</option><option id=\"app_content_sections_0_label_brazilian__option\" value=\"brazilian\">Portuguese - Brazil</option><option id=\"app_content_sections_0_label_portuguese__option\" value=\"portuguese\">Portuguese - Portugal</option><option id=\"app_content_sections_0_label_romanian__option\" value=\"romanian\">Romanian</option><option id=\"app_content_sections_0_label_russian__option\" value=\"russian\">Russian</option><option id=\"app_content_sections_0_label_schinese__option\" value=\"schinese\">Simplified Chinese</option><option id=\"app_content_sections_0_label_latam__option\" value=\"latam\">Spanish - Latin America</option><option id=\"app_content_sections_0_label_swedish__option\" value=\"swedish\">Swedish</option><option id=\"app_content_sections_0_label_thai__option\" value=\"thai\">Thai</option><option id=\"app_content_sections_0_label_tchinese__option\" value=\"tchinese\">Traditional Chinese</option><option id=\"app_content_sections_0_label_turkish__option\" value=\"turkish\">Turkish</option><option id=\"app_content_sections_0_label_ukrainian__option\" value=\"ukrainian\">Ukrainian</option><option id=\"app_content_sections_0_label_vietnamese__option\" value=\"vietnamese\">Vietnamese</option></select></div>\t\t\t\t\t\t\t\t\t\t\tOr select a predefined string:\t\t\t\t\t\t\t\t\t\t\t<select onchange=\"$('app_content_sections_0_label__textarea').value = this.value; OnLocTextChanged( 'app_content_sections_0_label_' ); OnPreOrderLabelChange( 0 );\" name=\"\" id=\"_entry\">\n<option selected=\"selected\" value=\"\"></option>\n<option value=\"#label_collectors_edition\">Collector's Edition</option>\n<option value=\"#label_digital_deluxe_edition\">Digital Deluxe Edition</option>\n<option value=\"#label_free_weekend\">Free Weekend</option>\n<option value=\"#label_limited_edition\">Limited Edition</option>\n<option value=\"#label_just_updated\">Just Updated</option>\n<option value=\"#label_pre_order_offer\">Pre-Purchase Offer</option>\n<option value=\"#label_special_edition\">Special Edition</option>\n<option value=\"#label_special_offer\">Special Offer</option>\n<option value=\"#label_feature_list\">Feature List</option>\n<option value=\"#label_pre_order_rewards\">Pre-Purchase Rewards</option>\n<option value=\"#label_roadmap\">Roadmap</option>\n</select>\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<div class=\"newformrow\">\n\t\t\t\t\t\t\t\t\t\t<div class=\"formlabel\">Content:</div>\n\t\t\t\t\t\t\t\t\t\t<div class=\"formdata\">\n\t\t\t\t\t\t\t\t\t\t\t<div  data-featuretarget=\"storeadmin-app-description-editor\" data-props=\"{&quot;editorType&quot;:&quot;contentsection&quot;,&quot;rgLanguages&quot;:[[&quot;english&quot;,&quot;English&quot;],[&quot;french&quot;,&quot;French&quot;],[&quot;italian&quot;,&quot;Italian&quot;],[&quot;german&quot;,&quot;German&quot;],[&quot;spanish&quot;,&quot;Spanish - Spain&quot;],[&quot;bulgarian&quot;,&quot;Bulgarian&quot;],[&quot;czech&quot;,&quot;Czech&quot;],[&quot;danish&quot;,&quot;Danish&quot;],[&quot;dutch&quot;,&quot;Dutch&quot;],[&quot;finnish&quot;,&quot;Finnish&quot;],[&quot;greek&quot;,&quot;Greek&quot;],[&quot;hungarian&quot;,&quot;Hungarian&quot;],[&quot;indonesian&quot;,&quot;Indonesian&quot;],[&quot;japanese&quot;,&quot;Japanese&quot;],[&quot;koreana&quot;,&quot;Korean&quot;],[&quot;malay&quot;,&quot;Malay&quot;],[&quot;norwegian&quot;,&quot;Norwegian&quot;],[&quot;polish&quot;,&quot;Polish&quot;],[&quot;brazilian&quot;,&quot;Portuguese - Brazil&quot;],[&quot;portuguese&quot;,&quot;Portuguese - Portugal&quot;],[&quot;romanian&quot;,&quot;Romanian&quot;],[&quot;russian&quot;,&quot;Russian&quot;],[&quot;schinese&quot;,&quot;Simplified Chinese&quot;],[&quot;latam&quot;,&quot;Spanish - Latin America&quot;],[&quot;swedish&quot;,&quot;Swedish&quot;],[&quot;thai&quot;,&quot;Thai&quot;],[&quot;tchinese&quot;,&quot;Traditional Chinese&quot;],[&quot;turkish&quot;,&quot;Turkish&quot;],[&quot;ukrainian&quot;,&quot;Ukrainian&quot;],[&quot;vietnamese&quot;,&quot;Vietnamese&quot;]],&quot;value&quot;:[],&quot;strNamePrefix&quot;:&quot;app&quot;,&quot;rgPath&quot;:[&quot;content&quot;,&quot;sections&quot;,0,&quot;content&quot;],&quot;asset_mtime&quot;:0}\"></div>\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t</div>\n\n\t\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t\t<div class=\"sectionDescription\">You can country-restrict this content if you wish for it only to be presented to users in specific countries. The format needs to be a two letter country code separated by commas with no spaces using <a href=\"http://en.wikipedia.org/wiki/ISO_3166-1_alpha-2\" target=\"_blank\">official ISO listings</a>. (Example: \"DE,FR,US,CA,MX\")</div>\n\t\t\t\t\t\t\t\t\t<div class=\"newformrow\">\n\t\t\t\t\t\t\t\t\t\t<div class=\"formlabel\">ONLY:</div>\n\t\t\t\t\t\t\t\t\t\t<div class=\"formdata\"><input type=\"text\" size=\"120\" name=\"app[content][sections][0][allowed_countries]\" value=\"\"></div>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t<div class=\"newformrow\">\n\t\t\t\t\t\t\t\t\t\t<div class=\"formlabel\">NOT:</div>\n\t\t\t\t\t\t\t\t\t\t<div class=\"formdata\"><input type=\"text\" size=\"120\" name=\"app[content][sections][0][restricted_countries]\" value=\"\"></div>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</div>\n\t\t</div>\n\t\t\t</div>\n\n\n\n\t\n\t\n<div class=\"form_footer sticky_save_bar\">\n\t<div><input class=\"btn_green_white_innerfade btn_medium xtra_padding\" type=\"submit\" value=\"Save\"></div>\n</div>\n</div>\n\n<div class=\"tab_content \" id=\"tab_earlyaccess_content\">\n\t<script type=\"text/javascript\" src=\"https://partner.steamgames.com/public/javascript/marketing.js?v=gL5NY0WC6OYI&amp;l=english&amp;_cdn=akamai\"></script>\n<script type=\"text/javascript\" src=\"https://partner.steamgames.com/public/javascript/apps.js?v=JTMAvDwMk1h9&amp;l=english&amp;_cdn=akamai\"></script>\n\n<script type=\"text/javascript\">\n\n\tjQuery(document).ready(function($)\n\t{\n\t\t\t});\n\n\tjQuery( document ).ready( function( $ )\n\t{\n\t\tfunction updateEarlyAccessDateDay( )\n\t\t{\n\t\t\tconst style = $( \"#app_content_earlyaccess_style__entry\" ).val();\n\t\t\tconst $day = $( \"#dates_release_release_from_early_access_date_day__entry\" );\n\t\t\tconst $month = $( \"#dates_release_release_from_early_access_date_month__entry\" );\n\n\t\t\tif ( style !== \"date_full\" )\n\t\t\t{\n\t\t\t\t$day.val( \"1\" ).hide();\n\t\t\t}\n\t\t\telse\n\t\t\t{\n\t\t\t\t$day.show();\n\t\t\t}\n\n\t\t\tif ( style == \"date_year\" )\n\t\t\t{\n\t\t\t\t$month.val( \"1\" ).hide();\n\t\t\t}\n\t\t\telse\n\t\t\t{\n\t\t\t\t$month.show();\n\t\t\t}\n\t\t}\n\n\t\tupdateEarlyAccessDateDay();\n\n\t\t$( \"#app_content_earlyaccess_style__entry\" ).on( \"change\", updateEarlyAccessDateDay );\n\t} );\t\n\n</script>\n\n<div class=\"section\">\n\n\t<div class=\"subsection\">\n\t\t<h2>Early Access</h2>\n\t\t<div class=\"grayRule\"> </div>\n\t\t<p class=\"aldengold\">\n\t\t\tWe like to support and encourage developers who want to ship early, involve customers, and build lasting\n\t\t\t\t\t\t\t\t\t\t\trelationships that help everyone make better games.\t\t</p>\n\t\t<p class=\"aldengold\">\n\t\t\tEarly Access is a place where you can release your game and invite the community to get involved, providing\n\t\t\t\t\t\t\t\t\t\t\tyou with feedback as your game evolves. To release your game as Early Access, you must have something that\n\t\t\t\t\t\t\t\t\t\t\tis playable to provide to customers. In addition to explaining what you wish your product to eventually\n\t\t\t\t\t\t\t\t\t\t\tbecome, it is important to accurately describe the current state of your game so that prospective customers\n\t\t\t\t\t\t\t\t\t\t\tcan make an informed decision about whether this is the right time for them to get involved. Below are\n\t\t\t\t\t\t\t\t\t\t\tquestions that will appear with your answers on your store page during Early Access. All fields below are\n\t\t\t\t\t\t\t\t\t\t\trequired.\t\t</p>\n        <p class=\"aldengold\">\n           To learn more about Early Access, please see the official <a  href=\"https://partner.steamgames.com/doc/store/earlyaccess\" target=\"_blank\">Early Access FAQ</a>.        </p>\n\n\t\t\t\t\t<br>\n\t\t\t\t\t<a id=\"checkbox_rgGenres_70_\" href=\"javascript:ToggleCheckbox('checkbox_rgGenres_70_');\" class=\"fancyCheckbox noformatting\" style=\"\">\n\t\t<input type=\"hidden\" name=\"rgGenres[70]\" value=\"\" onchange=\"OnGenreSelect( this, '70', 'Early Access');\" id=\"checkbox_rgGenres_70__input\" >\n\t\t<img id=\"checkbox_rgGenres_70__unchecked\" src=\"https://partner.steamgames.com/public/images/admin_cb_default.gif\" style=\"\" alt=\"\">\n\t\t<img id=\"checkbox_rgGenres_70__checked\" src=\"https://partner.steamgames.com/public/images/admin_cb_default_checked.gif\" style=\"display: none;\" alt=\"x\">\n\t\t\t\t\t<span class=\"fancyCheckboxLabel\">Early Access\t\t\t\n\t\t\t\t\t\t</span>\n\t\t\t\t</a>\n\t\t&#151; Check this box if you wish for your product to be listed in the Early Access section of Steam. Then be sure to answer all questions below.\t\t\n\t\t\t</div>\n\n            <div class=\"subsection\">\n            <div class=\"newformrow widelabel EarlyAccess\">\n                <div class=\"formlabel\">\n\t\t\t\t\t<div class=\"ea_question\">Why Early Access?</div>\n\t\t\t\t\t</div>\n                <div class=\"formdata\">\n                    <div id=\"app_content_earlyaccess_why__area\" class=\"LocTextArea\"><div class=\"LocTextAreaBar\"><select id=\"app_content_earlyaccess_why__select\" class=\"LocTextAreaLangSelect\" onfocus=\"LocUpdateLangThatHaveText( 'app_content_earlyaccess_why_' )\" onchange=\"OnLocLanguageSelect( 'app_content_earlyaccess_why_' )\"><option id=\"app_content_earlyaccess_why_engli