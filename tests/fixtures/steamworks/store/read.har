t\t</div>\n\t\t\t\t\t\t\t\t\t<div id=\"player_store_preview_category_27\" class=\"game_area_details_specs\">\n\t\t\t\t\t\t<div class=\"icon\">\n\t\t\t\t\t\t\t<img class=\"category_icon\" src=\"https://steamstore-a.akamaihd.net/public/images/v6/ico/ico_multiPlayer.png\">\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class=\"name\">\n\t\t\t\t\t\t\t\t\t\t\t\t\t\tCross-Platform Multiplayer\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</div>\n\t\t</div>\n\t\t<div id=\"feature_section\" class=\"section\">\n\t\t\t<h2>Supported Features</h2>\n\t<div class=\"grayRule\"> </div>\n\t<p>Please select the specific features that are available in your product. If you intend to add a feature in the future, do not select it here until implemented and released.</p>\n\t<div class=\"feature_options_list\">\n\t\n\t\t<div class=\"feature_row\">\n\t\t\t\t\t\t\t\t<a id=\"checkbox_app_classification_category_category_22_\" href=\"javascript:ToggleCheckbox('checkbox_app_classification_category_category_22_');\" class=\"fancyCheckbox noformatting\" style=\"\">\n\t\t<input type=\"hidden\" name=\"app[classification][category][category_22]\" value=\"\" onchange=\"\" id=\"checkbox_app_classification_category_category_22__input\" >\n\t\t<img id=\"checkbox_app_classification_category_category_22__unchecked\" src=\"https://partner.steamgames.com/public/images/admin_cb_default.gif\" style=\"\" alt=\"\">\n\t\t<img id=\"checkbox_app_classification_category_category_22__checked\" src=\"https://partner.steamgames.com/public/images/admin_cb_default_checked.gif\" style=\"display: none;\" alt=\"x\">\n\t\t\t\t\t<span class=\"fancyCheckboxLabel\">Steam Achievements\t\t\t\n\t\t\t\t\t\t</span>\n\t\t\t\t</a>\n\t\t\t\t\t<div class=\"description\">Must first implement and release Steam Achievements. <a target=\"_blank\" href=\"https://partner.steamgames.com/apps/achievements/1000000\">Go to Achievement configuration</a></div>\n\t\t</div>\n\n\t\n\t\t<div class=\"feature_row\">\n\t\t\t\t\t\t\t\t<a id=\"checkbox_app_classification_category_category_23_\" href=\"javascript:ToggleCheckbox('checkbox_app_classification_category_category_23_');\" class=\"fancyCheckbox noformatting\" style=\"\">\n\t\t<input type=\"hidden\" name=\"app[classification][category][category_23]\" value=\"\" onchange=\"\" id=\"checkbox_app_classification_category_category_23__input\" >\n\t\t<img id=\"checkbox_app_classification_category_category_23__unchecked\" src=\"https://partner.steamgames.com/public/images/admin_cb_default.gif\" style=\"\" alt=\"\">\n\t\t<img id=\"checkbox_app_classification_category_category_23__checked\" src=\"https://partner.steamgames.com/public/images/admin_cb_default_checked.gif\" style=\"display: none;\" alt=\"x\">\n\t\t\t\t\t<span class=\"fancyCheckboxLabel\">Steam Cloud\t\t\t\n\t\t\t\t\t\t</span>\n\t\t\t\t</a>\n\t\t\t\t\t<div class=\"description\">Must first enable and test Steam Cloud. <a target=\"_blank\" href=\"https://partner.steamgames.com/apps/cloud/1000000\">Go to Cloud configuration</a></div>\n\t\t</div>\n\n\t\n\t\t<div class=\"feature_row\">\n\t\t\t\t\t\t\t\t<a id=\"checkbox_app_classification_category_category_15_\" href=\"javascript:ToggleCheckbox('checkbox_app_classification_category_category_15_');\" class=\"fancyCheckbox noformatting\" style=\"\">\n\t\t<input type=\"hidden\" name=\"app[classification][category][category_15]\" value=\"\" onchange=\"\" id=\"checkbox_app_classification_category_category_15__input\" >\n\t\t<img id=\"checkbox_app_classification_category_category_15__unchecked\" src=\"https://partner.steamgames.com/public/images/admin_cb_default.gif\" style=\"\" alt=\"\">\n\t\t<img id=\"checkbox_app_classification_category_category_15__checked\" src=\"https://partner.steamgames.com/public/images/admin_cb_default_checked.gif\" style=\"display: none;\" alt=\"x\">\n\t\t\t\t\t<span class=\"fancyCheckboxLabel\">Stats\t\t\t\n\t\t\t\t\t\t</span>\n\t\t\t\t</a>\n\t\t\t\t\t<div class=\"description\">This feature describes games that make use of Steamworks stat reporting. Must be accompanied by configuring Steam Stat Reporting. <a target=\"_blank\" href=\"https://partner.steamgames.com/apps/stats/1000000\">Go to Stat configuration</a></div>\n\t\t</div>\n\n\t\n\t\t<div class=\"feature_row\">\n\t\t\t\t\t\t\t\t<a id=\"checkbox_app_classification_category_category_25_\" href=\"javascript:ToggleCheckbox('checkbox_app_classification_category_category_25_');\" class=\"fancyCheckbox noformatting\" style=\"\">\n\t\t<input type=\"hidden\" name=\"app[classification][category][category_25]\" value=\"\" onchange=\"\" id=\"checkbox_app_classification_category_category_25__input\" >\n\t\t<img id=\"checkbox_app_classification_category_category_25__unchecked\" src=\"https://partner.steamgames.com/public/images/admin_cb_default.gif\" style=\"\" alt=\"\">\n\t\t<img id=\"checkbox_app_classification_category_category_25__checked\" src=\"https://partner.steamgames.com/public/images/admin_cb_default_checked.gif\" style=\"display: none;\" alt=\"x\">\n\t\t\t\t\t<span class=\"fancyCheckboxLabel\">Steam Leaderboards\t\t\t\n\t\t\t\t\t\t</span>\n\t\t\t\t</a>\n\t\t\t\t\t<div class=\"description\">Only select this category if your game is making use of the Steam Leaderboard APIs. <a target=\"_blank\" href=\"https://partner.steamgames.com/apps/leaderboards/1000000\">Go to Leaderboard configuration</a></div>\n\t\t</div>\n\n\t\n\t\t<div class=\"feature_row\">\n\t\t\t\t\t\t\t\t<a id=\"checkbox_app_classification_category_category_35_\" href=\"javascript:ToggleCheckbox('checkbox_app_classification_category_category_35_');\" class=\"fancyCheckbox noformatting\" style=\"\">\n\t\t<input type=\"hidden\" name=\"app[classification][category][category_35]\" value=\"\" onchange=\"\" id=\"checkbox_app_classification_category_category_35__input\" >\n\t\t<img id=\"checkbox_app_classification_category_category_35__unchecked\" src=\"https://partner.steamgames.com/public/images/admin_cb_default.gif\" style=\"\" alt=\"\">\n\t\t<img id=\"checkbox_app_classification_category_category_35__checked\" src=\"https://partner.steamgames.com/public/images/admin_cb_default_checked.gif\" style=\"display: none;\" alt=\"x\">\n\t\t\t\t\t<span class=\"fancyCheckboxLabel\">In-App Purchases\t\t\t\n\t\t\t\t\t\t</span>\n\t\t\t\t</a>\n\t\t\t\t\t<div class=\"description\">You must select this if there is additional content available for purchase within your game that isn't surfaced on the Steam Store. <a target=\"_blank\" href=\"https://partner.steamgames.com/doc/features/microtransactions\">See Microtransation documentation</a></div>\n\t\t</div>\n\n\t\n\t\t<div class=\"feature_row\">\n\t\t\t\t\t\t\t\t<a id=\"checkbox_app_classification_category_category_13_\" href=\"javascript:ToggleCheckbox('checkbox_app_classification_category_category_13_');\" class=\"fancyCheckbox noformatting\" style=\"\">\n\t\t<input type=\"hidden\" name=\"app[classification][category][category_13]\" value=\"\" onchange=\"\" id=\"checkbox_app_classification_category_category_13__input\" >\n\t\t<img id=\"checkbox_app_classification_category_category_13__unchecked\" src=\"https://partner.steamgames.com/public/images/admin_cb_default.gif\" style=\"\" alt=\"\">\n\t\t<img id=\"checkbox_app_classification_category_category_13__checked\" src=\"https://partner.steamgames.com/public/images/admin_cb_default_checked.gif\" style=\"display: none;\" alt=\"x\">\n\t\t\t\t\t<span class=\"fancyCheckboxLabel\">Captions available\t\t\t\n\t\t\t\t\t\t</span>\n\t\t\t\t</a>\n\t\t\t\t\t<div class=\"description\">Captions are intended for hearing impaired, where text shown on screen should include description of noises, music, and sound effects. If your game has subtitles, please indicate that above under 'Supported languages'</div>\n\t\t</div>\n\n\t\n\t\t<div class=\"feature_row\">\n\t\t\t\t\t\t\t\t<a id=\"checkbox_app_classification_category_category_63_\" href=\"javascript:ToggleCheckbox('checkbox_app_classification_category_category_63_');\" class=\"fancyCheckbox noformatting\" style=\"\">\n\t\t<input type=\"hidden\" name=\"app[classification][category][category_63]\" value=\"\" onchange=\"\" id=\"checkbox_app_classification_category_category_63__input\" >\n\t\t<img id=\"checkbox_app_classification_category_category_63__unchecked\" src=\"https://partner.steamgames.com/public/images/admin_cb_default.gif\" style=\"\" alt=\"\">\n\t\t<img id=\"checkbox_app_classification_category_category_63__checked\" src=\"https://partner.steamgames.com/public/images/admin_cb_default_checked.gif\" style=\"display: none;\" alt=\"x\">\n\t\t\t\t\t<span class=\"fancyCheckboxLabel\">Steam Timeline\t\t\t\n\t\t\t\t\t\t</span>\n\t\t\t\t</a>\n\t\t\t\t\t<div class=\"description\">Select this feature if your game makes use of the Timeline Markers APIs. <a target=\"_blank\" href=\"https://partner.steamgames.com/doc/features/timeline\">See Timeline documentation</a></div>\n\t\t</div>\n\n\t\n\t\t<div class=\"feature_row\">\n\t\t\t\t\t\t\t\t<a id=\"checkbox_app_classification_category_category_30_\" href=\"javascript:ToggleCheckbox('checkbox_app_classification_category_category_30_');\" class=\"fancyCheckbox noformatting\" style=\"\">\n\t\t<input type=\"hidden\" name=\"app[classification][category][category_30]\" value=\"\" onchange=\"\" id=\"checkbox_app_classification_category_category_30__input\" >\n\t\t<img id=\"checkbox_app_classification_category_category_30__unchecked\" src=\"https://partner.steamgames.com/public/images/admin_cb_default.gif\" style=\"\" alt=\"\">\n\t\t<img id=\"checkbox_app_classification_category_category_30__checked\" src=\"https://partner.steamgames.com/public/images/admin_cb_default_checked.gif\" style=\"display: none;\" alt=\"x\">\n\t\t\t\t\t<span class=\"fancyCheckboxLabel\">Steam Workshop\t\t\t\n\t\t\t\t\t\t</span>\n\t\t\t\t</a>\n\t\t\t\t\t<div class=\"description\">Must first configure Steam Workshop for your game and make use of Steam Workshop APIs to share user-generated content. <a target=\"_blank\" href=\"https://partner.steamgames.com/apps/workshop/1000000\">Go to Workshop configuration</a></div>\n\t\t</div>\n\n\t\n\t\t<div class=\"feature_row\">\n\t\t\t\t\t\t\t\t<a id=\"checkbox_app_classification_category_category_51_\" href=\"javascript:ToggleCheckbox('checkbox_app_classification_category_category_51_');\" class=\"fancyCheckbox noformatting\" style=\"\">\n\t\t<input type=\"hidden\" name=\"app[classification][category][category_51]\" value=\"\" onchange=\"\" id=\"checkbox_app_classification_category_category_51__input\" >\n\t\t<img id=\"checkbox_app_classification_category_category_51__unchecked\" src=\"https://partner.steamgames.com/public/images/admin_cb_default.gif\" style=\"\" alt=\"\">\n\t\t<img id=\"checkbox_app_classification_category_category_51__checked\" src=\"https://partner.steamgames.com/public/images/admin_cb_default_checked.gif\" style=\"display: none;\" alt=\"x\">\n\t\t\t\t\t<span class=\"fancyCheckboxLabel\">Steam Workshop (for Steam China)\t\t\t\n\t\t\t\t\t\t</span>\n\t\t\t\t</a>\n\t\t\t\t\t<div class=\"description\">Only for games distributed via Steam China and making use of that version of Steam Workshop. <a target=\"_blank\" href=\"https://partner.steamgames.com/apps/workshop/1000000\">Go to Workshop configuration</a></div>\n\t\t</div>\n\n\t\n\t\t<div class=\"feature_row\">\n\t\t\t\t\t\t\t\t<a id=\"checkbox_app_classification_category_category_17_\" href=\"javascript:ToggleCheckbox('checkbox_app_classification_category_category_17_');\" class=\"fancyCheckbox noformatting\" style=\"\">\n\t\t<input type=\"hidden\" name=\"app[classification][category][category_17]\" value=\"\" onchange=\"\" id=\"checkbox_app_classification_category_category_17__input\" >\n\t\t<img id=\"checkbox_app_classification_category_category_17__unchecked\" src=\"https://partner.steamgames.com/public/images/admin_cb_default.gif\" style=\"\" alt=\"\">\n\t\t<img id=\"checkbox_app_classification_category_category_17__checked\" src=\"https://partner.steamgames.com/public/images/admin_cb_default_checked.gif\" style=\"display: none;\" alt=\"x\">\n\t\t\t\t\t<span class=\"fancyCheckboxLabel\">Includes level editor\t\t\t\n\t\t\t\t\t\t</span>\n\t\t\t\t</a>\n\t\t\t\t\t<div class=\"description\">You can select this category if your game includes a level editor for players to create or modify levels for the game. It can be part of your game, or provided as a 'tool' app as a separate install.</div>\n\t\t</div>\n\n\t\n\t\t<div class=\"feature_row\">\n\t\t\t\t\t\t\t\t<a id=\"checkbox_app_classification_category_category_41_\" href=\"javascript:ToggleCheckbox('checkbox_app_classification_category_category_41_');\" class=\"fancyCheckbox noformatting\" style=\"opacity: 0.25\">\n\t\t<input type=\"hidden\" name=\"app[classification][category][category_41]\" value=\"\" onchange=\"\" id=\"checkbox_app_classification_category_category_41__input\" disabled=\"\">\n\t\t<img id=\"checkbox_app_classification_category_category_41__unchecked\" src=\"https://partner.steamgames.com/public/images/admin_cb_default.gif\" style=\"\" alt=\"\">\n\t\t<img id=\"checkbox_app_classification_category_category_41__checked\" src=\"https://partner.steamgames.com/public/images/admin_cb_default_checked.gif\" style=\"display: none;\" alt=\"x\">\n\t\t\t\t\t<span class=\"fancyCheckboxLabel\"><font color=\"white\">Remote Play on Phone</font>\t\t\t\n\t\t\t\t\t\t</span>\n\t\t\t\t</a>\n\t\t\t\t\t<div class=\"description\">Setting this feature means that you have tested streaming your game to a phone, you have set up a touch controller config for Steam Input, and you use large fonts and UI elements suitable for a small screen. <a target=\"_blank\" href=\"https://partner.steamgames.com/doc/features/remoteplay\">See documentation</a></div>\n\t\t</div>\n\n\t\n\t\t<div class=\"feature_row\">\n\t\t\t\t\t\t\t\t<a id=\"checkbox_app_classification_category_category_42_\" href=\"javascript:ToggleCheckbox('checkbox_app_classification_category_category_42_');\" class=\"fancyCheckbox noformatting\" style=\"opacity: 0.25\">\n\t\t<input type=\"hidden\" name=\"app[classification][category][category_42]\" value=\"\" onchange=\"\" id=\"checkbox_app_classification_category_category_42__input\" disabled=\"\">\n\t\t<img id=\"checkbox_app_classification_category_category_42__unchecked\" src=\"https://partner.steamgames.com/public/images/admin_cb_default.gif\" style=\"\" alt=\"\">\n\t\t<img id=\"checkbox_app_classification_category_category_42__checked\" src=\"https://partner.steamgames.com/public/images/admin_cb_default_checked.gif\" style=\"display: none;\" alt=\"x\">\n\t\t\t\t\t<span class=\"fancyCheckboxLabel\"><font color=\"white\">Remote Play on Tablet</font>\t\t\t\n\t\t\t\t\t\t</span>\n\t\t\t\t</a>\n\t\t\t\t\t<div class=\"description\">Setting this feature means that you have tested streaming your game to a tablet, and you have set up a touch controller config for Steam Input. <a target=\"_blank\" href=\"https://partner.steamgames.com/doc/features/remoteplay\">See documentation</a></div>\n\t\t</div>\n\n\t\n\t\t<div class=\"feature_row\">\n\t\t\t\t\t\t\t\t<a id=\"checkbox_app_classification_category_category_43_\" href=\"javascript:ToggleCheckbox('checkbox_app_classification_category_category_43_');\" class=\"fancyCheckbox noformatting\" style=\"opacity: 0.25\">\n\t\t<input type=\"hidden\" name=\"app[classification][category][category_43]\" value=\"\" onchange=\"\" id=\"checkbox_app_classification_category_category_43__input\" disabled=\"\">\n\t\t<img id=\"checkbox_app_classification_category_category_43__unchecked\" src=\"https://partner.steamgames.com/public/images/admin_cb_default.gif\" style=\"\" alt=\"\">\n\t\t<img id=\"checkbox_app_classification_category_category_43__checked\" src=\"https://partner.steamgames.com/public/images/admin_cb_default_checked.gif\" style=\"display: none;\" alt=\"x\">\n\t\t\t\t\t<span class=\"fancyCheckboxLabel\"><font color=\"white\">Remote Play on TV</font>\t\t\t\n\t\t\t\t\t\t</span>\n\t\t\t\t</a>\n\t\t\t\t\t<div class=\"description\">Setting this feature means that you have tested streaming your game to a TV, your application has full controller support, and you use large fonts and UI elements suitable for viewing at a distance on a TV. <a target=\"_blank\" href=\"https://partner.steamgames.com/doc/features/remoteplay\">See documentation</a></div>\n\t\t</div>\n\n\t\n\t\t<div class=\"feature_row\">\n\t\t\t\t\t\t\t\t<a id=\"checkbox_app_classification_category_category_44_\" href=\"javascript:ToggleCheckbox('checkbox_app_classification_category_category_44_');\" class=\"fancyCheckbox noformatting\" style=\"\">\n\t\t<input type=\"hidden\" name=\"app[classification][category][category_44]\" value=\"\" onchange=\"\" id=\"checkbox_app_classification_category_category_44__input\" >\n\t\t<img id=\"checkbox_app_classification_category_category_44__unchecked\" src=\"https://partner.steamgames.com/public/images/admin_cb_default.gif\" style=\"\" alt=\"\">\n\t\t<img id=\"checkbox_app_classification_category_category_44__checked\" src=\"https://partner.steamgames.com/public/images/admin_cb_default_checked.gif\" style=\"display: none;\" alt=\"x\">\n\t\t\t\t\t<span class=\"fancyCheckboxLabel\">Remote Play Together\t\t\t\n\t\t\t\t\t\t</span>\n\t\t\t\t</a>\n\t\t\t\t\t<div class=\"description\">Setting this feature means that your game allows players to invite their Steam friends to play with them via streaming. One instance of the game runs on the host machine while other friends connect their controllers and view the game through the Internet. <a target=\"_blank\" href=\"https://partner.steamgames.com/doc/features/remoteplay\">See documentation</a></div>\n\t\t</div>\n\n\t\n\t\t<div class=\"feature_row\">\n\t\t\t\t\t\t\t\t<a id=\"checkbox_app_classification_category_category_61_\" href=\"javascript:ToggleCheckbox('checkbox_app_classification_category_category_61_');\" class=\"fancyCheckbox noformatting\" style=\"\">\n\t\t<input type=\"hidden\" name=\"app[classification][category][category_61]\" value=\"\" onchange=\"\" id=\"checkbox_app_classification_category_category_61__input\" >\n\t\t<img id=\"checkbox_app_classification_category_category_61__unchecked\" src=\"https://partner.steamgames.com/public/images/admin_cb_default.gif\" style=\"\" alt=\"\">\n\t\t<img id=\"checkbox_app_classification_category_category_61__checked\" src=\"https://partner.steamgames.com/public/images/admin_cb_default_checked.gif\" style=\"display: none;\" alt=\"x\">\n\t\t\t\t\t<span class=\"fancyCheckboxLabel\">HDR available\t\t\t\n\t\t\t\t\t\t</span>\n\t\t\t\t</a>\n\t\t\t\t\t<div class=\"description\">Setting this feature means that your game supports HDR output (HDR10 (PQ)/scRGB) to supported HDR displays. Games that render internally as HDR and tonemap to SDR should not set this.</div>\n\t\t</div>\n\n\t\n\t\t<div class=\"feature_row\">\n\t\t\t\t\t\t\t\t<a id=\"checkbox_app_classification_category_category_32_\" href=\"javascript:ToggleCheckbox('checkbox_app_classification_category_category_32_');\" class=\"fancyCheckbox noformatting\" style=\"\">\n\t\t<input type=\"hidden\" name=\"app[classification][category][category_32]\" value=\"\" onchange=\"\" id=\"checkbox_app_classification_category_category_32__input\" >\n\t\t<img id=\"checkbox_app_classification_category_category_32__unchecked\" src=\"https://partner.steamgames.com/public/images/admin_cb_default.gif\" style=\"\" alt=\"\">\n\t\t<img id=\"checkbox_app_classification_category_category_32__checked\" src=\"https://partner.steamgames.com/public/images/admin_cb_default_checked.gif\" style=\"display: none;\" alt=\"x\">\n\t\t\t\t\t<span class=\"fancyCheckboxLabel\">Steam Turn Notifications\t\t\t\n\t\t\t\t\t\t</span>\n\t\t\t\t</a>\n\t\t\t\t\t<div class=\"description\">Only select this category if your game is making use of the Steam Turn Notification APIs. <a target=\"_blank\" href=\"https://partner.steamgames.com/doc/features/game_notifications\">See Notification documentation</a></div>\n\t\t</div>\n\n\t\n\t\t<div class=\"feature_row\">\n\t\t\t\t\t\t\t\t<a id=\"checkbox_app_classification_category_category_14_\" href=\"javascript:ToggleCheckbox('checkbox_app_classification_category_category_14_');\" class=\"fancyCheckbox noformatting\" style=\"\">\n\t\t<input type=\"hidden\" name=\"app[classification][category][category_14]\" value=\"\" onchange=\"\" id=\"checkbox_app_classification_category_category_14__input\" >\n\t\t<img id=\"checkbox_app_classification_category_category_14__unchecked\" src=\"https://partner.steamgames.com/public/images/admin_cb_default.gif\" style=\"\" alt=\"\">\n\t\t<img id=\"checkbox_app_classification_category_category_14__checked\" src=\"https://partner.steamgames.com/public/images/admin_cb_default_checked.gif\" style=\"display: none;\" alt=\"x\">\n\t\t\t\t\t<span class=\"fancyCheckboxLabel\">Commentary available\t\t\t\n\t\t\t\t\t\t</span>\n\t\t\t\t</a>\n\t\t\t\t\t<div class=\"description\">This feature is intended to communicate when your game offers a special mode for players to discover developer commentary within the game.</div>\n\t\t</div>\n\n\t\n\t\t<div class=\"feature_row\">\n\t\t\t\t\t\t\t\t<a id=\"checkbox_app_classification_category_category_16_\" href=\"javascript:ToggleCheckbox('checkbox_app_classification_category_category_16_');\" class=\"fancyCheckbox noformatting\" style=\"\">\n\t\t<input type=\"hidden\" name=\"app[classification][category][category_16]\" value=\"\" onchange=\"\" id=\"checkbox_app_classification_category_category_16__input\" >\n\t\t<img id=\"checkbox_app_classification_category_category_16__unchecked\" src=\"https://partner.steamgames.com/public/images/admin_cb_default.gif\" style=\"\" alt=\"\">\n\t\t<img id=\"checkbox_app_classification_category_category_16__checked\" src=\"https://partner.steamgames.com/public/images/admin_cb_default_checked.gif\" style=\"display: none;\" alt=\"x\">\n\t\t\t\t\t<span class=\"fancyCheckboxLabel\">Includes Source SDK\t\t\t\n\t\t\t\t\t\t</span>\n\t\t\t\t</a>\n\t\t\t\t\t<div class=\"description\">This category only applies to games that are built on Valve's Source Engine.</div>\n\t\t</div>\n\n\t\t</div>\n\t\t<p><br></p>\n\t\t</div>\n\t\n\t\t\t\t\t\t<div class=\"section\" id=\"genre_form\">\n            <a name=\"genre_form\"></a>\n\t\t\t<h2>Genres<span class=\"required\">*</span></h2>\n\t\t\t<div class=\"grayRule\"></div>\n\n            \n                \n                    \n                    <div class=\"newformrow\">\n                        <div class=\"formlabel\">Primary Genre:</div>\n                        <div class=\"formdata\">\n                                                        <select id=\"primary_genre_select\" name=\"app[classification][primary_genre]\" >\n                                <option value=\"\">&nbsp;</option>\n                                                            </select>\n                            &nbsp;(Primary genre is used in the display of the navigation breadcrumbs, just above your product title at the top of your store page)                        </div>\n                    </div>\n                \n                <input type=\"hidden\" name=\"rgGenres[sentinel]\" value=\"1\">\n                <div id=\"genres_game\" style=\"display: block; \">\n                                                <div style=\"clear: both;\"></div>\n                                                <div class=\"checkboxGrid\" style=\"display: block;\">\n                            \t\t<a id=\"checkbox_rgGenres_1_\" href=\"javascript:ToggleCheckbox('checkbox_rgGenres_1_');\" class=\"fancyCheckbox noformatting\" style=\"\">\n\t\t<input type=\"hidden\" name=\"rgGenres[1]\" value=\"\" onchange=\"OnGenreSelect( this, '1', 'Action');\" id=\"checkbox_rgGenres_1__input\" >\n\t\t<img id=\"checkbox_rgGenres_1__unchecked\" src=\"https://partner.steamgames.com/public/images/admin_cb_default.gif\" style=\"\" alt=\"\">\n\t\t<img id=\"checkbox_rgGenres_1__checked\" src=\"https://partner.steamgames.com/public/images/admin_cb_default_checked.gif\" style=\"display: none;\" alt=\"x\">\n\t\t\t\t\t<span class=\"fancyCheckboxLabel\">Action\t\t\t\n\t\t\t\t\t\t</span>\n\t\t\t\t</a>\n\t\t                        </div>\n                                            <div class=\"checkboxGrid\" style=\"display: block;\">\n                            \t\t<a id=\"checkbox_rgGenres_25_\" href=\"javascript:ToggleCheckbox('checkbox_rgGenres_25_');\" class=\"fancyCheckbox noformatting\" style=\"\">\n\t\t<input type=\"hidden\" name=\"rgGenres[25]\" value=\"\" onchange=\"OnGenreSelect( this, '25', 'Adventure');\" id=\"checkbox_rgGenres_25__input\" >\n\t\t<img id=\"checkbox_rgGenres_25__unchecked\" src=\"https://partner.steamgames.com/public/images/admin_cb_default.gif\" style=\"\" alt=\"\">\n\t\t<img id=\"checkbox_rgGenres_25__checked\" src=\"https://partner.steamgames.com/public/images/admin_cb_default_checked.gif\" style=\"display: none;\" alt=\"x\">\n\t\t\t\t\t<span class=\"fancyCheckboxLabel\">Adventure\t\t\t\n\t\t\t\t\t\t</span>\n\t\t\t\t</a>\n\t\t                        </div>\n                                            <div class=\"checkboxGrid\" style=\"display: block;\">\n                            \t\t<a id=\"checkbox_rgGenres_4_\" href=\"javascript:ToggleCheckbox('checkbox_rgGenres_4_');\" class=\"fancyCheckbox noformatting\" style=\"\">\n\t\t<input type=\"hidden\" name=\"rgGenres[4]\" value=\"\" onchange=\"OnGenreSelect( this, '4', 'Casual');\" id=\"checkbox_rgGenres_4__input\" >\n\t\t<img id=\"checkbox_rgGenres_4__unchecked\" src=\"https://partner.steamgames.com/public/images/admin_cb_default.gif\" style=\"\" alt=\"\">\n\t\t<img id=\"checkbox_rgGenres_4__checked\" src=\"https://partner.steamgames.com/public/images/admin_cb_default_checked.gif\" style=\"display: none;\" alt=\"x\">\n\t\t\t\t\t<span class=\"fancyCheckboxLabel\">Casual\t\t\t\n\t\t\t\t\t\t</span>\n\t\t\t\t</a>\n\t\t                        </div>\n                                            <div class=\"checkboxGrid\" style=\"display: block;\">\n                            \t\t<a id=\"checkbox_rgGenres_23_\" href=\"javascript:T