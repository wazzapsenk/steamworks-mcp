;/li&gt;&lt;li&gt;OpenXR on SteamVR with Index, WMR headsets, and Meta Quest 2; or OpenXR on Meta with Meta Quest 2.&lt;/li&gt;&lt;/ul&gt;\n\t\t\t\t\t\t&lt;/div&gt;\" >(?)\n\t\t\t\t\t</span>\n\t\t\t\t\t<a href=\"https://partner.steamgames.com/doc/features/steamvr/settings\" target=\"_blank\">See documentation</a>\n\t\t\t\t</div>\n\t\t\t\t<!-- <div class=\"SysReqRowDescription\">#StoreAdmin_Basic_SysReqs_VRSupport_Desc</div> -->\n\t\t\t\t<div id=\"app_content_sysreqs_linux_min_vrsupport__area\" class=\"LocTextArea\"><input type=\"text\" id=\"app_content_sysreqs_linux_min_vrsupport__textarea\" onchange=\"OnLocTextChanged( 'app_content_sysreqs_linux_min_vrsupport_' )\"><input type=\"hidden\" id=\"app_content_sysreqs_linux_min_vrsupport__currentlanguage\"><input type=\"hidden\" id=\"app_content_sysreqs_linux_min_vrsupport_english__hidden\" name=\"app[content][sysreqs][linux][min][vrsupport][english]\" value=\"\" lang=\"en\"><input type=\"hidden\" id=\"app_content_sysreqs_linux_min_vrsupport_french__hidden\" name=\"app[content][sysreqs][linux][min][vrsupport][french]\" value=\"\" lang=\"fr\"><input type=\"hidden\" id=\"app_content_sysreqs_linux_min_vrsupport_italian__hidden\" name=\"app[content][sysreqs][linux][min][vrsupport][italian]\" value=\"\" lang=\"it\"><input type=\"hidden\" id=\"app_content_sysreqs_linux_min_vrsupport_german__hidden\" name=\"app[content][sysreqs][linux][min][vrsupport][german]\" value=\"\" lang=\"de\"><input type=\"hidden\" id=\"app_content_sysreqs_linux_min_vrsupport_spanish__hidden\" name=\"app[content][sysreqs][linux][min][vrsupport][spanish]\" value=\"\" lang=\"es\"><input type=\"hidden\" id=\"app_content_sysreqs_linux_min_vrsupport_bulgarian__hidden\" name=\"app[content][sysreqs][linux][min][vrsupport][bulgarian]\" value=\"\" lang=\"bg\"><input type=\"hidden\" id=\"app_content_sysreqs_linux_min_vrsupport_czech__hidden\" name=\"app[content][sysreqs][linux][min][vrsupport][czech]\" value=\"\" lang=\"cs\"><input type=\"hidden\" id=\"app_conten