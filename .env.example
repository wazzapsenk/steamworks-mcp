# Copy to .env (never commit .env). Every value is optional.

# Folder that holds your game projects; tools refuse paths outside it (default: the current folder).
STEAMWORKS_MCP_ROOT=

# Steamworks publisher Web API key (Users & Permissions > Manage Groups > Web API key). Used by the API mode.
STEAMWORKS_PUBLISHER_KEY=
# A regular Steam Web API key (steamcommunity.com/dev/apikey): adds hidden-achievement data for reference games.
STEAM_WEB_API_KEY=
# Full path to steamcmd, for build uploads.
STEAMCMD_PATH=
# The restricted builder account steamcmd logs in with. Log in once yourself (steamcmd +login <name>) so steamcmd
# keeps the session; the password and Steam Guard code never go into this file or through this server.
STEAMCMD_USERNAME=

# Opt-in BROWSER mode: drives the Steamworks site in a browser window you log into yourself. Read the README first.
STEAM_MCP_BROWSER=0

# HTTP transport (steamworks-mcp --http): bearer token of 24+ characters, e.g. `openssl rand -hex 24`.
STEAMWORKS_MCP_TOKEN=
# Comma-separated Host / Origin values to accept besides localhost (e.g. a tunnel hostname, a web client origin).
STEAMWORKS_MCP_ALLOWED_HOSTS=
STEAMWORKS_MCP_ALLOWED_ORIGINS=
# Allow BROWSER mode while serving over HTTP (off unless you really need it).
STEAM_MCP_BROWSER_REMOTE=0

# Where reference-game data is cached (default ~/.steamworks-mcp/cache).
STEAMWORKS_MCP_CACHE=
# Per-user folder for the BROWSER-mode consent and browser profile (default ~/.steamworks-mcp).
STEAMWORKS_MCP_HOME=

# Only for re-recording Steamworks fixtures (legacy/ts/scripts/live): comma-separated private terms (account name,
# e-mail, studio and app names, local paths) that must never appear in committed files.
SANITIZE_DENYLIST=
