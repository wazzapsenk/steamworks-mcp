_android_min_broadband__checked\" src=\"https://partner.steamgames.com/public/images/admin_cb_default_checked.gif\" style=\"display: none;\" alt=\"x\">\n\t\t\t\t\t<span class=\"fancyCheckboxLabel\">Broadband internet connection\t\t\t\n\t\t\t\t\t\t</span>\n\t\t\t\t</a>\n\t\t\t\t</div>\n\t\t\t\n\t\t\t<div class=\"SysReqRow Game\">\n\t\t\t<span class=\"SysReqRowLabel\">Disk Space:</span>\n\t\t\t<div style=\"display: inline-block\">\n\t\t\t\t<input style=\"width:60px;\" onkeypress=\"return IsNumberKey( event )\" name=\"app[content][sysreqs][android][min][diskspace][amount]\" value=\"\">\n\t\t\t\t<select style=\"width:50px;\" name=\"app[content][sysreqs][android][min][diskspace][units]\">\n\t\t\t\t\t<option value=\"MB\" selected >MB</option>\n\t\t\t\t\t<option value=\"GB\"  >GB</option>\n\t\t\t\t</select>\n\t\t\t</div>\n\t\t</div>\n\n\t\t\t\n\t\t\t\n\t\t\t\t\t<div class=\"SysReqRow Game\">\n\t\t\t\t<div class=\"SysReqRowLabel wide\">VR Devices and Support:\t\t\t\t\t<span class=\"SysReqLargeTooltip tooltip\"  data-tooltip-html=\"&lt;div class=&quot;SysReqLargeTooltipContent&quot;&gt;\n\t\t\t\t\t\t&lt;div&gt;Describe both the SDKs your game supports, as well as supported hardware. Examples:&lt;/div&gt;&lt;ul&gt;&lt;li&gt;OpenXR, requires motion controllers&lt;/li&gt;&lt;li&gt;SteamVR. Oculus Touch/Valve Index controllers or better&lt;/li&gt;&lt;li&gt;SteamVR. Meta headsets and Valve Index only&lt;/li&gt;&lt;li&gt;OpenXR. HTC Vive Cosmos, HTC Vive, Oculus CV1, Meta Quest 2, and Oculus Rift S&lt;/li&gt;&lt;li&gt;OpenXR on SteamVR with Index, WMR headsets, and Meta Quest 2; or OpenXR on Meta with Meta Quest 2.&lt;/li&gt;&lt;/ul&gt;\n\t\t\t\t\t\t&lt;/div&gt;\" >(?)\n\t\t\t\t\t</span>\n\t\t\t\t\t<a href=\"https://partner.steamgames.com/doc/features/steamvr/settings\" target=\"_blank\">See documentation</a>\n\t\t\t\t</div>\n\t\t\t\t<!-- <div class=\"SysReqRowDescription\">#StoreAdmin_Basic_SysReqs_VRSupport_Desc</div> -->\n\t\t\t\t<div id=\"app_content_sysreqs_android_min_vrsupp