avascript:FollowTransferLink1(); return false;\">Preview changes in store</a>\n\t\t\t\t\t<div style=\"clear:both\"></div>\n</div>\n\n<div class=\"tabbar\">\n\t\t\t<div class=\"tab activetab\" id=\"tab_basic\" onclick=\"TabSelect(this)\">\n\t\t\tBasic Info\t\t</div>\n\t\t\t\t<div class=\"tab \" id=\"tab_description\" onclick=\"TabSelect(this)\">\n\t\t\tDescription\t\t</div>\n\t\t\t\t<div class=\"tab \" id=\"tab_ratings\" onclick=\"TabSelect(this)\">\n\t\t\tRatings\t\t</div>\n\t\t\t\t<div class=\"tab \" id=\"tab_earlyaccess\" onclick=\"TabSelect(this)\">\n\t\t\tEarly Access\t\t</div>\n\t\t\t\t<div class=\"tab \" id=\"tab_graphicalassets\" onclick=\"TabSelect(this)\">\n\t\t\tGraphical Assets\t\t</div>\n\t\t\t\t<div class=\"tab \" id=\"tab_movies\" onclick=\"TabSelect(this)\">\n\t\t\tTrailers\t\t</div>\n\t\t\t\t<div class=\"tab \" id=\"tab_specialsettings\" onclick=\"TabSelect(this)\">\n\t\t\tSpecial Settings\t\t</div>\n\t\t\t\t<div class=\"tab \" id=\"tab_localization\" onclick=\"TabSelect(this)\">\n\t\t\tLocalization\t\t</div>\n\t\t\t\t<div class=\"tab \" id=\"tab_publish\" onclick=\"TabSelect(this)\">\n\t\t\tPublish\t\t</div>\n\t\t\t&nbsp; \t<div style=\"clear: both;\" ></div>\n</div>\n\n<form method=\"post\" enctype=\"multipart/form-data\" id=\"gameform\" action=\"https://partner.steamgames.com/admin/game/save/2000000\">\n<input type=\"hidden\" name=\"sessionid\" value=\"ffffffffffffffffffff0001\" /><input type=\"hidden\" name=\"MAX_FILE_SIZE\" value=\"268435456\" >\n<input type=\"hidden\" id=\"activetab\" name=\"activetab\" value=\"tab_basic\" >\n<input type=\"hidden\" id=\"save_redirect\" name=\"save_redirect\" value=\"edit\">\n<input type=\"hidden\" name=\"serialized_app_data\" value=\"{&quot;visibility&quot;:{&quot;visible&quot;:&quot;1&quot;},&quot;itemid&quot;:&quot;2000000&quot;,&quot;legacy_appid&quot;:&quot;1000000&quot;,&quot;appid&quot;:&quot;1000000&quot;,&quot;name&quot;:&quot;ExampleGame&quot;,&quot;type&quot;:&quot;Game&quot;,&quot;publisherid&quot;:&quot;0&quot;,&quot;content&quot;:{&quot;sysreqs&quot;:{&quot;windows&quot;:{&quot;min&quot;:[],&quot;rec&quot;:[]},&quot;mac&quot;:{&quot;min&quot;:[],&quot;rec&quot;:[]},&quot;linux&quot;:{&quot;min&quot;:[],&quot;rec&quot;:[]},&quot;android&quot;:{&quot;min&quot;:[],&quot;rec&quot;:[]}},&quot;about&quot;:{&quot;english&quot;:&quot;[p]steamworks-mcp test: About This Game placeholder.[\\/p]&quot;,&quot;turkish&quot;:&quot;[turkish text removed]&quot;,&quot;german&quot;:&quot;steamworks-mcp-Test (2): Platzhalter f\\u00fcr \\u201e\\u00dcber dieses Spiel\\u201c.&quot;},&quot;short_description&quot;:{&quot;english&quot;:&quot;[steamworks-mcp test] ExampleGame is a fast arcade shooter where every shot ricochets. Bank shots off walls, chain combos across the arena and climb the daily leaderboards. Placeholder text written by an automated test.&quot;,&quot;turkish&quot;:&quot;[turkish text removed]&quot;,&quot;german&quot;:&quot;[steamworks-mcp test] ExampleGame ist ein schneller Arcade-Shooter, in dem jeder Schuss abprallt. Spiele Bandensch\\u00fcsse \\u00fcber die W\\u00e4nde, verkette Combos in der Arena und erklimme die t\\u00e4glichen Bestenlisten. Platzhaltertext eines automatisierten Tests.&quot;}},&quot;platforms&quot;:{&quot;win&quot;:&quot;1&quot;},&quot;assets&quot;:[],&quot;broadcast&quot;:{&quot;sidepanel_template&quot;:&quot;0&quot;,&quot;chat_visibility&quot;:&quot;hide&quot;,&quot;title_choice&quot;:&quot;1&quot;}}\">\n<div id=\"all_tab_contents\">\n\n\n\n<div class=\"tab_content active_content\" id=\"tab_basic_content\">\n\t\n<script type=\"text/javascript\" src=\"https://partner.steamgames.com/public/javascript/marketing.js?v=gL5NY0WC6OYI&amp;l=english&amp;_cdn=akamai\"></script>\n\n<script type=\"text/javascript\">\n\n\t$J( document ).ready( function() {\n\t\tvar sectionToHide = $( 'detailedSoundtrackConversionSection' );\n\t\tif ( sectionToHide ) {\n\t\t    sectionToHide.hide();\n        }\n\t} );\n\n\tfunction OnAttemptedAutoCompleteForDeveloperOrPublisher( element, entry )\n\t{\n\t\t// we want to stomp the value no matter what, so we can add new developers or publishers\n\t\tvar id = element.id;\n\t\tvar idx = id.indexOf( \"__compl\" );\n\t\tvar id = id.substring( 0, idx );\n\t\tvar realElem = $( id + \"__target\" );\n\t\trealElem.value = element.value;\n\t\treturn entry;\n\t}\n\n\tfunction OnPlatformChanged( strPlat )\n\t{\n\t\tvar box = $( 'checkbox_app_platforms_' + strPlat + '__input' );\n\n\t\tvar platSection = null;\n\t\tif ( strPlat == 'win' )\n\t\t\tplatSection = $( 'WindowsSysReqs' );\n\t\telse if ( strPlat == 'mac' )\n\t\t\tplatSection = $( 'MacSysReqs' );\n\t\telse if ( strPlat == 'linux' )\n\t\t\tplatSection = $( 'LinuxSysReqs' );\n\t\telse if ( strPlat == 'android' )\n\t\t\tplatSection = $( 'AndroidSysReqs' );\n\n\t\tif ( box.value )\n\t\t\tplatSection.show();\n\t\telse\n\t\t\tplatSection.hide();\n\n\t\t// set HR visibility too\n\t\tif ( $( 'WindowsSysReqs' ).visible() && $( 'MacSysReqs' ).visible() )\n\t\t\t$( 'HRAboveMacSysReq').show();\n\t\telse\n\t\t\t$( 'HRAboveMacSysReq').hide();\n\n\t\tif ( ($( 'WindowsSysReqs' ).visible() || $( 'MacSysReqs' ).visible()) && $( 'LinuxSysReqs' ).visible() )\n\t\t\t$( 'HRAboveLinuxSysReq').show();\n\t\telse\n\t\t\t$( 'HRAboveLinuxSysReq').hide();\n\n\t\tif ( ($( 'WindowsSysReqs' ).visible() || $( 'MacSysReqs' ).visible() || $( 'LinuxSysReqs' ).visible()) && $( 'AndroidSysReqs' ).visible() )\n\t\t\t$( 'HRAboveAndroidSysReq').show();\n\t\telse\n\t\t\t$( 'HRAboveAndroidSysReq').hide();\n\t}\n\n\tfunction OnShowSysReqsChanged()\n\t{\n\t\tvar box = $( 'checkbox_app_content_sysreqs_showalways__input' );\n\t\tvar sysreqSection = $( 'SysReqWrapper' );\n\t\tif ( box.value )\n\t\t\tsysreqSection.show();\n\t\telse\n\t\t\tsysreqSection.hide();\n\n\t\tOnPlatformChanged( 'win' );\n\t\tOnPlatformChanged( 'mac' );\n\t\tOnPlatformChanged( 'linux' );\n\t}\n\n\tfunction GetCategoryCheckboxState( category )\n\t{\n\t\treturn GetFancyCheckboxState( 'checkbox_app_classification_category_' + category + '_' );\n\t}\n\n\tfunction SetCategoryCheckboxState( category, bChecked )\n\t{\n\t\tSetFancyCheckboxState( 'checkbox_app_classification_category_' + category + '_', bChecked );\n\t}\n\n\tfunction SetCategoryCheckboxEnabled( category, bEnabled )\n\t{\n\t\tvar opacity = ( bEnabled ? 1.0 : 0.25 );\n\t\t$J( 'checkbox_app_classification_category_' + category + '_' ).css({ opacity: opacity });\n\t}\n\n\tfunction SynchronizeCategoryCheckbox( category, value, bDisableWhenUnchecked )\n\t{\n\t\tSetCategoryCheckboxState( category, value );\n\n\t\tif ( bDisableWhenUnchecked )\n\t\t{\n\t\t\tSetCategoryCheckboxEnabled( category, value );\n\t\t}\n\t}\n\n\tvar bInitializingPlayerWizard = false;\n\n\tfunction SetupPlayerWizard()\n\t{\n\t\tbInitializingPlayerWizard = true;\n\n\t\t// Fix some categories that may have been missed by old data entry\n\t\tvar bPvP = GetCategoryCheckboxState( 'category_49' );\n\t\tif ( !bPvP )\n\t\t{\n\t\t\tbPvP = GetCategoryCheckboxState( 'category_36' ) ||\n\t\t\t\tGetCategoryCheckboxState( 'category_47' ) ||\n\t\t\t\tGetCategoryCheckboxState( 'category_37' );\n\t\t\tSetCategoryCheckboxState( 'category_49', bPvP );\n\t\t}\n\n\t\tvar bCoop = GetCategoryCheckboxState( 'category_9' );\n\t\tif ( !bCoop )\n\t\t{\n\t\t\tbCoop = GetCategoryCheckboxState( 'category_38' ) ||\n\t\t\t\tGetCategoryCheckboxState( 'category_48' ) ||\n\t\t\t\tGetCategoryCheckboxState( 'category_39' );\n\t\t\tSetCategoryCheckboxState( 'category_9', bCoop );\n\t\t}\n\n\t\tvar bMultiplayer = GetCategoryCheckboxState( 'category_1' );\n\t\tif ( !bMultiplayer )\n\t\t{\n\t\t\tbMultiplayer = GetCategoryCheckboxState( 'category_20' ) ||\n\t\t\t\tGetCategoryCheckboxState( 'category_49' ) ||\n\t\t\t\tGetCategoryCheckboxState( 'category_9' ) ||\n\t\t\t\tGetCategoryCheckboxState( 'category_24' );\n\t\t\tSetCategoryCheckboxState( 'category_1', bMultiplayer );\n\t\t}\n\n\t\t// Update the store preview\n\t\t\t\t\tOnPlayerCategoryChanged( 'category_2' );\n\t\t\t\t\tOnPlayerCategoryChanged( 'category_1' );\n\t\t\t\t\tOnPlayerCategoryChanged( 'category_20' );\n\t\t\t\t\tOnPlayerCategoryChanged( 'category_49' );\n\t\t\t\t\tOnPlayerCategoryChanged( 'category_36' );\n\t\t\t\t\tOnPlayerCategoryChanged( 'category_47' );\n\t\t\t\t\tOnPlayerCategoryChanged( 'category_37' );\n\t\t\t\t\tOnPlayerCategoryChanged( 'category_9' );\n\t\t\t\t\tOnPlayerCategoryChanged( 'category_38' );\n\t\t\t\t\tOnPlayerCategoryChanged( 'category_48' );\n\t\t\t\t\tOnPlayerCategoryChanged( 'category_39' );\n\t\t\t\t\tOnPlayerCategoryChanged( 'category_24' );\n\t\t\t\t\tOnPlayerCategoryChanged( 'category_27' );\n\t\t\n\t\tbInitializingPlayerWizard = false;\n\t}\n\n\tconst multiplayerPvPCategories = [\n\t\t'category_36',\n\t\t'category_37',\n\t\t'category_47',\n\t];\n\n\tconst multiplayerCoopCategories = [\n\t\t'category_38',\n\t\t'category_39',\n\t\t'category_48',\n\t];\n\n\tconst multiplayerCategories = [\n\t\t'category_1',\n\t\t'category_49',\n\t\t...multiplayerPvPCategories,\n\t\t'category_9',\n\t\t...multiplayerCoopCategories,\n\t];\n\n\tfunction UpdateMultiplayerCategoryVisibility( category )\n\t{\n\t\tif (! multiplayerCategories.includes( category ) )\n\t\t{\n\t\t\treturn;\n\t\t}\n\n\t\tconst bVisibility = multiplayerCategories.reduce(\n\t\t\t( map, cat ) =>\n\t\t\t{\n\t\t\t\tmap[ cat ] = GetCategoryCheckboxState( cat );\n\t\t\t\treturn map;\n\t\t\t},\n\t\t\t{} );\n\n\t\tif ( multiplayerCoopCategories.some( ( cat ) => bVisibility[ cat ] ) )\n\t\t{\n\t\t\tbVisibility[ 'category_9' ] = false;\n\t\t\tbVisibility[ 'category_1' ] = false;\n\t\t}\n\t\tif ( multiplayerPvPCategories.some( ( cat ) => bVisibility[ cat ] ) )\n\t\t{\n\t\t\tbVisibility[ 'category_49' ] = false;\n\t\t\tbVisibility[ 'category_1' ] = false;\n\t\t}\n\t\tif ( bVisibility[ 'category_9' ] || bVisibility[ 'category_49' ] )\n\t\t{\n\t\t\tbVisibility[ 'category_1' ] = false;\n\t\t}\n\n\t\tObject.keys( bVisibility ).forEach( ( cat ) =>\n\t\t{\n\t\t\tconst bVisible = bVisibility[ cat ];\n\t\t\tconst preview = 'player_store_preview_' + cat;\n\t\t\tif ( $( preview ) != null )\n\t\t\t{\n\t\t\t\tif ( bVisible )\n\t\t\t\t{\n\t\t\t\t\t$( preview ).show();\n\t\t\t\t}\n\t\t\t\telse\n\t\t\t\t{\n\t\t\t\t\t$( preview ).hide();\n\t\t\t\t}\n\t\t\t}\n\t\t} );\n\t}\n\n\tfunction OnPlayerCategoryChanged( category )\n\t{\n\t\tvar bChecked = GetCategoryCheckboxState( category );\n\n\t\tvar preview = 'player_store_preview_' + category;\n\t\tif ( $(preview) != null )\n\t\t{\n\t\t\tif ( bChecked )\n\t\t\t{\n\t\t\t\t$( preview ).show();\n\t\t\t}\n\t\t\telse\n\t\t\t{\n\t\t\t\t$( preview ).hide();\n\t\t\t}\n\t\t}\n\n\t\tUpdateMultiplayerCategoryVisibility( category );\n\n\t\tif ( category == 'category_1' )\n\t\t{\n\t\t\tif ( bChecked )\n\t\t\t{\n\t\t\t\t$J( 'player_section_multiplayer_controls' ).show();\n\t\t\t}\n\t\t\telse\n\t\t\t{\n\t\t\t\tSetCategoryCheckboxState( 'category_20', false );\n\t\t\t\tSetCategoryCheckboxState( 'category_49', false );\n\t\t\t\tSetCategoryCheckboxState( 'category_9', false );\n\t\t\t\tSetCategoryCheckboxState( 'category_27', false );\n\n\t\t\t\t$J( 'player_section_multiplayer_controls' ).hide();\n\t\t\t}\n\t\t}\n\n\t\tif ( category == 'category_49' )\n\t\t{\n\t\t\tif ( bChecked )\n\t\t\t{\n\t\t\t\t$J( 'player_section_pvp_controls' ).show();\n\t\t\t}\n\t\t\telse\n\t\t\t{\n\t\t\t\tSetCategoryCheckboxState( 'category_36', false );\n\t\t\t\tSetCategoryCheckboxState( 'category_47', false );\n\t\t\t\tSetCategoryCheckboxState( 'category_37', false );\n\n\t\t\t\t$J( 'player_section_pvp_controls' ).hide();\n\t\t\t}\n\t\t}\n\n\t\tif ( category == 'category_9' )\n\t\t{\n\t\t\tif ( bChecked )\n\t\t\t{\n\t\t\t\t$J( 'player_section_coop_controls' ).show();\n\t\t\t}\n\t\t\telse\n\t\t\t{\n\t\t\t\tSetCategoryCheckboxState( 'category_38', false );\n\t\t\t\tSetCategoryCheckboxState( 'category_48', false );\n\t\t\t\tSetCategoryCheckboxState( 'category_39', false );\n\n\t\t\t\t$J( 'player_section_coop_controls' ).hide();\n\t\t\t}\n\t\t}\n\n\t\tif ( ( category == 'category_37' || category == 'category_39' ) && !bInitializingPlayerWizard )\n\t\t{\n\t\t\tvar bLocalPvP = GetCategoryCheckboxState( 'category_37' );\n\t\t\tvar bLocalCoop = GetCategoryCheckboxState( 'category_39' );\n\t\t\tSetCategoryCheckboxState( 'category_24', ( bLocalPvP || bLocalCoop ) );\n\t\t}\n\n\t\tif ( category == 'category_24' && !bInitializingPlayerWizard )\n\t\t{\n\t\t\tif ( bChecked != GetCategoryCheckboxState( 'category_44' ) )\n\t\t\t{\n\t\t\t\tSetCategoryCheckboxState( 'category_44', bChecked );\n\n\t\t\t\tif ( bChecked )\n\t\t\t\t{\n\t\t\t\t\talert( 'The Remote Play Together feature has been enabled to match your multiplayer flags. Feel free to disable it, if it\\'s not appropriate for your game.' );\n\t\t\t\t}\n\t\t\t\telse\n\t\t\t\t{\n\t\t\t\t\talert( 'The Remote Play Together feature has been disabled to match your multiplayer flags. Feel free to enable it, if it\\'s appropriate for your game.' );\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t}\n\n\tfunction OnCloudGamingUpdated()\n\t{\n\t\tvar bCloudGamingEnabled = GetCategoryCheckboxState( 'category_45' );\n\n\t\t\t\t\tSynchronizeCategoryCheckbox( 'category_46', bCloudGamingEnabled, true );\n\t\t\t}\n\n\tfunction UpdateCloudGamingProviderState()\n\t{\n\t\t\t}\n\n\tvar bUpdatingCloudGamingProvider = false;\n\n\tfunction OnCloudGamingProviderUpdated( provider )\n\t{\n\t\tif ( bUpdatingCloudGamingProvider )\n\t\t{\n\t\t\treturn;\n\t\t}\n\t\tbUpdatingCloudGamingProvider = true;\n\n\t\tvar bCloudGamingEnabled = GetCategoryCheckboxState( 'category_45' );\n\t\tif ( !bCloudGamingEnabled )\n\t\t{\n\t\t\tSetCategoryCheckboxState( provider, false );\n\t\t}\n\n\t\tbUpdatingCloudGamingProvider = false;\n\t}\n\n\tfunction ConvertDLCToSoundtrackButtonClicked()\n\t{\n\t\t$J.ajax({\n\t\t\ttype: \"POST\",\n\t\t\turl: \"https://partner.steamgames.com/apps/convertdlcapptomusicalbumapp/\" + 1000000,\n\t\t\tdata: { sessionid: g_sessionID },\n\t\t\tdataType: \"json\"\n\t\t})\n\t\t.done( function( msg ) {\n\t\t\tlocation.reload();\n\t\t});\n\t}\n\n\tfunction AspectRatioFromResolution()\n\t{\n\t\tvar width = parseInt( $( 'app[video][width]' ).value );\n\t\tvar height = parseInt( $( 'app[video][height]' ).value );\n\t\tif ( width && height )\n\t\t{\n\t\t\tvar ar = (width / height).toFixed(2);\n\t\t\tvar finalAR = \"\";\n\n\t\t\tif ( ar == 1.78 )\n\t\t\t\tfinalAR = \"16:9\";\n\t\t\telse if ( ar == 1.33 )\n\t\t\t\tfinalAR = \"4:3\"\n\t\t\telse\n\t\t\t\tfinalAR = ar + \":1\";\n\n\t\t\t$( 'app[video][aspect_ratio]' ).value = finalAR;\n\t\t}\n\t\telse\n\t\t{\n\t\t\t$( 'app[video][aspect_ratio]' ).value = \"\";\n\t\t}\n\n\t\treturn false;\n\t}\n\n\tfunction UpdateVideoDetailsFromLiveVideo()\n\t{\n\t\tvar progressDialog = ShowBlockingWaitDialog( 'Video Details', 'Please wait while the video details are retrieved...' );\n\n\t\t$J.ajax( {\n\t\t\ttype: \"POST\",\n\t\t\turl: \"https://partner.steamgames.com/game/ajaxvideodetailsforstorepage/1000000/\",\n\t\t\tdataType: \"json\",\n\t\t\tdata: {\n\t\t\t\t'sessionid': g_sessionID,\n\t\t\t},\n\t\t\tsuccess: function ( response )\n\t\t\t{\n\t\t\t\tprogressDialog.Dismiss();\n\t\t\t\tif ( response.result == 1 )\n\t\t\t\t{\n\t\t\t\t\t$( 'app[movie][playtime]' ).value = response.playtime;\n\t\t\t\t\t$( 'app[video][width]' ).value = response.width;\n\t\t\t\t\t$( 'app[video][height]' ).value = response.height;\n\t\t\t\t\t$J( 'select[name=\"app\\\\[video\\\\]\\\\[audio_channels\\\\]\"' ).val( response.audio );\n\t\t\t\t\tAspectRatioFromResolution();\n\t\t\t\t}\n\t\t\t\telse\n\t\t\t\t{\n\t\t\t\t\tShowAlertDialog( 'Video Details', 'The featured video file has not been processed.' );\n\t\t\t\t}\n\t\t\t},\n\t\t\terror: function ( response )\n\t\t\t{\n\t\t\t\tprogressDialog.Dismiss();\n\t\t\t\tShowAlertDialog( 'Video Details', 'Could not talk to the Steam Servers. Please try again in a few minutes.' );\n\t\t\t}\n\t\t} );\n\n\t\treturn false;\n\t}\n\n\tfunction OnHideWindowsMR()\n\t{\n\t\t$('app[content][vrsupport][hide_windowsmr_isset]').value = '1';\n\t}\n\n\n\t/**\n\t * This variable ensures the proper flow for applying genres from tags\n\t *\n\t * Genre checkboxes should auto-update when you go to the tag page & return,\n\t * but NOT auto-update until you go back to the tag page.\n\t *\n\t * When you click \"apply tags now\" this flag is set to 1\n\t * If it's set to 1, when onblur() fires, this flag is set to 2\n\t * If it's set to 2, when onfocus() fires, genre checkboxes auto-update\n\t *\n\t **/\n\tvar ApplyTagsAsMetadataOnNextBlurAndFocus = 0;\n\n\tfunction AjaxCountAppTags( nAppId, callback)\n\t{\n\t\tif( !nAppId )\n\t\t\treturn;\n\n\t\t$J.ajax({\n\t\t\ttype: \"POST\",\n\t\t\turl: \"https://partner.steamgames.com/apps/ajaxcountapptags/\"+nAppId,\n\t\t\tdata: {\n\t\t\t\t'appid': nAppId,\n\t\t\t\t'sessionid': g_sessionID\n\t\t\t},\n\t\t\tsuccess: function( response )\n\t\t\t{\n\t\t\t\tvar count = 0;\n\t\t\t\tif(response.length < 5){\n\t\t\t\t\tcount = parseInt(response);\n\t\t\t\t}\n\t\t\t\tcallback(count);\n\t\t\t}\n\t\t});\n\t}\n\n\tfunction AjaxGetUserTags( nAppId, callback)\n\t{\n\t\tif( !nAppId )\n\t\t\treturn;\n\n\t\t$J.ajax({\n\t\t\ttype: \"POST\",\n\t\t\turl: \"https://partner.steamgames.com/apps/ajaxgetusertags/\"+nAppId,\n\t\t\tdata: {\n\t\t\t\t'appid': nAppId,\n\t\t\t\t'sessionid': g_sessionID\n\t\t\t},\n\t\t\tsuccess: function( response )\n\t\t\t{\n\t\t\t\tif(callback != null){\n\t\t\t\t\tcallback(response);\n\t\t\t\t}\n\t\t\t}\n\t\t});\n\t}\n\n\tfunction SyncGenreCheckboxesToTags( tags )\n\t{\n\t\tif( tags == null )\n\t\t\treturn;\n\n\t\tvar checkStuff = GetCheckedAndUncheckedGenres().checkboxes;\n\n\t\ttags.forEach(function(tag){\n\t\t\tvar name = tag.name;\n\t\t\tvar checkObjects = checkStuff[name];\n\n\t\t\tif(checkObjects != null){\n\t\t\t\tvar input = checkObjects[\"input\"];\n\t\t\t\tvar checked = checkObjects[\"checked\"];\n\t\t\t\tvar unchecked = checkObjects[\"unchecked\"];\n\n\t\t\t\tif(input != null && checked != null && unchecked != null){\n\t\t\t\t\tvar isChecked = input.getAttribute(\"value\") == \"true\";\n\t\t\t\t\tif(!isChecked){\n\t\t\t\t\t\tinput.setAttribute(\"value\",\"true\");\n\t\t\t\t\t\tchecked.setAttribute(\"style\",\"display: inline;\");\n\t\t\t\t\t\tunchecked.setAttribute(\"style\",\"display: none;\");\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t}\n\t\t});\n\t}\n\n\tfunction SyncPlayerCheckboxesToTags( tags )\n\t{\n\t\tif( tags == null )\n\t\t\treturn;\n\n\t\t\n\t\tvar rgStoreCategoryIdsByTagid = {\"4182\":[2],\"3859\":[1],\"1685\":[9,1],\"3841\":[9,1,39],\"3843\":[9,38],\"128\":[20,1],\"10816\":[24,1],\"21978\":[34,31],\"1669\":[30]};\n\t\tvar checkStuff = GetCheckedAndUncheckedPlayers().checkboxes;\n\t\tvar rgStoreCategoryIds = [];\n\n\t\ttags.forEach(function(tag){\n\n\t\t\tvar tagid = tag.tagid;\n\t\t\tfor(keyTagid in rgStoreCategoryIdsByTagid)\n\t\t\t{\n\t\t\t\tif(keyTagid == tagid)\n\t\t\t\t{\n\t\t\t\t\tvar rgStoreCats = rgStoreCategoryIdsByTagid[keyTagid];\n\t\t\t\t\tfor(var i = 0; i < rgStoreCats.length; i++)\n\t\t\t\t\t{\n\t\t\t\t\t\tvar storeCatId = rgStoreCats[i];\n\t\t\t\t\t\tif(rgStoreCategoryIds.indexOf(storeCatId) == -1)\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\tintStoreCatid = parseInt(storeCatId);\n\t\t\t\t\t\t\tif(intStoreCatid != null && !isNaN(intStoreCatid))\n\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\trgStoreCategoryIds.push(intStoreCatid);\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t}\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t}\n\t\t});\n\n\t\tfor(var i = 0; i < rgStoreCategoryIds.length; i++)\n\t\t{\n\t\t\tvar categoryId = rgStoreCategoryIds[i];\n\t\t\tvar checkObjects = checkStuff[\"category_\"+categoryId];\n\n\t\t\tif(checkObjects != null)\n\t\t\t{\n\t\t\t\tvar input = checkObjects[\"input\"];\n\t\t\t\tvar checked = checkObjects[\"checked\"];\n\t\t\t\tvar unchecked = checkObjects[\"unchecked\"];\n\n\t\t\t\tif(input != null && checked != null && unchecked != null)\n\t\t\t\t{\n\t\t\t\t\tvar isChecked = input.getAttribute(\"value\") == \"true\";\n\t\t\t\t\tif(!isChecked)\n\t\t\t\t\t{\n\t\t\t\t\t\tinput.setAttribute(\"value\",\"true\");\n\t\t\t\t\t\tchecked.setAttribute(\"style\",\"display: inline;\");\n\t\t\t\t\t\tunchecked.setAttribute(\"style\",\"display: none;\");\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t}\n\n\twindow.onblur = function(){\n\t\tif(ApplyTagsAsMetadataOnNextBlurAndFocus == 1){\n\t\t\tApplyTagsAsMetadataOnNextBlurAndFocus = 2;\n\t\t}\n\t}\n\n\tRefreshTagCount = function(){\n\t\tvar el = document.getElementById(\"tag_status_line\");\n\t\tif(el !== null){\n\t\t\tAjaxCountAppTags( 1000000, function(count){\n\t\t\t\tel.innerHTML = \"(You have applied <strong>%s tags</strong>)\".replace(\"%s\",count);\n\t\t\t});\n\t\t\tif(ApplyTagsAsMetadataOnNextBlurAndFocus == 2){\n\t\t\t\tAjaxGetUserTags( 1000000, function(tags){\n\t\t\t\t\tSyncGenreCheckboxesToTags(tags);\n\n\t\t\t\t\t//I think we don't actually want this:\n\t\t\t\t\t//SyncPlayerCheckboxesToTags(tags);\n\t\t\t\t});\n\t\t\t\tApplyTagsAsMetadataOnNextBlurAndFocus = 0;\n\t\t\t}\n\t\t}\n\t}\n\n\twindow.onfocus = function(){\n\t\tRefreshTagCount();\n\t}\n\n\tOnClickTagWizard = function(nAppId){\n\t\tApplyTagsAsMetadataOnNextBlurAndFocus = 1;\n\n\t\tvar url = 'https://partner.steamgames.com/taxonomy/tagwizard/' + nAppId;\n\t\twindow.open(\n\t\t\turl,\n\t\t\t\"_blank\"\n\t\t);\n\t}\n\n\tOnClickCopyTagsFromParent = function( nDlcAppId )\n\t{\n\t\tvar rgParams = {\n\t\t\tsessionid: g_sessionID,\n\t\t};\n\n\t\t$J.post( 'https://partner.steamgames.com/apps/copytagsfromparent/' + nDlcAppId, rgParams )\n\t\t\t.done( function( response ) {\n\t\t\t\tif( response.success == 1 )\n\t\t\t\t{\n\t\t\t\t\tRefreshTagCount();\n\t\t\t\t\tShowAlertDialog( 'Copy Tags',\n\t\t\t\t\t\t'Tags copied successfully. ' );\n\t\t\t\t}\n\t\t\t\telse\n\t\t\t\t{\n\t\t\t\t\tShowAlertDialog( 'Copy Tags',\n\t\t\t\t\t\t'Failed to copy tags. ' + response['message'] + ' ' + response['success'] );\n\t\t\t\t}\n\t\t\t} );\n\t}\n\n\tWrapTagsButton = function(){\n\t\tvar el = document.getElementById(\"add_tags_now_button\");\n\t\tif(el !== null){\n\t\t\tvar spans = el.getElementsByTagName(\"span\");\n\t\t\tif(spans != null && spans.length > 0){\n\t\t\t\tfor ( var i = 0; i < spans.length; i++ )\n\t\t\t\t{\n\t\t\t\t\tvar span = spans[i];\n\t\t\t\t\tvar onclick = span.getAttribute(\"onclick\");\n\t\t\t\t\tonclick = \"ApplyTagsAsMetadataOnNextBlurAndFocus = 1; ApplyMetadataAsTags(); \" + onclick;\n\t\t\t\t\tspan.setAttribute(\"onclick\",onclick);\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t\tApplyMetadataAsTags();\n\t}\n\n\tGetCheckedAndUncheckedPlayers = function(){\n\t\tvar allPlayers = [];\n\t\tvar checkedPlayers = [];\n\t\tvar uncheckedPlayers = [];\n\t\tvar checkboxes = {};\n\n\t\tvar multiplayerIDs = [\n\t\t\t\"category_2\",\t//single player\n\t\t\t\"category_1\",\t//multi player\n\t\t\t\"category_49\",\t//pvp\n\t\t\t\"category_36\",\t//online pvp\n\t\t\t\"category_47\",\t//LAN pvp\n\t\t\t\"category_37\",\t//Local pvp\n\t\t\t\"category_9\",\t//coop\n\t\t\t\"category_38\",\t//online coop\n\t\t\t\"category_48\",\t//LAN coop\n\t\t\t\"category_39\",\t//Local coop\n\t\t\t\"category_27\"\n\t\t];\n\n\t\tfor(var i = 0; i < multiplayerIDs.length; i++){\n\t\t\tvar id = multiplayerIDs[i];\n\t\t\tvar input = document.getElementById(\"checkbox_app_classification_category_\"+id+\"__input\");\n\t\t\tvar checked = document.getElementById(\"checkbox_app_classification_category_\"+id+\"__checked\");\n\t\t\tvar unchecked = document.getElementById(\"checkbox_app_classification_category_\"+id+\"__unchecked\");\n\t\t\tvar box = document.getElementById(\"checkbox_app_classification_category_\"+id+\"_\");\n\t\t\tcheckboxes[id] = {\n\t\t\t\t\"input\":input,\n\t\t\t\t\"checked\":checked,\n\t\t\t\t\"unchecked\":unchecked\n\t\t\t};\n\t\t\tvar category_number = parseInt(id.replace(\"category_\",\"\"));\n\t\t\tif(category_number != null && !isNaN(category_number))\n\t\t\t{\n\t\t\t\tif(checked != null && checked.getAttribute(\"style\").indexOf(\"display: none\") == -1){\n\t\t\t\t\tcheckedPlayers.push(category_number);\n\t\t\t\t}else{\n\t\t\t\t\tuncheckedPlayers.push(category_number);\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t\treturn {\n\t\t\t\"checked\":checkedPlayers,\n\t\t\t\"unchecked\":uncheckedPlayers,\n\t\t\t\"checkboxes\":checkboxes\n\t\t};\n\t}\n\n\tGetCheckedAndUncheckedGenres = function(){\n\t\tvar allGenres = [];\n\t\tvar checkedGenres = [];\n\t\tvar uncheckedGenres = [];\n\t\tvar checkboxes = {};\n\t\tvar genreContainer = document.getElementById(\"genres_game\");\n\t\tfor(var i = 0; i < genreContainer.childNodes.length; i++){\n\t\t\tvar child = genreContainer.childNodes[i];\n\t\t\tif(child == null) continue;\n\t\t\tif(child.className === \"checkboxGrid\"){\n\t\t\t\tvar aChild = null;\n\t\t\t\tfor(var k = 0; k < child.childNodes.length; k++){\n\t\t\t\t\tif(child.childNodes[k].tagName === \"A\"){\n\t\t\t\t\t\taChild = child.childNodes[k];\n\t\t\t\t\t\tif(aChild != null){\n\t\t\t\t\t\t\tbreak;\n\t\t\t\t\t\t}\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t\tif(aChild == null) continue;\n\t\t\t\tvar id = aChild.getAttribute(\"id\");\n\t\t\t\tvar genreId = id.replace(\"checkbox_rgGenres_\",\"\");\n\t\t\t\tgenreId = genreId.replace(\"_\",\"\");\n\t\t\t\tvar genreNumId = parseInt(genreId);\n\t\t\t\tif(!isNaN(genreNumId)){\n\t\t\t\t\tallGenres.push(genreNumId);\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\n\t\tfor(var i = 0; i < allGenres.length; i++){\n\t\t\tvar genre = allGenres[i];\n\t\t\tvar input = document.getElementById(\"checkbox_rgGenres_\"+genre+\"__input\");\n\t\t\tvar checked = document.getElementById(\"checkbox_rgGenres_\"+genre+\"__checked\");\n\t\t\tvar unchecked = document.getElementById(\"checkbox_rgGenres_\"+genre+\"__unchecked\");\n\t\t\tvar box = document.getElementById(\"checkbox_rgGenres_\"+genre+\"_\");\n\t\t\tvar genreName = \"\";\n\t\t\tfor(var j = 0; j < box.childNodes.length; j++){\n\t\t\t\tvar el = box.childNodes[j];\n\t\t\t\tif(el.tagName == \"INPUT\"){\n\t\t\t\t\tvar onChange = el.getAttribute(\"onchange\");\n\t\t\t\t\tonChangeBits = onChange.split(\",\");\n\t\t\t\t\tif(onChangeBits != null && onChangeBits.length > 2){\n\t\t\t\t\t\tvar lastBit = onChangeBits[2];\n\t\t\t\t\t\tlastBit = lastBit.replace(\"');\",\"\");\n\t\t\t\t\t\tlastBit = lastBit.replace(\" '\",\"\");\n\t\t\t\t\t\tgenreName = lastBit;\n\t\t\t\t\t\tcheckboxes[genreName] = {\n\t\t\t\t\t\t\t\"input\":input,\n\t\t\t\t\t\t\t\"checked\":checked,\n\t\t\t\t\t\t\t\"unchecked\":unchecked\n\t\t\t\t\t\t};\n\t\t\t\t\t\tbreak;\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t}\n\t\t\tif(genreName != \"\" && genreName != null){\n\t\t\t\tif(checked != null && checked.getAttribute(\"style\").indexOf(\"display: none\") == -1){\n\t\t\t\t\tcheckedGenres.push(genreName);\n\t\t\t\t}else{\n\t\t\t\t\tuncheckedGenres.push(genreName);\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\n\t\treturn {\n\t\t\t\"checked\":checkedGenres,\n\t\t\t\"unchecked\":uncheckedGenres,\n\t\t\t\"checkboxes\":checkboxes\n\t\t};\n\t}\n\n\tTagWizardDetected = function(){\n\t\treturn 1;\n\t}\n\n\tApplyMetadataAsTags = function()\n\t{\n\t\t//We only want to do this if the tag wizard doesn't exist!\n\t\t//If the tag wizard exists we can pull this info directly,\n\t\t//If the tag wizard doesn't exist applying tag votes like this will make\n\t\t//hash of the tag profile\n\t\tif(!TagWizardDetected())\n\t\t{\n\t\t\tApplyGenresAsTags();\n\t\t}\n\t}\n\n\tApplyGenresAsTags = function(){\n\n\t\tvar genres = GetCheckedAndUncheckedGenres();\n\n\t\tvar rgParams = {\n\t\t\tappid: 1000000,\n\t\t\tgenresToAdd: genres.checked,\n\t\t\tgenresToRemove: [],\n\t\t\tsessionid: g_sessionID,\n\t\t};\n\n\t\t$J.post( 'https://partner.steamgames.com/tagdata/tagappwithgenres', rgParams );\n\t}\n\n\t</script>\n\n\n\n\t<div class=\"section\">\n\t\t<p class=\"aldengold\">This area is where you configure the presentation of your product's page in the Steam store. Please complete all the fields marked as <span class=\"required\">*</span>.<br>\n\t\t\tIf you need help, check out the <a href=\"https://partner.steamgames.com/doc/store\">Store Page Best Practices</a> documentation for a video walkthrough of configuring your store page.</p>\n\t\t<br>\n\t\t<div class=\"subsection\">\n\t\t\t<div class=\"formrow\">\n\t\t\t\t<div class=\"formlabel\">App Type:<span class=\"required\">*</span></div>\n\t\t\t\t<div class=\"formdata\">\n\t\t\t\t\t\t\t\t\t<select name=\"app[type]\" id=\"appTypeSelect\">\n\t\t\t\t\t\t\t\t\t\t\t\t\t<option value=\"Game\" selected=\"true\">Game</option>\n\t\t\t\t\t\t\t\t\t\t\t\t\t<option value=\"Application\" >Application</option>\n\t\t\t\t\t\t\t\t\t\t\t</select>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t</div>\n\t\t</div>\n\n\t\t\t\t\t<div class=\"subsection\">\n\t\t\t\t<div class=\"formrow\">\n\t\t\t\t\t<div class=\"formlabel\">Game Name:<span class=\"required\">*</span></div>\n\t\t\t\t\t<div class=\"formdata\" style=\"float: none; overflow: hidden;\">\n\t\t\t\t\t\t\t\t\t\t\t\t<input type=\"text\" name=\"app[name]\" value=\"ExampleGame\"  size=\"50\">\n\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t\n\t\t\t\t<br>\n\n\t\t\n\t\t\n\t\t<div class=\"subsection\">\n\t\t\t<h2>Developers, Publishers, and Franchises</h2>\n\t\t\t<div class=\"grayRule\"> </div>\n\t\t\t<div class=\"sectionDescription\">Enter the name of one or more developer, publisher, and franchise that your game belongs to. Once saved, you can link these names to the corresponding developer or publisher homepage, so that players can find all of the games you make. For details on setting up a homepage, please see <a href='https://partner.steamgames.com/creatorhome/' target='_blank'>Creator Home Setup</a>, or find it in the 'Apps & Packages' drop-down menu above.</div>\n\t\t\t\n\t\t\t\t\t\t<div class=\"formrow flexRow\">\n\t\t\t\t<div class=\"formlabel\">Developer(s):<span class=\"required\">*</span>\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t<div class=\"formdata settingsBlock\">\n\t\t\t\t\t<div class=\"left\">\n\t\t\t\t\t\t\t\t\t\t\t\t<div class=\"innerformrow creatorhome_add_new\">\n\t\t\t\t\t\t\t\t\t\t<input type=\"text\" id=\"app_game_developers_0_name__compl\" name=\"app[game][developers][0][name]_compl\" size=\"30\" onfocus=\"\" value=\"\" placeholder=\"\">\n\t\t<div class=\"autocomplete\" id=\"app_game_developers_0_name__list\" style=\"display: none;\"></div>\n\t\t<input name=\"app[game][developers][0][name]\" id=\"app_game_developers_0_name__target\" type=\"hidden\" value=\"\" onchange=\"\">\n\t\t<input id=\"app_game_developers_0_name__compl_check\" type=\"hidden\" value=\"\">\n\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<input class=\"btn_grey_steamui btn_small_thin\" type=\"submit\" value=\"Save and add another\">\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t<div class=\"right\">\n\t\t\t\t\t\t\t\t\t\t\t<a href=\"https://partner.steamgames.com/doc/store/creator_homepage\" target=\"_blank\">Creator Homepage Documentation</a>\n\t\t\t\t\t\t<div class=\"alertText\">Developer names should not link to the publisher's page. If a developer has not created a homepage, then you should leave their name unlinked and Steam will automatically generate a list for players of the games with this developer name.</div>\n\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t\t\t\t\t<div class=\"formrow flexRow\">\n\t\t\t\t<div class=\"formlabel\">Publisher(s):<span class=\"required\">*</span>\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t<div class=\"formdata settingsBlock\">\n\t\t\t\t\t<div class=\"left\">\n\t\t\t\t\t\t\t\t\t\t\t\t<div class=\"innerformrow creatorhome_add_new\">\n\t\t\t\t\t\t\t\t\t\t<input type=\"text\" id=\"app_game_publishers_0__compl\" name=\"app[game][publishers][0]_compl\" size=\"30\" onfocus=\"\" value=\"\" placeholder=\"\">\n\t\t<div class=\"autocomplete\" id=\"app_game_publishers_0__list\" style=\"display: none;\"></div>\n\t\t<input name=\"app[game][publishers][0]\" id=\"app_game_publishers_0__target\" type=\"hidden\" value=\"\" onchange=\"\">\n\t\t<input id=\"app_game_publishers_0__compl_check\" type=\"hidden\" value=\"\">\n\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<input class=\"btn_grey_steamui btn_small_thin\" type=\"submit\" value=\"Save and add another\">\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t<div class=\"right\">\n\t\t\t\t\t\t\t\t\t\t\t<a href=\"https://partner.steamgames.com/doc/store/creator_homepage\" target=\"_blank\">Creator Homepage Documentation</a>\n\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t\t\t\t\t<div class=\"formrow flexRow\">\n\t\t\t\t<div class=\"formlabel\">Franchise(s):\t\t\t\t\t\t\t\t\t\t\t<span class=\"ttip small\"  data-tooltip-text=\"Adding franchises is optional. By adding a franchise name, it lets you create a franchise creator homepage and also lets customer search for games and DLCs by franchise name. All children apps, such DLCs, will automatically get their parent's saved and published franchises. Note: do not append 'Franchise' to the label. The text 'Franchise' will be automatically appended, when needed, in the appropriate places on the Steam store pages.\" >(?)</span>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t<div class=\"formdata settingsBlock\">\n\t\t\t\t\t<div class=\"left\">\n\t\t\t\t\t\t\t\t\t\t\t\t<div class=\"innerformrow creatorhome_add_new\">\n\t\t\t\t\t\t\t\t\t\t<input type=\"text\" id=\"app_game_franchises_0_name__compl\" name=\"app[game][franchises][0][name]_compl\" size=\"30\" onfocus=\"\" value=\"\" placeholder=\"\">\n\t\t<div class=\"autocomplete\" id=\"app_game_franchises_0_name__list\" style=\"display: none;\"></div>\n\t\t<input name=\"app[game][franchises][0][name]\" id=\"app_game_franchises_0_name__target\" type=\"hidden\" value=\"\" onchange=\"\">\n\t\t<input id=\"app_game_franchises_0_name__compl_check\" type=\"hidden\" value=\"\">\n\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<input class=\"btn_grey_steamui btn_small_thin\" type=\"submit\" value=\"Save and add another\">\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t<div class=\"right\">\n\t\t\t\t\t\t\t\t\t\t\t<a href=\"https://partner.steamgames.com/doc/store/franchise_pages\" target=\"_blank\">Franchise Homepage Documentation</a>\n\t\t\t\t\t\t\t\t\t\t\t\t\t<div class=\"alertText\">A franchise is a set of titles related by intellectual property or universe. Can be different styles, genres of gameplay, or separate narratives. The developer or publisher cannot be linked in this section.</div>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<div id=\"creator_home_fixup\" data-featuretarget=\"storeadmin-creator-home-fixup\" data-props=\"{&quot;nAppID&quot;:1000000,&quot;rgAllCreatorHomeNames&quot;:[],&quot;nPrimaryPartnerID&quot;:900000}\"></div><div id=\"creator_home_link_history\" data-featuretarget=\"storeadmin-creator-home-link-history\" data-props=\"{&quot;nAppID&quot;:1000000}\"></div>\t\t\t\t\t</div>\n\n\t\t\t\t\t<div class=\"subsection\" id=\"external_links\">\n\t\t\t\t<h2>External Links</h2>\n\t\t\t\t<div class=\"grayRule\"> </div>\n\t\t\t\t<div class=\"sectionDescription\">Please provide links to your product's website, forums, and/or online guide if applicable. All urls must start with http:// or https://</div>\n\n\t\t\t\t<div class=\"formrow\">\n\t\t\t\t\t<div class=\"formlabel\">Game Website URL:</div>\n\t\t\t\t\t<div class=\"formdata\">\n\t\t\t\t\t\t<input type=\"text\" name=\"app[content][links][website]\" value=\"\" size=\"75\">\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class=\"formrow\">\n\t\t\t\t\t<div class=\"formlabel\">Forum URL:</div>\n\t\t\t\t\t<div class=\"formdata\">\n\t\t\t\t\t\t<input type=\"text\" name=\"app[content][links][forums]\" value=\"\" size=\"75\">\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class=\"formrow\">\n\t\t\t\t\t<div class=\"formlabel\">Stats URL:</div>\n\t\t\t\t\t<div class=\"formdata\">\n\t\t\t\t\t\t<input type=\"text\" name=\"app[content][links][stats]\" value=\"\" size=\"75\">\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class=\"formrow\">\n\t\t\t\t\t<div class=\"formlabel\">Online Manual URL:</div>\n\t\t\t\t\t<div class=\"formdata\">\n\t\t\t\t\t\t<input type=\"text\" name=\"app[content][links][online_manual]\" value=\"\" size=\"75\">\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class=\"formrow\">\n\t\t\t\t\t<div class=\"formlabel\">Health Warning URL:</div>\n\t\t\t\t\t<div class=\"formdata\">\n\t\t\t\t\t\t<input type=\"text\" name=\"app[content][links][health_warning]\" value=\"\" size=\"75\">\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class=\"formrow\">\n\t\t\t\t\t<div class=\"formlabel\">Privacy Policy URL:</div>\n\t\t\t\t\t<div class=\"formdata\">\n\t\t\t\t\t\t<input type=\"text\" name=\"app[content][links][privacy_policy]\" value=\"\" size=\"75\">\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t<div class=\"formrow\">\n\t\t\t\t\t<div class=\"formlabel\">Metacritic entry: <span class=\"ttip small\"  data-tooltip-text=\"Set this field to match the name of your product on Metacritic. Begin by typing the name and then selecting the product name from the list that appears. If your product is new, it may not appear in the list, have a score on Metacritic, or may not yet be part of the feed we get from Metacritic. If that is the case, you will need to update this field at a later time.\" >(?)</span></div>\n\t\t\t\t\t<div class=\"formdata\">\n\t\t\t\t\t\t\t\t<input type=\"text\" id=\"app_game_metacritic_metacritic_name__compl\" name=\"app[game][metacritic][metacritic_name]_compl\" size=\"45\" onfocus=\"\" onblur=\"OnBlurMetacritic( this.value )\" >\n\t\t<div class=\"autocomplete\" id=\"app_game_metacritic_metacritic_name__list\" style=\"display: none;\"></div>\n\t\t<input name=\"app[game][metacritic][metacritic_name]\" id=\"app_game_metacritic_metacritic_name__target\" type=\"hidden\" value=\"\" onchange=\"UpdateMetacriticLink(this.value, 'metacritic_link')\">\n\n\t\t\t\t\t\t\t\t<a href=\"\" id=\"metacritic_link\"  target=\"_blank\" style=\"display: none;\">View Metacritic page</a>\n\t\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t\n\t\t\t</div>\n\n\t\t\t\t\t\t\t\t\t\t\t<div class=\"subsection\" id=\"social_links\">\n\t\t\t\t\t\t<h2>Social Media Links</h2>\n\t\t\t\t\t\t<div class=\"grayRule\"> </div>\n\n\n\t\t\t\t\t<div class=\"sectionDescription\">Use the drop-down to select the social media platforms that your team uses to communicate about this game. Once selected, you'll be able to enter the URL to your presence on each platform.</div>\n\t\t\t\t\t<div  data-featuretarget=\"storeadmin-social-media-edit\" data-props=\"{&quot;rgSocialMedia&quot;:[],&quot;rgSupportedSocialMediaTypes&quot;:[{&quot;type&quot;:&quot;discord_server&quot;},{&quot;type&quot;:&quot;youtube&quot;},{&quot;type&quot;:&quot;facebook&quot;},{&quot;type&quot;:&quot;twitter&quot;},{&quot;type&quot;:&quot;twitch&quot;},{&quot;type&quot;:&quot;reddit&quot;},{&quot;type&quot;:&quot;instagram&quot;},{&quot;type&quot;:&quot;tumblr&quot;},{&quot;type&quot;:&quot;qq&quot;},{&quot;type&quot;:&quot;qqlink&quot;},{&quot;type&quot;:&quot;qqchannel&quot;},{&quot;type&quot;:&quot;bilibili&quot;},{&quot;type&quot;:&quot;weibo&quot;},{&quot;type&quot;:&quot;wechat&quot;},{&quot;type&quot;:&quot;tieba&quot;},{&quot;type&quot;:&quot;tiktok&quot;},{&quot;type&quot;:&quot;douyin&quot;},{&quot;type&quot;:&quot;bluesky&quot;},{&quot;type&quot;:&quot;mastodon&quot;},{&quot;type&quot;:&quot;threads&quot;},{&quot;type&quot;:&quot;vk&quot;},{&quot;type&quot;:&quot;telegram&quot;},{&quot;type&quot;:&quot;linkedin&quot;},{&quot;type&quot;:&quot;rednote&quot;}],&quot;rgValidationData&quot;:{&quot;discord_server&quot;:{&quot;prefix&quot;:[&quot;https://discord.com/invite/&quot;,&quot;https://discord.gg/&quot;]},&quot;youtube&quot;:{&quot;prefix&quot;:[&quot;https://youtube.com/&quot;,&quot;https://www.youtube.com/&quot;]},&quot;facebook&quot;:{&quot;prefix&quot;:[&quot;https://facebook.com/&quot;,&quot;https://www.facebook.com/&quot;]},&quot;twitter&quot;:{&quot;prefix&quot;:[&quot;https://x.com/&quot;]},&quot;twitch&quot;:{&quot;prefix&quot;:[&quot;https://twitch.tv/&quot;,&quot;https://www.twitch.tv/&quot;]},&quot;reddit&quot;:{&quot;prefix&quot;:[&quot;https://reddit.com/r/&quot;,&quot;https://www.reddit.com/r/&quot;]},&quot;instagram&quot;:{&quot;prefix&quot;:[&quot;https://instagram.com/&quot;,&quot;https://www.instagram.com/&quot;]},&quot;tumblr&quot;:{&quot;regex&quot;:[&quot;/https:\\\\/\\\\/[a-z0-9_\\\\-]+\\\\.tumblr\\\\.com/i&quot;]},&quot;qq&quot;:{&quot;number&quot;:{&quot;maxLength&quot;:16}},&quot;qqlink&quot;:{&quot;prefix&quot;:[&quot;https://qm.qq.com/&quot;]},&quot;qqchannel&quot;:{&quot;prefix&quot;:[&quot;https://pd.qq.com/&quot;]},&quot;bilibili&quot;:{&quot;prefix&quot;:[&quot;https://space.bilibili.com/&quot;]},&quot;weibo&quot;:{&quot;prefix&quot;:[&quot;https://weibo.com/&quot;,&quot;https://www.weibo.com/&quot;]},&quot;wechat&quot;:{&quot;text&quot;:{&quot;maxLength&quot;:40}},&quot;tieba&quot;:{&quot;prefix&quot;:[&quot;https://tieba.baidu.com/&quot;]},&quot;tiktok&quot;:{&quot;prefix&quot;:[&quot;https://tiktok.com/@&quot;,&quot;https://www.tiktok.com/@&quot;]},&quot;douyin&quot;:{&quot;prefix&quot;:[&quot;https://douyin.com/&quot;,&quot;https://v.douyin.com/&quot;,&quot;https://www.douyin.com/&quot;]},&quot;bluesky&quot;:{&quot;prefix&quot;:[&quot;https://bsky.app/profile/&quot;]},&quot;mastodon&quot;:{&quot;prefix&quot;:[&quot;https://mastodon.social/@&quot;,&quot;https://mastodon.online/@&quot;,&quot;https://mstdn.social/@&quot;,&quot;https://mstdn.games/@&quot;,&quot;https://mastodon.gamedev.place/@&quot;]},&quot;threads&quot;:{&quot;prefix&quot;:[&quot;https://threads.net/@&quot;,&quot;https://www.threads.net/@&quot;,&quot;https://threads.com/@&quot;,&quot;https://www.threads.com/@&quot;]},&quot;vk&quot;:{&quot;prefix&quot;:[&quot;https://vk.com/&quot;,&quot;https://www.vk.com/&quot;]},&quot;telegram&quot;:{&quot;prefix&quot;:[&quot;https://t.me/&quot;]},&quot;linkedin&quot;:{&quot;prefix&quot;:[&quot;https://linkedin.com/&quot;,&quot;https://www.linkedin.com/&quot;]},&quot;rednote&quot;:{&quot;prefix&quot;:[&quot;https://www.xiaohongshu.com/user/profile/&quot;]}}}\"></div>\t\t\t\t</div>\n\t\t\t\n\t\t\t\t\t\t\t<div class=\"subsection\" id=\"compat_links\">\n\t\t\t\t\t<h2>Steam Deck Compatibility Info</h2>\n\t\t\t\t\t<div class=\"grayRule\"> </div>\n\t\t\t\t\t<div class=\"sectionDescription\">You may want to provide customers with extra details about your game's Steam Deck compatibility, or share your plans. One way to share such information is by posting a Steam Event about your game's Steam Deck compatibility, and have that link included in your game's Steam Deck compatibility detail display. <a href=\"https://partner.steamgames.com/doc/steamdeck/compat#AddingSteamEvent\">Click here to learn more</a></div>\n\n\t\t\t\t\t<div class=\"formrow\">\n\t\t\t\t\t\t<div class=\"formlabel\">\n\t\t\t\t\t\t\tSteam Deck Compat Info <span class=\"ttip small\"  data-tooltip-text=\"Provide a link to a post on your Steam Community blog where you can discuss this game's current and future compatibility with Steam Deck\" >(?)</span>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class=\"formdata\">\n\t\t\t\t\t\t\t<input type=\"text\" name=\"app[content][links][steam_deck_blog_url]\" value=\"\" size=\"75\">\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\n\t\t\t\t\t\t\t\t\t</div>\n\n\t\t<div class=\"section SysReqs\"><a name=\"SysReqs\"></a>\n\t\t\t\t<h2>Supported Platforms<span class=\"required\">*</span></h2>\n\t\t<div class=\"grayRule\"> </div>\n\n\t\t\n\t\t\t\t\t<div class=\"subsection\" id=\"SysReqPlatforms\"  >\n\t\t\t\t<div class=\"formrow\">\n\t\t\t\t\t\t\t\t\t\t<div class=\"formlabel\">Platforms:<span class=\"required\">*</span></div>\n\t\t\t\t\t<div class=\"formdata shaded\">\n\t\t\t\t\t\t<div class=\"innerformrow\">\n\t\t\t\t\t\t\t\t\t<a id=\"checkbox_app_platforms_win_\" href=\"javascript:ToggleCheckbox('checkbox_app_platforms_win_');\" class=\"fancyCheckbox noformatting\" style=\"\">\n\t\t<input type=\"hidden\" name=\"app[platforms][win]\" value=\"1\" onchange=\"OnPlatformChanged( 'win' )\" id=\"checkbox_app_platforms_win__input\" >\n\t\t<img id=\"checkbox_app_platforms_win__unchecked\" src=\"https://partner.steamgames.com/public/images/admin_cb_default.gif\" style=\"display: none;\" alt=\"\">\n\t\t<img id=\"checkbox_app_platforms_win__checked\" src=\"https://partner.steamgames.com/public/images/admin_cb_default_checked.gif\" style=\"\" alt=\"x\">\n\t\t\t\t\t<span class=\"fancyCheckboxLabel\">Windows\t\t\t\n\t\t\t\t\t\t</span>\n\t\t\t\t</a>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class=\"innerformrow\">\n\t\t\t\t\t\t\t\t\t<a id=\"checkbox_app_platforms_mac_\" href=\"javascript:ToggleCheckbox('checkbox_app_platforms_mac_');\" class=\"fancyCheckbox noformatting\" style=\"\">\n\t\t<input type=\"hidden\" name=\"app[platforms][mac]\" value=\"\" onchange=\"OnPlatformChanged( 'mac' )\" id=\"checkbox_app_platforms_mac__input\" >\n\t\t<img id=\"checkbox_app_platforms_mac__unchecked\" src=\"https://partner.steamgames.com/public/images/admin_cb_default.gif\" style=\"\" alt=\"\">\n\t\t<img id=\"checkbox_app_platforms_mac__checked\" src=\"https://partner.steamgames.com/public/images/admin_cb_default_checked.gif\" style=\"display: none;\" alt=\"x\">\n\t\t\t\t\t<span class=\"fancyCheckboxLabel\">macOS\t\t\t\n\t\t\t\t\t\t</span>\n\t\t\t\t</a>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class=\"innerformrow\">\n\t\t\t\t\t\t\t\t\t<a id=\"checkbox_app_platforms_linux_\" href=\"javascript:ToggleCheckbox('checkbox_app_platforms_linux_');\" class=\"fancyCheckbox noformatting\" style=\"\">\n\t\t<input type=\"hidden\" name=\"app[platforms][linux]\" value=\"\" onchange=\"OnPlatformChanged( 'linux' )\" id=\"checkbox_app_platforms_linux__input\" >\n\t\t<img id=\"checkbox_app_platforms_linux__unchecked\" src=\"https://partner.steamgames.com/public/images/admin_cb_default.gif\" style=\"\" alt=\"\">\n\t\t<img id=\"checkbox_app_platforms_linux__checked\" src=\"https://partner.steamgames.com/public/images/admin_cb_default_checked.gif\" style=\"display: none;\" alt=\"x\">\n\t\t\t\t\t<span class=\"fancyCheckboxLabel\">Linux + SteamOS\t\t\t\n\t\t\t\t\t\t</span>\n\t\t\t\t</a>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class=\"innerformrow\">\n\t\t\t\t\t\t\t\t\t<a id=\"checkbox_app_platforms_android_\" href=\"javascript:ToggleCheckbox('checkbox_app_platforms_android_');\" class=\"fancyCheckbox noformatting\" style=\"\">\n\t\t<input type=\"hidden\" name=\"app[platforms][android]\" value=\"\" onchange=\"OnPlatformChanged( 'android' )\" id=\"checkbox_app_platforms_android__input\" >\n\t\t<img id=\"checkbox_app_platforms_android__unchecked\" src=\"https://partner.steamgames.com/public/images/admin_cb_default.gif\" style=\"\" alt=\"\">\n\t\t<img id=\"checkbox_app_platforms_android__checked\" src=\"https://partner.steamgames.com/public/images/admin_cb_default_checked.gif\" style=\"display: none;\" alt=\"x\">\n\t\t\t\t\t<span class=\"fancyCheckboxLabel\">Android <span style=\"color: #AC966A\">(only VR titles optimized for Steam Frame Standalone play)</span>\t\t\t\n\t\t\t\t\t\t</span>\n\t\t\t\t</a>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t\n\t\t\n\t\t\t\t\t<div id=\"SysReqWrapper\"   >\n\t\t\t\t<div class=\"formrow\">\n\t\t\t\t\t<div class=\"formlabel\">&nbsp;</div>\n\t\t\t\t\t<div class=\"formdata formdoubledata left\" style=\"width: 500px; font-weight: bold\">\n\t\t\t\t\t\t<span>Minimum System Requirements</span>\n\t\t\t\t\t\t<select id=\"MinSysReqLangSelect_select\" class=\"LocTextAreaLangSelect\" onchange=\"OnLocLanguageSelect( 'MinSysReqLangSelect' )\"><option value=\"english\">English</option><option value=\"french\">French</option><option value=\"italian\">Italian</option><option value=\"german\">German</option><option value=\"spanish\">Spanish - Spain</option><option value=\"bulgarian\">Bulgarian</option><option value=\"czech\">Czech</option><option value=\"danish\">Danish</option><option value=\"dutch\">Dutch</option><option value=\"finnish\">Finnish</option><option value=\"greek\">Greek</option><option value=\"hungarian\">Hungarian</option><option value=\"indonesian\">Indonesian</option><option value=\"japanese\">Japanese</o