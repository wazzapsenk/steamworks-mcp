 ) {\n\t\t\trootList[ x ].disabled = osSelected != 'MacOS';\n\t\t}\n\t\tif ( 'MacAppSupport' == rootEntry ) {\n\t\t\trootList[ x ].disabled = osSelected != 'MacOS';\n\t\t}\n\t\tif ( 'MacDocuments' == rootEntry ) {\n\t\t\trootList[ x ].disabled = osSelected != 'MacOS';\n\t\t}\n\t\tif ( 'LinuxHome' == rootEntry ) {\n\t\t\trootList[ x ].disabled = osSelected != 'Linux';\n\t\t}\n\t\tif ( 'LinuxXdgDataHome' == rootEntry ) {\n\t\t\trootList[ x ].disabled = osSelected != 'Linux';\n\t\t}\n\t\tif ( 'LinuxXdgConfigHome' == rootEntry ) {\n\t\t\trootList[ x ].disabled = osSelected != 'Linux';\n\t\t}\n\t\tif ( 'AndroidExternalData' == rootEntry ) {\n\t\t\trootList[ x ].disabled = osSelected != 'Android';\n\t\t}\n\t\tif ( 'AndroidInternalData' == rootEntry ) {\n\t\t\trootList[ x ].disabled = osSelected != 'Android';\n\t\t}\n\n\t\tif ( rootList[ x ].disabled && rootList[ x ].selected )\n\t\t\trootList[ x ].selected = false;\n\t}\n}\n\nfunction EditAutoCloudPath( formName, bDisabled )\n{\n\tvar settingTypes = [\"root\", \"path\", \"pattern\", \"oslist\", \"recursive\"];\n\tEditForm( formName, bDisabled, settingTypes );\n}\n\nfunction EditAutoCloudOverride( formName, bDisabled )\n{\n\tvar settingTypes = [\"root\", \"os\", \"useinstead\", \"addpath\", \"replacepath\"];\n\tEditForm( formName, bDisabled, settingTypes );\n\n\tOnRootOverrideOSChange( formName );\n}\n\nfunction SetAutoCloudPath( appid, index, root, path, pattern, oslist, recursive )\n{\n    bIsDelete = root == '' && path == '' && pattern == '';\n    if( !bIsDelete || confirm( \"Delete Auto-Cloud Path '%1$s'?\".replace('%1$s', index ) ) )\n    {\n\t\tif( bIsDelete || ( root != '' && pattern != '' ) )\n        {\n\t\t\tAppsAjaxRequest( 'https://partner.steamgames.com/apps/setautocloudpath/' + appid ,\n\t\t\t{\n\t\t\t\t'index' : index,\n\t\t\t \t'root' : root,\n\t\t\t \t'path' : path,\n\t\t\t \t'pattern' : pattern,\n\t\t\t\t'oslist' : oslist,\n\t\t\t\t'recursive' : recursive\n\t\t\t},\n\t\t\t\tfunction( results )\n\t\t\t\t{\n\t\t\t\t\tStandardCallback( results, 'AjaxOutput' );\n\n\t\t\t\t\tif ( results[ 'success' ] )\n\t\t\t\t\t{\n\t\t\t\t\t\t// no error, reload page\n\t\t\t\t\t\t$('AjaxOutput').innerHTML = \"Reloading...\";\n\t\t\t\t\t\tRefreshCallback( results );\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t);\n\t\t}\n\t\telse\n\t\t{\n\t\t\t// invalid parameter\n\t\t\t// no error, reload page\n\t\t\tShowAlertDialog( 'Error', \"Update failed.  Please enter all required fields: root, path, and pattern.\" );\n\t\t}\n    }\n}\n\nfunction SetAutoCloudOverride( appid, index, root, os, useinstead, addpath, replacepath )\n{\n\tbIsDelete = root == '' && os == '';\n\tif( !bIsDelete || confirm( \"Delete Auto-Cloud Override '%1$s'?\".replace('%1$s', index  ) ) )\n\t{\n\t\tif(bIsDelete || ( root != ''  && useinstead != '' ) )\n\t\t{\n\n\t\t\tAppsAjaxRequest( 'https://partner.steamgames.com/apps/setautocloudoverride/' + appid ,\n\t\t\t\t{\n\t\t\t\t\t'index' : index,\n\t\t\t\t\t'root' : root,\n\t\t\t\t\t'os' : os,\n\t\t\t\t\t'useinstead' : useinstead,\n\t\t\t\t\t'addpath' : addpath,\n\t\t\t\t\t'replacepath': replacepath\n\t\t\t\t},\n\t\t\t\tfunction( results )\n\t\t\t\t{\n\t\t\t\t\tStandardCallback( results, 'AjaxOutput' );\n\n\t\t\t\t\tif ( results[ 'success' ] )\n\t\t\t\t\t{\n\t\t\t\t\t\t// no error, reload page\n\t\t\t\t\t\t$('AjaxOutput').innerHTML = \"Reloading...\";\n\t\t\t\t\t\tRefreshCallback( results );\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t);\n\t\t}\n\t\telse\n\t\t{\n\t\t\t// invalid parameter\n\t\t\t// no error, reload page\n\t\t\t$('AjaxOutput').innerHTML = \"Update failed.  Please enter all required fields: root, path, and pattern.\";\n\t\t\tRefreshCallback( results );\n\t\t}\n\t}\n}</script>\n\n<body>\n<div id=\"pageContainer\">\n\n<script type=\"text/javascript\">\n\t$J( InitMiniprofileHovers( 'https%3A%2F%2Fpartner.steamgames.com' ) );\n    \tg_sessionID = \"ffffffffffffffffffff0001\";\n</script>\n<!-- anyone using landing_header needs to ensure jquery is loaded prior -->\n<script type=\"text/javascript