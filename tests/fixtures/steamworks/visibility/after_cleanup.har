            "text": "<!DOCTYPE HTML>\n<html lang=\"en\">\n<head>\n\t<link type=\"image/x-icon\" href=\"https://partner.steamgames.com/public/favicon.ico\" rel=\"shortcut icon\"/>\n\t<meta http-equiv=\"Content-Type\" content=\"text/html; charset=utf-8\" />\n\t<title>Revision History: ExampleGame (1000000)</title>\n\n\t<link href=\"https://partner.steamgames.com/public/shared/css/motiva_sans.css?v=KTK74ReHHKmw&amp;l=english&amp;_cdn=akamai\" rel=\"stylesheet\" type=\"text/css\">\n<link href=\"https://partner.steamgames.com/public/shared/css/shared_responsive.css?v=kFn-RZDir5Cd&amp;l=english&amp;_cdn=akamai\" rel=\"stylesheet\" type=\"text/css\">\n<link href=\"https://partner.steamgames.com/public/shared/css/shared_global.css?v=4or_qc2r63lc&amp;l=english&amp;_cdn=akamai\" rel=\"stylesheet\" type=\"text/css\">\n<link href=\"https://partner.steamgames.com/public/shared/css/buttons.css?v=2sBDtpw6TQk_&amp;l=english&amp;_cdn=akamai\" rel=\"stylesheet\" type=\"text/css\">\n<link href=\"https://partner.steamgames.com/public/css/styles_global.css?v=c1zwuLqYwx85&amp;l=english&amp;_cdn=akamai\" rel=\"stylesheet\" type=\"text/css\">\n<link href=\"https://partner.steamgames.com/public/css/header.css?v=_ew63an-mUEs&amp;l=english&amp;_cdn=akamai\" rel=\"stylesheet\" type=\"text/css\">\n<link href=\"https://partner.steamgames.com/public/css/styles_admin.css?v=zLeAHgusYCgI&amp;l=english&amp;_cdn=akamai\" rel=\"stylesheet\" type=\"text/css\">\n<link href=\"https://partner.steamgames.com/public/css/styles_marketing.css?v=eOQWOuSxu72z&amp;l=english&amp;_cdn=akamai\" rel=\"stylesheet\" type=\"text/css\">\n<link href=\"https://partner.steamgames.com/public/css/styles_landing.css?v=Bo4lTA_HN0H6&amp;l=english&amp;_cdn=akamai\" rel=\"stylesheet\" type=\"text/css\">\n<!--[if lte IE 7]> <style type=\"text/css\"> .iepopupfix{ display: block; } </style> <![endif]-->\n\t<link href=\"https://partner.steamgames.com/public/css/styles_print.css?v=tVP8-D1reM_K&amp;l=english&amp;_cdn=akamai\" rel=\"stylesheet\" type=\"text/css\"media=\"print\">\n\t<style type=\"text/css\">\n\t\t#pageContainer, #mainbody, body, html {\n\t\t\tmin-height:100%;\n\t\t}\n\t</style>\n\t<!--[if lt IE 7]>\n\t<style type=\"text/css\">\n\t\t#pageContainer {\n\t\t\theight:100%;\n\t\t}\n\t</style>\n\t<![endif]-->\n\t<script type=\"text/javascript\">\n\tvar __PrototypePreserve=[];\n\t__PrototypePreserve[0] = Array.from;\n\t__PrototypePreserve[1] = Array.prototype.filter;\n\t__PrototypePreserve[2] = Array.prototype.flatMap;\n\t__PrototypePreserve[3] = Array.prototype.find;\n\t__PrototypePreserve[4] = Array.prototype.some;\n\t__PrototypePreserve[5] = Function.prototype.bind;\n\t__PrototypePreserve[6] = HTMLElement.prototype.scrollTo;\n</script>\n<script type=\"text/javascript\" src=\"https://partner.steamgames.com/public/javascript/prototype-1.7.js?v=NoPN2evpJxBK&amp;l=english&amp;_cdn=akamai\"></script>\n<script type=\"text/javascript\">\n\tArray.from = __PrototypePreserve[0] || Array.from;\n\tArray.prototype.filter = __PrototypePreserve[1] || Array.prototype.filter;\n\tArray.prototype.flatMap = __PrototypePreserve[2] || Array.prototype.flatMap;\n\tArray.prototype.find = __PrototypePreserve[3] || Array.prototype.find;\n\tArray.prototype.some = __PrototypePreserve[4] || Array.prototype.some;\n\tFunction.prototype.bind = __PrototypePreserve[5] || Function.prototype.bind;\n\tHTMLElement.prototype.scrollTo = __PrototypePreserve[6] || HTMLElement.prototype.scrollTo;\n</script>\n<script type=\"text/javascript\">\n\tvar __ScriptaculousPreserve=[];\n\t__ScriptaculousPreserve[0] = Array.from;\n\t__ScriptaculousPreserve[1] = Function.prototype.bind;\n\t__ScriptaculousPreserve[2] = HTMLElement.prototype.scrollTo;\n</script>\n<script type=\"text/javascript\" src=\"https://partner.steamgames.com/public/javascript/scriptaculous/scriptaculous.js?v=-nDWlglugcxc&amp;l=english&amp;_cdn=akamai\"></script>\n<script type=\"text/javascript\">\n\tArray.from = __ScriptaculousPreserve[0] || Array.from;\n\tFunction.prototype.bind = __ScriptaculousPreserve[1] || Function.prototype.bind;\n\tHTMLElement.prototype.scrollTo = __ScriptaculousPreserve[2] || HTMLElement.prototype.scrollTo;\ndelete String['__parseStyleElement'];  Prototype.Browser.WebKit = true;</script>\n<script type=\"text/javascript\" src=\"https://partner.steamgames.com/public/javascript/scriptaculous_addons.js?v=MXCmf4f6B0Sa&amp;l=english&amp;_cdn=akamai\"></script>\n<script type=\"text/javascript\">Object.seal && [ Object, Array, String, Number ].map( function( builtin ) { Object.seal( builtin.prototype ); } );</script><script type=\"text/javascript\" src=\"https://partner.steamgames.com/public/javascript/marketing.js?v=gL5NY0WC6OYI&amp;l=english&amp;_cdn=akamai\"></script>\n\n<script type=\"text/javascript\" src=\"https://partner.steamgames.com/public/javascript/storeadmin.js?v=Se20y3-xsTJy&amp;l=english&amp;_cdn=akamai\"></script>\n\n<script type=\"text/javascript\" src=\"https://partner.steamgames.com/public/javascript/admin.js?v=lMxQ0nFXvFTx&amp;l=english&amp;_cdn=akamai\"></script>\n\n<script type=\"text/javascript\" src=\"https://partner.steamgames.com/public/javascript/webtoolkit.aim.js?v=ZQ03s8ex0ABq&amp;l=english&amp;_cdn=akamai\"></script>\n\n<script type=\"text/javascript\" src=\"https://partner.steamgames.com/public/javascript/newsadmin.js?v=ib6aUpGud549&amp;l=english&amp;_cdn=akamai\"></script>\n\n<script type=\"text/javascript\" src=\"https://partner.steamgames.com/public/javascript/jquery-1.8.3.js?v=hslOGuAZoPRK&amp;l=english&amp;_cdn=akamai\"></script>\n\n<script type=\"text/javascript\" src=\"https://partner.steamgames.com/public/shared/javascript/tooltip.js?v=a9q1REOJMDBo&amp;l=english&amp;_cdn=akamai\"></script>\n\n<script type=\"text/javascript\" src=\"https://partner.steamgames.com/public/shared/javascript/shared_global.js?v=ABylLOrGN4B_&amp;l=english&amp;_cdn=akamai\"></script>\n\n<script type=\"text/javascript\" src=\"https://partner.steamgames.com/public/shared/javascript/shared_responsive_adapter.js?v=asNZNxt9kVQn&amp;l=english&amp;_cdn=akamai\"></script>\n\n<script type=\"text/javascript\">$J = jQuery.noConflict();\n\t\t\tdocument.addEventListener('DOMContentLoaded', function(event) {\n\t\t\t\tSetupTooltips( { tooltipCSSClass: 'jsTooltip'} );\n\t\t\t});</script>\t<script type=\"text/javascript\" src=\"https://partner.steamgames.com/public/shared/javascript/tooltip.js?v=a9q1REOJMDBo&amp;l=english&amp;_cdn=akamai\"></script>\n\t<script type=\"text/javascript\" src=\"https://partner.steamgames.com/public/shared/javascript/diff_match_patch.js?v=b11075398&amp;l=english&amp;_cdn=akamai\"></script>\n\t<script type=\"text/javascript\" src=\"https://partner.steamgames.com/public/shared/javascript/diff_utils.js?v=k0cYmh9E4E7W&amp;l=english&amp;_cdn=akamai\"></script>\n\t<script>\n\n\t\tfunction RequestAppInfoSectionRevision( sectionid, revision, callback )\n\t\t{\n\t\t\tnew Ajax.Request( 'https://partner.steamgames.com/apps/ajaxgetappsectionrevision/1000000',\n\t\t\t\t{\n\t\t\t\t\tmethod: 'POST',\n\t\t\t\t\tparameters: {\n\t\t\t\t\t\t'sessionid' : g_sessionID,\n\t\t\t\t\t\t'sectionid' : sectionid,\n\t\t\t\t\t\t'revision' : revision\n\t\t\t\t\t},\n\t\t\t\t\tonSuccess: function( transport )\n\t\t\t\t\t{\n\t\t\t\t\t\tvar results = transport.responseJSON;\n\t\t\t\t\t\tif ( results.success == 1 )\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\tcallback( results );\n\t\t\t\t\t\t}\n\t\t\t\t\t\telse\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\tShowAlertDialog( 'Error', 'There was a problem retrieving data for app section: ' + sectionid + ' revision: ' + revision );\n\t\t\t\t\t\t}\n\t\t\t\t\t}\n\t\t\t\t} );\n\t\t}\n\n\t\tfunction GetAppInfoSectionTitle( results )\n\t\t{\n\t\t\treturn results.section_name + ' revision ' + results.revision + ( results.committed ? '' : ' (pending)' );\n\t\t}\n\n\t\tfunction ViewAppInfoSectionRevision( sectionid, revision )\n\t\t{\n\t\t\tvar dialogWait = ShowBlockingWaitDialog( 'Please Wait', 'Loading section data...' );\n\t\t\tRequestAppInfoSectionRevision( sectionid, revision,\n\t\t\t\tfunction( results ) {\n\t\t\t\t\tdialogWait.Dismiss();\n\n\t\t\t\t\tvar textarea = $J('<textarea/>', {'cols' : 150, 'rows' : 25, 'readonly' : 'readonly', 'wrap' : 'off' });\n\t\t\t\t\ttextarea.text( results.section );\n\t\t\t\t\tvar dialog = ShowAlertDialog( GetAppInfoSectionTitle( results ), textarea );\n\t\t\t\t}\n\t\t\t);\n\t\t}\n\n\t\tfunction DisplayDiffs( resultsA, resultsB )\n\t\t{\n\t\t\tdisplay_diffs( GetAppInfoSectionTitle( resultsA ), GetAppInfoSectionTitle( resultsB ), resultsA.section, resultsB.section );\n\t\t}\n\n\t\tfunction ViewSectionHistory( sectionid )\n\t\t{\n\t\t\tvar dialogWait = ShowBlockingWaitDialog( 'Please Wait', 'Loading section history...' );\n\n\t\t\tnew Ajax.Request( 'https://partner.steamgames.com/apps/ajaxgetappsectionhistory/1000000',\n\t\t\t\t{\n\t\t\t\t\tmethod: 'POST',\n\t\t\t\t\tparameters: {\n\t\t\t\t\t\t'sessionid' : g_sessionID,\n\t\t\t\t\t\t'sectionid' : sectionid\n\t\t\t\t\t},\n\t\t\t\t\tonSuccess: function( transport )\n\t\t\t\t\t{\n\t\t\t\t\t\tdialogWait.Dismiss();\n\t\t\t\t\t\tShowAlertDialog( 'Section History', transport.responseText );\n\t\t\t\t\t},\n\t\t\t\t\tonFailure: function( transport )\n\t\t\t\t\t{\n\t\t\t\t\t\tdialogWait.Dismiss();\n\t\t\t\t\t\tShowAlertDialog( 'Error', 'There was an error attempting to retrieve the app section history.' );\n\t\t\t\t\t}\n\t\t\t\t} );\n\t\t}\n\n\t\tfunction DiffAgainstCommitted( sectionid, revision )\n\t\t{\n\t\t\tvar dialogWait = ShowBlockingWaitDialog( 'Please Wait', 'Loading section data...' );\n\t\t\t// request both\n\t\t\tRequestAppInfoSectionRevision( sectionid, revision - 1,\n\t\t\t\tfunction( results )\t{\n\t\t\t\t\tresultsA = results;\n\t\t\t\t\tRequestAppInfoSectionRevision( sectionid, revision,\n\t\t\t\t\t\tfunction( results ) {\n\t\t\t\t\t\t\tresultsB = results;\n\t\t\t\t\t\t\tdialogWait.Dismiss();\n\t\t\t\t\t\t\tDisplayDiffs( resultsA, resultsB );\n\t\t\t\t\t\t}\n\t\t\t\t\t);\n\t\t\t\t}\n\t\t\t);\n\t\t}\n\n\t\tfunction RevertChanges( sectionName, sectionid, revision )\n\t\t{\n\t\t\tvar confirmDialog = ShowConfirmDialog( 'Revert Changes?', 'Are you you sure you want to revert the changes to the \"' + sectionName + '\" section? This cannot be undone!' );\n\t\t\tconfirmDialog.done( function() {\n\t\t\t\tvar dialogWait = ShowBlockingWaitDialog( 'Please Wait', 'Reverting changes for section \"' + sectionName + '\"...' );\n\t\t\t\tnew Ajax.Request( 'https://partner.steamgames.com/apps/ajaxrevertchangesappsection/1000000',\n\t\t\t\t\t{\n\t\t\t\t\t\tmethod: 'POST',\n\t\t\t\t\t\tparameters: {\n\t\t\t\t\t\t\t'sessionid' : g_sessionID,\n\t\t\t\t\t\t\t'sectionid' : sectionid\n\t\t\t\t\t\t},\n\t\t\t\t\t\tonSuccess: function( transport )\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\tdialogWait.Dismiss();\n\t\t\t\t\t\t\ttop.location.reload();\n\t\t\t\t\t\t},\n\t\t\t\t\t\tonFailure: function( transport )\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\tdialogWait.Dismiss();\n\t\t\t\t\t\t\tShowAlertDialog( 'Error', 'There was an error attempting to retrieve the app section history.' );\n\t\t\t\t\t\t}\n\t\t\t\t\t} );\n\t\t\t} );\n\n\t\t}\n\n\t\t\t</script>\n</head>\n<body>\n<div id=\"pageContainer\">\n\t<!-- header -->\n\t<script type=\"text/javascript\">\n\t$J( InitMiniprofileHovers( 'https%3A%2F%2Fpartner.steamgames.com' ) );\n    \tg_sessionID = \"ffffffffffffffffffff0001\";\n</script>\n<!-- anyone using landing_header needs to ensure jquery is loaded prior -->\n<script type=\"text/javascript\" src=\"https://partner.steamgames.com/public/javascript/jquery.cookie.js?v=ND_3CW4DxZHp&amp;l=english&amp;_cdn=akamai\"></script>\n<script type=\"text/javascript\">\n\tg_sessionID = \"ffffffffffffffffffff0001\";\n\tg_rgAllAffiliatedPublishers = {\"900000\":\"Redacted\"};\n\tg_nPrimaryPublisher = 900000;\n\n\tfunction GoToEditPage( page, id )\n\t{\n\t\tif ( checkNumeric( id ) )\n\t\t{\n\t\t\twindow.location.href = \"https://partner.steamgames.com/apps/\" + page + \"/\" + id;\n\t\t}\n\t}\n\n\tfunction checkNumeric( value )\n\t{\n\t\tvar anum=/(^\\d+$)|(^\\d+\\.\\d+$)/\n\t\tif (anum.test(value))\n\t\t\treturn true;\n\t\treturn false;\n\t}\n</script>\n\t<div id=\"headerContainer\" data-config=\"{&quot;EUNIVERSE&quot;:1,&quot;WEB_UNIVERSE&quot;:&quot;public&quot;,&quot;LANGUAGE&quot;:&quot;english&quot;,&quot;COUNTRY&quot;:&quot;TR&quot;,&quot;MEDIA_CDN_COMMUNITY_URL&quot;:&quot;https:\\/\\/shared.akamai.steamstatic.com\\/community_assets\\/&quot;,&quot;MEDIA_CDN_URL&quot;:&quot;https:\\/\\/cdn.akamai.steamstatic.com\\/&quot;,&quot;VIDEO_CDN_URL&quot;:&quot;https:\\/\\/video.akamai.steamstatic.com\\/&quot;,&quot;COMMUNITY_CDN_URL&quot;:&quot;https:\\/\\/community.akamai.steamstatic.com\\/&quot;,&quot;COMMUNITY_CDN_ASSET_URL&quot;:&quot;https:\\/\\/cdn.akamai.steamstatic.com\\/appmgmt\\/&quot;,&quot;STORE_CDN_URL&quot;:&quot;https:\\/\\/store.akamai.steamstatic.com\\/&quot;,&quot;PUBLIC_SHARED_URL&quot;:&quot;https:\\/\\/store.akamai.steamstatic.com\\/public\\/shared\\/&quot;,&quot;COMMUNITY_BASE_URL&quot;:&quot;https:\\/\\/steamcommunity.com\\/&quot;,&quot;CHAT_BASE_URL&quot;:&quot;https:\\/\\/steamcommunity.com\\/&quot;,&quot;STORE_BASE_URL&quot;:&quot;https:\\/\\/store.steampowered.com\\/&quot;,&quot;STORE_CHECKOUT_BASE_URL&quot;:&quot;https:\\/\\/checkout.steampowered.com\\/&quot;,&quot;IMG_URL&quot;:&quot;https:\\/\\/partner.steamgames.com\\/public\\/images\\/&quot;,&quot;STEAMTV_BASE_URL&quot;:&quot;https:\\/\\/steam.tv\\/&quot;,&quot;HELP_BASE_URL&quot;:&quot;https:\\/\\/help.steampowered.com\\/&quot;,&quot;PARTNER_BASE_URL&quot;:&quot;https:\\/\\/partner.steamgames.com\\/&quot;,&quot;STATS_BASE_URL&quot;:&quot;https:\\/\\/partner.steampowered.com\\/&quot;,&quot;INTERNAL_STATS_BASE_URL&quot;:&quot;https:\\/\\/steamstats.valve.org\\/&quot;,&quot;IN_CLIENT&quot;:false,&quot;USE_POPUPS&quot;:false,&quot;STORE_ICON_BASE_URL&quot;:&quot;https:\\/\\/shared.akamai.steamstatic.com\\/store_item_assets\\/steam\\/apps\\/&quot;,&quot;STORE_ITEM_BASE_URL&quot;:&quot;https:\\/\\/shared.akamai.steamstatic.com\\/store_item_assets\\/&quot;,&quot;WE