\t\t\t\t$( \".datepicker\" ).datetimepicker({\n\t\t\t\tminDate: d,\n\t\t\t\tbeforeShowDay: $J.datepicker.noWeekends,\n\t\t\t\t'minute': 0,\n\t\t\t\t'showMinute': false,\n\t\t\t\t'showButtonPanel': false,\n\t\t\t\t'timezone': 0\n\t\t\t});\n\n\t\t\t$('#date_button').click(function() {\n\t\t\t\t$('#requested_release_date').datepicker('show');\n\t\t\t});\n\n\t\t\t$( \".datepickerCafe\" ).datepicker({\n\t\t\t\tdateFormat: 'yy-mm-dd',\n\t\t\t\tchangeMonth: true,\n\t\t\t\tchangeYear: true,\n\t\t\t\tminDate: new Date(2026, 9, 03)\n\t\t\t});\n\n\t\t});\n\n\t\tfunction MarkStorePageReadyForReview()\n\t\t{\n\t\t\tvar dialog = ShowPromptWithTextAreaDialog( \"Mark as Ready for Review\", '', null, null, 1000 );\n\t\t\tvar text_area = $J( dialog.m_$Content ).find( \"textarea\" );\n\t\t\ttext_area.before( $J( \"<div/>\", { html: \"Setting this product's store page as ready for review will add it to the queue for Valve's review team to test. Review of store pages typically takes 2-3 days.<br><br>This process will automatically generate a support ticket that you can use to communicate with our review team. We will e-mail you with any feedback or with approval.<br><br>You may leave notes below to help expedite testing time.\", style: \"font-size: 16px; padding-bottom: 10px\" } ) );\n\t\t\ttext_area.css({ height: '200px' });\n\n\t\t\tdialog.done( function( data )  {\n\t\t\t\tdata = v_trim( data );\n\t\t\t\tUpdateReleaseRequest(1000000, { 'ready_to_release': true, 'testing_notes' : data } );\n\t\t\t} );\n\t\t\treturn false;\n\t\t}\n\n\t\tfunction MarkBuildReadyForReview()\n\t\t{\n\t\t\tconst text_area = document.getElementById( \"confirm_build_ready_dialog_textarea\" );\n\t\t\tconst strData = v_trim( text_area.value );\n\t\t\tconst ajaxData = { sessionid: \"ffffffffffffffffffff0001\", notes: strData };\n\n\t\t\t$J.ajax({\n\t\t\t\turl: 'https://partner.steamgames.com/apps/markbuildforreview/1000000',\n\t\t\t\tcache: false,\n\t\t\t\tdata: ajaxData,\n\t\t\t\ttype: \"POST\",\n\t\t\t\terror: onAjaxFail,\n\t\t\t\tsuccess: function( response )\n\t\t\t\t{\n\t\t\t\t\tif( response.success == 1 )\n\t\t\t\t\t{\n\t\t\t\t\t\tlocation.reload();\n\t\t\t\t\t} else {\n\t\t\t\t\t\talert(\"An error was encountered while processing your request: %1$s\".replace('%1$s', response.message));\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t});\n\t\t}\n\n\t\tfunction BBrowserSupportsFormData()\n\t\t{\n\t\t\treturn (typeof FormData != 'undefined');\n\t\t}\n\n\t\tfunction MarkAsReadyForRelease()\n\t\t{\n\t\t\tif ( confirm('Set this application as ready for review?' ) )\n\t\t\t{\n\t\t\t\tif( bIsFreeGame && !bHasFreePackage )\n\t\t\t\t{\n\t\t\t\t\tif( !confirm( \"This game is marked as free but DOES NOT have a free package. Continue anyway?\" ) )\n\t\t\t\t\t\treturn;\n\t\t\t\t}\n\t\t\t\tUpdateReleaseRequest(1000000, { 'ready_to_release': true });\n\t\t\t}\n\t\t}\n\n\t\t\n\t\t\n\t\t\t\tfunction validateDate( strDate )\n\t\t{\n\t\t\tvar nTime = Date.parse(strDate) / 1000;\n\n\t\t\tfor( var i=0; i<rgBlockedOutDates.length; i++)\n\t\t\t{\n\t\t\t\tvar rgDateEndpoints = rgBlockedOutDates[i];\n\t\t\t\tif( nTime > rgDateEndpoints[0] && nTime < rgDateEndpoints[1])\n\t\t\t\t\treturn false;\n\t\t\t}\n\t\t\treturn true;\n\t\t}\n\n\n\n\n\n\t\n\n\n\n\n\t\tfunction ReleaseStep( nNewStep, strReleaseFormID = undefined )\n\t\t{\n\t\t\t$J('#releaseblock').show();\n\t\t\t$J('#release_label_step1').removeClass('active');\n\t\t\tif( nNewStep > 1 )\n\t\t\t\t$J('#release_label_step1').addClass('used');\n\n\t\t\t$J('#release_step1' ).hide();\n\n\t\t\t$J('#release_label_step2').removeClass('active');\n\t\t\tif( nNewStep > 2 )\n\t\t\t\t$J('#release_label_step2').addClass('used');\n\n\t\t\t$J('#release_step2' ).hide();\n\n\t\t\t$J('#release_step3' ).hide();\n\n\t\t\t$J('#release_label_step' + nNewStep ).addClass('active');\n\t\t\t$J('#release_label_step' + nNewStep ).removeClass('used');\n\t\t\t$J('#release_step' + nNewStep ).show();\n\n\t\t\t// Show the desired release form and hide all the others\n\t\t\tif ( strReleaseFormID )\n\t\t\t{\n\t\t\t\tfor ( const strFormID of [ 'comingsoon_form', 'prepurchase_release_form', 'preload_release_form', 'limitedlaunch_release_form', 'release_form' ] )\n\t\t\t\t{\n\t\t\t\t\tif ( strReleaseFormID === strFormID )\n\t\t\t\t\t\t$J( `#${strFormID}` ).show();\n\t\t\t\t\telse\n\t\t\t\t\t\t$J( `#${strFormID}` ).hide();\n\t\t\t\t}\n\t\t\t}\n\n\t\t}\n\n\t\tfunction CancelRelease()\n\t\t{\n\t\t\t$J('#releaseblock').hide();\n\t\t}\n\n\t\t//pieterw Steam China green button work:\n\t\tfunction SteamChinaReleaseStep( nNewStep )\n\t\t{\n\t\t\t$J('#releaseblock').show();\n\t\t\t$J('#release_label_step1').removeClass('active');\n\t\t\tif( nNewStep > 1 )\n\t\t\t\t$J('#release_label_step1').addClass('used');\n\n\t\t\t$J('#release_step1' ).hide();\n\n\t\t\t$J('#release_label_step2').removeClass('active');\n\t\t\tif( nNewStep > 2 )\n\t\t\t\t$J('#release_label_step2').addClass('used');\n\n\t\t\t$J('#release_step2' ).hide();\n\n\t\t\t$J('#release_step3' ).hide();\n\n\t\t\t$J('#release_label_step' + nNewStep ).addClass('active');\n\t\t\t$J('#release_label_step' + nNewStep ).removeClass('used');\n\t\t\t$J('#release_step' + nNewStep ).show();\n\t\t}\n\n\t\tfunction UpdateStandaloneDLCStatus( appid, active )\n\t\t{\n\t\t\tvar waitingDialog = ShowBlockingWaitDialog( 'Updating DLC Status...' );\n\t\t\t$J.ajax(\n\t\t\t\t{\n\t\t\t\t\ttype: \"POST\",\n\t\t\t\t\turl: 'https://partner.steamgames.com/apps/ajaxupdatestandalonedlcstatus/' + appid,\n\t\t\t\t\tdata: { 'nAppID' : appid, 'bActive' : active, 'sessionid' : g_sessionID },\n\t\t\t\t\tsuccess: function ( response ) {\n\t\t\t\t\t\tif ( response.success == 1 )\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\ttop.location.reload();\n\t\t\t\t\t\t}\n\t\t\t\t\t\telse\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\twaitingDialog.Dismiss();\n\t\t\t\t\t\t\tShowAlertDialog( 'Error', 'An error was encountered while processing your request: ' + response );\n\t\t\t\t\t\t}\n\t\t\t\t\t},\n\t\t\t\t\tfailure: function ( response ) {\n\t\t\t\t\t\tShowAlertDialog( 'Error', 'An error was encountered while processing your request: ' + response );\n\t\t\t\t\t}\n\n\t\t\t\t}\n\t\t\t);\n\t\t}\n\n\t\tfunction SendWishlistEmails(instance)\n\t\t{\n\t\t\t\t\t\tvar templateName = \"0\";\n\t\t\tif( $J(\"#mail_template_to_early_access\")[0]?.checked ) {\n\t\t\t\ttemplateName = \"2\";\n\t\t\t} else if ( $J(\"#mail_template_from_early_access\")[0]?.checked ) {\n\t\t\t\ttemplateName = \"1\";\n\t\t\t} else if ( $J(\"#mail_template_presale\")[0]?.checked ) {\n\t\t\t\ttemplateName = \"3\";\n\t\t\t} else if ( $J(\"#mail_template_demo\")[0]?.checked ) {\n\t\t\t\ttemplateName = \"4\";\n\t\t\t}\n\n\t\t\tvar countryList = $J(\"#mail_countries\").val();\n\t\t\tinstance.parentNode.innerHTML = \"Email Sent!\";\n\n\t\t\tnew Ajax.Updater( \"appOutput\", \"https://partner.steamgames.com/apps/sendnewreleasemail/1000000\",\n\t\t\t\t{ parameters: { appid: 1000000, parent_appid: 0, template: templateName, countries: countryList, sessionid: \"ffffffffffffffffffff0001\" } } );\n\t\t\treturn false;\n\t\t}\n\n\t\t\n\t\tfunction ShowCloneCommercialPackageDialog()\n\t\t{\n\t\t\t$J('#CommercialCloneModal').show();\n\t\t\t$J('#CommercialSelectModal').hide();\n\t\t\t$J('#CommercialLicenseModal').hide();\n\n\t\t\tvar dialog = ShowConfirmDialog( 'Add Commercial Package', $J('#CommercialModal').show(), false, false, '' );\n\n\t\t\tvar $Form = dialog.GetContent().find('form');\n\t\t\tdialog.SetRemoveContentOnDismissal( false );\n\t\t\tdialog.GetContent().css('width','800px');\n\t\t\tdialog.AdjustSizing();\n\t\t\tdialog.done( function( type ) {\n\t\t\t\tif ( type == 'SECONDARY' )\n\t\t\t\t{\n\t\t\t\t\t// User selected Advanced options\n\t\t\t\t\tShowAddCommercialDialog();\n\t\t\t\t}\n\t\t\t\telse\n\t\t\t\t{\n\t\t\t\t\t// Find which package they selected\n\t\t\t\t\tvar pkgid = false;\n\t\t\t\t\t$J('#CommercialCloneModal .fancyCheckbox').each(function() {\n\t\t\t\t\t\tvar id = $J(this).attr('id');\n\t\t\t\t\t\tif ( GetFancyCheckboxState( id ) )\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\tif ( confirm( 'Are you sure you want to create a commercial package from the selected Steam package?' ) )\n\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\tpkgid = parseInt( id.substring(15) );\t// id = 'checkbox_clone_' + pkgID\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t}\n\t\t\t\t\t});\n\n\t\t\t\t\tif ( !pkgid )\n\t\t\t\t\t{\n\t\t\t\t\t\talert( 'No package was selected.' );\n\t\t\t\t\t\treturn;\n\t\t\t\t\t}\n\n\t\t\t\t\t// Lets copy a package\n\t\t\t\t\tvar waitdialog = ShowBlockingWaitDialog( 'Add Commercial Package', 'Saving changes...' );\n\t\t\t\t\t$J.ajax({\n\t\t\t\t\t\ttype: \"POST\",\n\t\t\t\t\t\turl: \"https://partner.steamgames.com/apps/ajaxclonecommerciallicense/1000000/\",\n\t\t\t\t\t\tdata: { 'sessionid' : g_sessionID, 'package' : pkgid },\n\t\t\t\t\t\tdataType: 'json'\n\t\t\t\t\t}).done(function( msg ) {\n\t\t\t\t\t\tif( msg.success == 1 )\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\twaitdialog.Dismiss();\n\n\t\t\t\t\t\t\t// Success.  Now let them optionally release the commercial package\n\t\t\t\t\t\t\t$J('#CommercialCloneModal').hide();\n\n\t\t\t\t\t\t\t// Let them release the package\n\t\t\t\t\t\t\tif ( msg.new_package != -1 ) {\n\t\t\t\t\t\t\t\tReleaseCommercialPackage( msg.new_package );\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t}\n\t\t\t\t\t\telse\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\twaitdialog.Dismiss();\n\t\t\t\t\t\t\tShowAlertDialog( \"Package creation failed\", ( msg.messages ? msg.messages : msg.success ) );\n\t\t\t\t\t\t}\n\t\t\t\t\t} ).fail( function() {\n\t\t\t\t\t\twaitdialog.Dismiss();\n\t\t\t\t\t});\n\n\t\t\t\t}\n\t\t\t} );\n\t\t}\n\n\t\tfunction OnCloneSelected( pkg )\n\t\t{\n\t\t\tvar selected = 'checkbox_clone_' + pkg;\n\t\t\tif ( GetFancyCheckboxState( selected ) ) {\n\t\t\t\t// If we are setting a checkbox, we may need to uncheck another previously selected one\n\t\t\t\t$J('#CommercialCloneModal .fancyCheckbox').each(function() {\n\t\t\t\t\tvar id = $J(this).attr('id');\n\t\t\t\t\tif ( id != selected && GetFancyCheckboxState( id ) )\n\t\t\t\t\t{\n\t\t\t\t\t\tSetFancyCheckboxUnchecked( id );\n\t\t\t\t\t}\n\t\t\t\t});\n\t\t\t}\n\t\t}\n\n\n\t\tfunction ShowAddCommercialDialog()\n\t\t{\n\t\t\t$J('#CommercialCloneModal').hide();\n\t\t\t$J('#CommercialSelectModal').show();\n\t\t\t$J('#CommercialLicenseModal').hide();\n\n\t\t\tvar dialog = ShowConfirmDialog( 'Add Commercial Package', $J('#CommercialModal').show(), 'Add Commercial Package' );\n\n\t\t\tvar progressMessages = $J( '#ProgressMessagesContainer' );\n\t\t\tprogressMessages.append( '<div class=\"add_dlc_msg parent\"></div>' );\n\n\t\t\tvar $Form = dialog.GetContent().find('form');\n\t\t\tdialog.SetRemoveContentOnDismissal( false );\n\t\t\tdialog.GetContent().css('width','800px');\n\t\t\tdialog.AdjustSizing();\n\t\t\tdialog.done( function() {\n\t\t\t\tvar waitdialog = ShowBlockingWaitDialog( 'Add Commercial Package', 'Saving changes...' );\n\t\t\t\t$J.ajax({\n\t\t\t\t\ttype: \"POST\",\n\t\t\t\t\turl: \"https://partner.steamgames.com/apps/ajaxcreatecommerciallicense/1000000/\",\n\t\t\t\t\tdata: $Form.serialize(),\n\t\t\t\t\tdataType: 'json'\n\t\t\t\t}).done(function( msg ) {\n\t\t\t\t\tif( msg.success == 1 )\n\t\t\t\t\t{\n\t\t\t\t\t\twaitdialog.Dismiss();\n\t\t\t\t\t\ttop.location.reload();\n\t\t\t\t\t}\n\t\t\t\t\telse\n\t\t\t\t\t{\n\t\t\t\t\t\twaitdialog.Dismiss();\n\t\t\t\t\t\tShowAlertDialog( \"Package creation failed\", ( msg.messages ? msg.messages : msg.success ) );\n\t\t\t\t\t}\n\t\t\t\t} ).fail( function() {\n\t\t\t\t\twaitdialog.Dismiss();\n\t\t\t\t});\n\n\t\t\t} );\n\t\t}\n\n\t\tfunction ShowSignCommercialLicenseDialog()\n\t\t{\n\t\t\t$J('#CommercialCloneModal').hide();\n\t\t\t$J('#CommercialSelectModal').hide();\n\t\t\t$J('#CommercialLicenseModal').show();\n\n\t\t\tvar dialog = ShowConfirmDialog( 'Steam Cafe Distribution Addendum', $J('#CommercialModal').show(), 'Sign Addendum' );\n\n\t\t\tvar progressMessages = $J( '#ProgressMessagesContainer' );\n\t\t\tprogressMessages.append( '<div class=\"add_dlc_msg parent\"></div>' );\n\n\t\t\tvar $Form = dialog.GetContent().find('form');\n\t\t\tdialog.SetRemoveContentOnDismissal( false );\n\t\t\tdialog.GetContent().css('width','800px');\n\t\t\tdialog.AdjustSizing();\n\t\t\tdialog.done( function() {\n\t\t\t\twindow.location.href = 'https://partner.steamgames.com/newpartner/signlatestsda/?agreement_type=' + 12;\n\t\t\t} );\n\t\t}\n\n\t\tfunction ReleaseCommercialPackage( id )\n\t\t{\n\t\t\tvar dialog = ShowConfirmDialog( 'Release Commercial Package', 'Do you want to make this package available on the store?' );\n\t\t\tdialog.SetRemoveContentOnDismissal( false );\n\t\t\tdialog.GetContent().css('width','640px');\n\t\t\tdialog.AdjustSizing();\n\t\t\tdialog.done( function() {\n\t\t\t\tvar waitdialog = ShowBlockingWaitDialog( 'Modify Existing Giveaway', 'Saving changes...' );\n\t\t\t\t$J.ajax({\n\t\t\t\t\ttype: \"POST\",\n\t\t\t\t\turl: \"https://partner.steamgames.com/store/ajaxpublishcommercialpackage/\",\n\t\t\t\t\tdataType: \"json\",\n\t\t\t\t\tdata: { 'sessionid' : g_sessionID, 'package' : id },\n\t\t\t\t\terror: function( msg )\n\t\t\t\t\t{\n\t\t\t\t\t\twaitdialog.Dismiss();\n\t\t\t\t\t\tShowAlertDialog( 'Error', 'Could not publish changes to store: ' + msg.success );\n\t\t\t\t\t},\n\t\t\t\t\tsuccess: function( msg )\n\t\t\t\t\t{\n\t\t\t\t\t\twaitdialog.Dismiss();\n\t\t\t\t\t\tif( msg.success == 1 )\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\ttop.location.reload();\n\t\t\t\t\t\t}\n\t\t\t\t\t\telse\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\tShowAlertDialog( 'Error', 'Error' + ': ' + ( msg.messages ? msg.messages : msg.success ) );\n\t\t\t\t\t\t}\n\t\t\t\t\t}\n\t\t\t\t});\n\t\t\t} );\n\t\t}\n\n\t</script>\n</head>\n<body>\n<div id=\"pageContainer\">\n\t<div id=\"application_root\"></div>\n\n\t<!-- header -->\n\t<script type=\"text/javascript\">\n\t$J( InitMiniprofileHovers( 'https%3A%2F%2Fpartner.steamgames.com' ) );\n    \tg_sessionID = \"ffffffffffffffffffff0001\";\n</script>\n<!-- anyone using landing_header needs to ensure jquery is loaded prior -->\n<script type=\"text/javascript\" src=\"https://partner.steamgames.com/public/javascript/jquery.cookie.js?v=ND_3CW4DxZHp&amp;l=english&amp;_cdn=akamai\"></script>\n<script type=\"text/javascript\">\n\tg_sessionID = \"ffffffffffffffffffff0001\";\n\tg_rgAllAffiliatedPublishers = {\"900000\":\"Redacted\"};\n\tg_nPrimaryPublisher = 900000;\n\n\tfunction GoToEditPage( page, id )\n\t{\n\t\tif ( checkNumeric( id ) )\n\t\t{\n\t\t\twindow.location.href = \"https://partner.steamgames.com/apps/\" + page + \"/\" + id;\n\t\t}\n\t}\n\n\tfunction checkNumeric( value )\n\t{\n\t\tvar anum=/(^\\d+$)|(^\\d+\\.\\d+$)/\n\t\tif (anum.test(value))\n\t\t\treturn true;\n\t\treturn false;\n\t}\n</script>\n\t<div id=\"headerContainer\" data-config=\"{&quot;EUNIVERSE&quot;:1,&quot;WEB_UNIVERSE&quot;:&quot;public&quot;,&quot;LANGUAGE&quot;:&quot;english&quot;,&quot;COUNTRY&quot;:&quot;TR&quot;,&quot;MEDIA_CDN_COMMUNITY_URL&quot;:&quot;https:\\/\\/shared.akamai.steamstatic.com\\/community_assets\\/&quot;,&quot;MEDIA_CDN_URL&quot;:&quot;https:\\/\\/cdn.akamai.steamstatic.com\\/&quot;,&quot;VIDEO_CDN_URL&quot;:&quot;https:\\/\\/video.akamai.steamstatic.com\\/&quot;,&quot;COMMUNITY_CDN_URL&quot;:&quot;https:\\/\\/community.akamai.steamstatic.com\\/&quot;,&quot;COMMUNITY_CDN_ASSET_URL&quot;:&quot;https:\\/\\/cdn.akamai.steamstatic.com\\/appmgmt\\/&quot;,&quot;STORE_CDN_URL&quot;:&quot;https:\\/\\/store.akamai.steamstatic.com\\/&quot;,&quot;PUBLIC_SHARED_URL&quot;:&quot;https:\\/\\/store.akamai.steamstatic.com\\/public\\/shared\\/&quot;,&quot;COMMUNITY_BASE_URL&quot;:&quot;https:\\/\\/steamcommunity.com\\/&quot;,&quot;CHAT_BASE_URL&quot;:&quot;https:\\/\\/steamcommunity.com\\/&quot;,&quot;STORE_BASE_URL&quot;:&quot;https:\\/\\/store.steampowered.com\\/&quot;,&quot;STORE_CHECKOUT_BASE_URL&quot;:&quot;https:\\/\\/checkout.steampowered.com\\/&quot;,&quot;IMG_URL&quot;:&quot;https:\\/\\/partner.steamgames.com\\/public\\/images\\/&quot;,&quot;STEAMTV_BASE_URL&quot;:&quot;https:\\/\\/steam.tv\\/&quot;,&quot;HELP_BASE_URL&quot;:&quot;https:\\/\\/help.steampowered.com\\/&quot;,&quot;PARTNER_BASE_URL&quot;:&quo