t;label&quot;:&quot;Creator Homepage Setup&quot;},{&quot;href&quot;:&quot;https://partner.steamgames.com/creatorhome/vanity_url/900000&quot;,&quot;label&quot;:&quot;Creator Homepage Custom URL Setup&quot;}]},{&quot;label&quot;:&quot;Tools&quot;,&quot;active&quot;:false,&quot;children&quot;:[{&quot;href&quot;:&quot;https://partner.steamgames.com/pub/navstatsoverview/900000&quot;,&quot;label&quot;:&quot;Store &amp; Steam Platform Navigation Traffic&quot;},{&quot;href&quot;:&quot;https://partner.steamgames.com/economy/&quot;,&quot;label&quot;:&quot;Manage Economy&quot;},{&quot;href&quot;:&quot;https://partner.steamgames.com/querycdkey/&quot;,&quot;label&quot;:&quot;Query Steam Key&quot;},{&quot;href&quot;:&quot;https://partner.steamgames.com/partnerbatchbancdkeys/&quot;,&quot;label&quot;:&quot;Ban Steam Keys&quot;},{&quot;href&quot;:&quot;https://partner.steamgames.com/pub/apptransfers/900000&quot;,&quot;label&quot;:&quot;Transfer Applications&quot;},{&quot;href&quot;:&quot;https://partner.steamgames.com/appsharing/details/900000&quot;,&quot;label&quot;:&quot;Share Applications&quot;},{&quot;href&quot;:&quot;https://partner.steamgames.com/recommended_actions/all/?partnerid=900000&quot;,&quot;label&quot;:&quot;Catalog Recommended Actions&quot;},{&quot;separator&quot;:true},{&quot;href&quot;:&quot;https://partner.steamgames.com/meetsteam/2025&quot;,&quot;label&quot;:&quot;Meet Steam @ Industry Conferences&quot;}]},{&quot;label&quot;:&quot;Users &amp; Permissions&quot;,&quot;active&quot;:false,&quot;children&quot;:[{&quot;href&quot;:&quot;https://partner.steamgames.com/pub/view/900000&quot;,&quot;label&quot;:&quot;Company Details&quot;},{&quot;href&quot;:&quot;https://partner.steamgames.com/pub/mailingaddresses/900000&quot;,&quot;label&quot;:&quot;Mailing Addresses&quot;},{&quot;separator&quot;:true},{&quot;href&quot;:&quot;https://partner.steamgames.com/pub/home/900000&quot;,&quot;label&quot;:&quot;Overview&quot;},{&quot;href&quot;:&quot;https://partner.steamgames.com/pub/apps/900000&quot;,&quot;label&quot;:&quot;View Applications&quot;},{&quot;separator&quot;:true},{&quot;href&quot;:&quot;https://partner.steamgames.com//pub/users/900000&quot;,&quot;label&quot;:&quot;Manage Users&quot;},{&quot;href&quot;:&quot;https://partner.steamgames.com//pub/groups/900000&quot;,&quot;label&quot;:&quot;Manage Groups&quot;},{&quot;href&quot;:&quot;https://partner.steamgames.com//pub/userhistory/900000&quot;,&quot;label&quot;:&quot;User History&quot;},{&quot;href&quot;:&quot;https://partner.steamgames.com//pub/userinvitehistory/900000&quot;,&quot;label&quot;:&quot;User Invite History&quot;}]},{&quot;label&quot;:&quot;Financial Info&quot;,&quot;active&quot;:false,&quot;href&quot;:&quot;https://partner.steampowered.com/&quot;}],&quot;globalActions&quot;:[{&quot;label&quot;:&quot;Redacted&quot;,&quot;children&quot;:[{&quot;label&quot;:&quot;Logout&quot;,&quot;action&quot;:1},{&quot;id&quot;:&quot;language&quot;,&quot;label&quot;:&quot;Change language&quot;,&quot;children&quot;:[{&quot;label&quot;:&quot;简体中文 (Simplified Chinese)&quot;,&quot;href&quot;:&quot;https://partner.steamgames.com/apps/config/1000000?l=schinese&quot;,&quot;action&quot;:2,&quot;action_parameters&quot;:{&quot;language&quot;:&quot;schinese&quot;},&quot;beta&quot;:false},{&quot;label&quot;:&quot;繁體中文 (Traditional Chinese)&quot;,&quot;href&quot;:&quot;https://partner.steamgames.com/apps/config/1000000?l=tchinese&quot;,&quot;action&quot;:2,&quot;action_parameters&quot;:{&quot;language&quot;:&quot;tchinese&quot;},&quot;beta&quot;:false},{&quot;label&quot;:&quot;日本語 (Japanese)&quot;,&quot;href&quot;:&quot;https://partner.steamgames.com/apps/config/1000000?l=japanese&quot;,&quot;action&quot;:2,&quot;action_parameters&quot;:{&quot;language&quot;:&quot;japanese&quot;},&quot;beta&quot;:false},{&quot;label&quot;:&quot;한국어 (Korean)&quot;,&quot;href&quot;:&quot;https://partner.steamgames.com/apps/config/1000000?l=koreana&quot;,&quot;action&quot;:2,&quot;action_parameters&quot;:{&quot;language&quot;:&quot;koreana&quot;},&quot;beta&quot;:false},{&quot;label&quot;:&quot;ไทย (Thai)&quot;,&quot;href&quot;:&quot;https://partner.steamgames.com/apps/config/1000000?l=thai&quot;,&quot;action&quot;:2,&quot;action_parameters&quot;:{&quot;language&quot;:&quot;thai&quot;},&quot;beta&quot;:false},{&quot;label&quot;:&quot;العربية (Arabic)&quot;,&quot;href&quot;:&quot;https://partner.steamgames.com/apps/config/1000000?l=arabic&quot;,&quot;action&quot;:2,&quot;action_parameters&quot;:{&quot;language&quot;:&quot;arabic&quot;},&quot;beta&quot;:false},{&quot;label&quot;:&quot;Bahasa Indonesia (Indonesian)&quot;,&quot;href&quot;:&quot;https://partner.steamgames.com/apps/config/1000000?l=indonesian&quot;,&quot;action&quot;:2,&quot;action_parameters&quot;:{&quot;language&quot;:&quot;indonesian&quot;},&quot;beta&quot;:false},{&quot;label&quot;:&quot;Bahasa Melayu (Malay)&quot;,&quot;href&quot;:&quot;https://partner.steamgames.com/apps/config/1000000?l=malay&quot;,&quot;action&quot;:2,&quot;action_parameters&quot;:{&quot;language&quot;:&quot;malay&quot;},&quot;beta&quot;:true},{&quot;label&quot;:&quot;Български (Bulgarian)&quot;,&quot;href&quot;:&quot;https://partner.steamgames.com/apps/config/1000000?l=bulgarian&quot;,&quot;action&quot;:2,&quot;action_parameters&quot;:{&quot;language&quot;:&quot;bulgarian&quot;},&quot;beta&quot;:false},{&quot;label&quot;:&quot;Čeština (Czech)&quot;,&quot;href&quot;:&quot;https://partner.steamgames.com/apps/config/1000000?l=czech&quot;,&quot;action&quot;:2,&quot;action_parameters&quot;:{&quot;language&quot;:&quot;czech&quot;},&quot;beta&quot;:false},{&quot;label&quot;:&quot;Dansk (Danish)&quot;,&quot;href&quot;:&quot;https://partner.steamgames.com/apps/config/1000000?l=danish&quot;,&quot;action&quot;:2,&quot;action_parameters&quot;:{&quot;language&quot;:&quot;danish&quot;},&quot;beta&quot;:false},{&quot;label&quot;:&quot;Deutsch (German)&quot;,&quot;href&quot;:&quot;https://partner.steamgames.com/apps/config/1000000?l=german&quot;,&quot;action&quot;:2,&quot;action_parameters&quot;:{&quot;language&quot;:&quot;german&quot;},&quot;beta&quot;:false},{&quot;label&quot;:&quot;English&quot;,&quot;href&quot;:&quot;https://partner.steamgames.com/apps/config/1000000?l=english&quot;,&quot;action&quot;:2,&quot;action_parameters&quot;:{&quot;language&quot;:&quot;english&quot;},&quot;beta&quot;:false},{&quot;label&quot;:&quot;Español - España (Spanish - Spain)&quot;,&quot;href&quot;:&quot;https://partner.steamgames.com/apps/config/1000000?l=spanish&quot;,&quot;action&quot;:2,&quot;action_parameters&quot;:{&quot;language&quot;:&quot;spanish&quot;},&quot;beta&quot;:false},{&quot;label&quot;:&quot;Español - Latinoamérica (Spanish - Latin America)&quot;,&quot;href&quot;:&quot;https://partner.steamgames.com/apps/config/1000000?l=latam&quot;,&quot;action&quot;:2,&quot;action_parameters&quot;:{&quot;language&quot;:&quot;latam&quot;},&quot;beta&quot;:false},{&quot;label&quot;:&quot;Ελληνικά (Greek)&quot;,&quot;href&quot;:&quot;https://partner.steamgames.com/apps/config/1000000?l=greek&quot;,&quot;action&quot;:2,&quot;action_parameters&quot;:{&quot;language&quot;:&quot;greek&quot;},&quot;beta&quot;:false},{&quot;label&quot;:&quot;Français (French)&quot;,&quot;href&quot;:&quot;https://partner.steamgames.com/apps/config/1000000?l=french&quot;,&quot;action&quot;:2,&quot;action_parameters&quot;:{&quot;language&quot;:&quot;french&quot;},&quot;beta&quot;:false},{&quot;label&quot;:&quot;Italiano (Italian)&quot;,&quot;href&quot;:&quot;https://partner.steamgames.com/apps/config/1000000?l=italian&quot;,&quot;action&quot;:2,&quot;action_parameters&quot;:{&quot;language&quot;:&quot;italian&quot;},&quot;beta&quot;:false},{&quot;label&quot;:&quot;Magyar (Hungarian)&quot;,&quot;href&quot;:&quot;https://partner.steamgames.com/apps/config/1000000?l=hungarian&quot;,&quot;action&quot;:2,&quot;action_parameters&quot;:{&quot;language&quot;:&quot;hungarian&quot;},&quot;beta&quot;:false},{&quot;label&quot;:&quot;Nederlands (Dutch)&quot;,&quot;href&quot;:&quot;https://partner.steamgames.com/apps/config/1000000?l=dutch&quot;,&quot;action&quot;:2,&quot;action_parameters&quot;:{&quot;language&quot;:&quot;dutch&quot;},&quot;beta&quot;:false},{&quot;label&quot;:&quot;Norsk (Norwegian)&quot;,&quot;href&quot;:&quot;https://partner.steamgames.com/apps/config/1000000?l=norwegian&quot;,&quot;action&quot;:2,&quot;action_parameters&quot;:{&quot;language&quot;:&quot;norwegian&quot;},&quot;beta&quot;:false},{&quot;label&quot;:&quot;Polski (Polish)&quot;,&quot;href&quot;:&quot;https://partner.steamgames.com/apps/config/1000000?l=polish&quot;,&quot;action&quot;:2,&quot;action_parameters&quot;:{&quot;language&quot;:&quot;polish&quot;},&quot;beta&quot;:false},{&quot;label&quot;:&quot;Português - Portugal (Portuguese - Portugal)&quot;,&quot;href&quot;:&quot;https://partner.steamgames.com/apps/config/1000000?l=portuguese&quot;,&quot;action&quot;:2,&quot;action_parameters&quot;:{&quot;language&quot;:&quot;portuguese&quot;},&quot;beta&quot;:false},{&quot;label&quot;:&quot;Português - Brasil (Portuguese - Brazil)&quot;,&quot;href&quot;:&quot;https://partner.steamgames.com/apps/config/1000000?l=brazilian&quot;,&quot;action&quot;:2,&quot;action_parameters&quot;:{&quot;language&quot;:&quot;brazilian&quot;},&quot;beta&quot;:false},{&quot;label&quot;:&quot;Română (Romanian)&quot;,&quot;href&quot;:&quot;https://partner.steamgames.com/apps/config/1000000?l=romanian&quot;,&quot;action&quot;:2,&quot;action_parameters&quot;:{&quot;language&quot;:&quot;romanian&quot;},&quot;beta&quot;:false},{&quot;label&quot;:&quot;Русский (Russian)&quot;,&quot;href&quot;:&quot;https://partner.steamgames.com/apps/config/1000000?l=russian&quot;,&quot;action&quot;:2,&quot;action_parameters&quot;:{&quot;language&quot;:&quot;russian&quot;},&quot;beta&quot;:false},{&quot;label&quot;:&quot;Suomi (Finnish)&quot;,&quot;href&quot;:&quot;https://partner.steamgames.com/apps/config/1000000?l=finnish&quot;,&quot;action&quot;:2,&quot;action_parameters&quot;:{&quot;language&quot;:&quot;finnish&quot;},&quot;beta&quot;:false},{&quot;label&quot;:&quot;Svenska (Swedish)&quot;,&quot;href&quot;:&quot;https://partner.steamgames.com/apps/config/1000000?l=swedish&quot;,&quot;action&quot;:2,&quot;action_parameters&quot;:{&quot;language&quot;:&quot;swedish&quot;},&quot;beta&quot;:false},{&quot;label&quot;:&quot;Türkçe (Turkish)&quot;,&quot;href&quot;:&quot;https://partner.steamgames.com/apps/config/1000000?l=turkish&quot;,&quot;action&quot;:2,&quot;action_parameters&quot;:{&quot;language&quot;:&quot;turkish&quot;},&quot;beta&quot;:false},{&quot;label&quot;:&quot;Tiếng Việt (Vietnamese)&quot;,&quot;href&quot;:&quot;https://partner.steamgames.com/apps/config/1000000?l=vietnamese&quot;,&quot;action&quot;:2,&quot;action_parameters&quot;:{&quot;language&quot;:&quot;vietnamese&quot;},&quot;beta&quot;:false},{&quot;label&quot;:&quot;Українська (Ukrainian)&quot;,&quot;href&quot;:&quot;https://partner.steamgames.com/apps/config/1000000?l=ukrainian&quot;,&quot;action&quot;:2,&quot;action_parameters&quot;:{&quot;language&quot;:&quot;ukrainian&quot;},&quot;beta&quot;:false}]}]}],&quot;bIsAdmin&quot;:false,&quot;primaryPublisherName&quot;:&quot;Redacted&quot;,&quot;disableLoginButton&quot;:false}}\"></div>\n\t<link href=\"https://partner.steamgames.com/public/css/../javascript/partnermenu/partnermenu.css?v=Nkvys1E2zLc5&amp;l=english&amp;_cdn=akamai\" rel=\"stylesheet\" type=\"text/css\">\n\t<script type=\"text/javascript\" src=\"https://partner.steamgames.com/public/javascript/partnermenu/partnermenu.js?v=H_GcgOP3wgQQ&amp;l=english&amp;_cdn=akamai\"></script>\n\n\n\t<div class=\"AdminPageContent\">\n\n\t\t<script type=\"text/javascript\">\n\n\t\t\tfunction EnableLaunchOptionElement( element )\n\t\t\t{\n\t\t\t\telement.disabled = false;\n\t\t\t\telement.style.border = \"1px solid rgb(255 255 255 / 45%)\";\n\t\t\t\telement.style.lineHeight = \"26px\";\n\t\t\t\telement.style.width = \"400px\";\n\t\t\t\telement.parentElement.parentElement.style.display = ''; // make <tr> visible\n\t\t\t}\n\n\t\t\tfunction EditLaunchOption( formName )\n\t\t\t{\n\t\t\t\tEnableLaunchOptionElement( document.forms[ formName ].elements[ \"executable\" ] );\n\t\t\t\tEnableLaunchOptionElement( document.forms[ formName ].elements[ \"argumentsx\" ] );\n\t\t\t\tEnableLaunchOptionElement( document.forms[ formName ].elements[ \"workingdir\" ] );\n\t\t\t\tEnableLaunchOptionElement( document.forms[ formName ].elements[ \"type\" ] );\n\t\t\t\tEnableLaunchOptionElement( document.forms[ formName ].elements[ \"osversion\" ] );\n\t\t\t\tEnableLaunchOptionElement( document.forms[ formName ].elements[ \"osarch\" ] );\n\t\t\t\tEnableLaunchOptionElement( document.forms[ formName ].elements[ \"oscpu\" ] );\n\t\t\t\tEnableLaunchOptionElement( document.forms[ formName ].elements[ \"ownsdlc\" ] );\n\t\t\t\tEnableLaunchOptionElement( document.forms[ formName ].elements[ \"betakey\" ] );\n\t\t\t\tEnableLaunchOptionElement( document.forms[ formName ].elements[ \"realm\" ] );\n\t\t\t\tEnableLaunchOptionElement( document.forms[ formName ].elements[ \"steamdeck\" ] );\n\n\t\t\t\tSetLaunchOptionDescriptionLocEnabled( formName, true );\n\n\t\t\t\tEditLaunchOption_PlatformOSChanged( formName );\n\n\t\t\t\tdocument[ formName ].elements[ \"editoption\" ].style.display = 'none';\n\t\t\t\tdocument[ formName ].elements[ \"deleteoption\" ].style.display = 'none';\n\t\t\t\tdocument[ formName ].elements[ \"updateoption\" ].style.display = 'block';\n\t\t\t\tdocument[ formName ].elements[ \"canceloption\" ].style.display = 'block';\n\t\t\t}\n\n\t\t\tfunction SetLaunchOptionDescriptionLocEnabled( formName, bEnable )\n\t\t\t{\n\t\t\t\t// Loc strings need to be looked up by their ID which has a standard suffix since they don't have a form key\n\t\t\t\tfor ( description of document.forms[ formName ].elements )\n\t\t\t\t{\n\t\t\t\t\tif ( description.id.includes( 'description_loc__textarea' ) )\n\t\t\t\t\t{\n\t\t\t\t\t\tif ( bEnable )\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\tEnableLaunchOptionElement( description );\n\t\t\t\t\t\t}\n\t\t\t\t\t\telse\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\tdescription.disabled = true;\n\t\t\t\t\t\t}\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t}\n\n\t\t\tfunction EditLaunchOption_PlatformOSChanged( formName )\n\t\t\t{\n\t\t\t\tif ( document.forms[ formName ].elements[ \"osversion\" ].value == 'macos' )\n\t\t\t\t{\n\t\t\t\t\tdocument.forms[ formName ].elements[ \"osarch\" ].value = '';\n\t\t\t\t\tdocument.forms[ formName ].elements[ \"osarch\" ].disabled = true;\n\t\t\t\t\tdocument.forms[ formName ].elements[ \"osarch\" ].removeAttribute('style');\n\t\t\t\t}\n\t\t\t\telse\n\t\t\t\t{\n\t\t\t\t\tEnableLaunchOptionElement( document.forms[ formName ].elements[ \"osarch\" ] );\n\t\t\t\t}\n\n\t\t\t\tvar oscpuElement = document.forms[ formName ].elements[ \"oscpu\" ];\n\t\t\t\tif ( oscpuElement && oscpuElement.tagName == 'SELECT' )\n\t\t\t\t{\n\t\t\t\t\tif ( document.forms[ formName ].elements[ \"osversion\" ].value != 'linux' )\n\t\t\t\t\t{\n\t\t\t\t\t\toscpuElement.value = '';\n\t\t\t\t\t\toscpuElement.disabled = true;\n\t\t\t\t\t\toscpuElement.removeAttribute('style');\n\t\t\t\t\t}\n\t\t\t\t\telse\n\t\t\t\t\t{\n\t\t\t\t\t\tEnableLaunchOptionElement( oscpuElement );\n\t\t\t\t\t}\n\t\t\t\t}\n\n\t\t\t\tif ( document.forms[ formName ].elements[ \"osversion\" ].value == 'android' )\n\t\t\t\t{\n\t\t\t\t\tdocument.forms[ formName ].elements[ \"argumentsx\" ].value = '';\n\t\t\t\t\tdocument.forms[ formName ].elements[ \"argumentsx\" ].disabled = true;\n\t\t\t\t\tdocument.forms[ formName ].elements[ \"argumentsx\" ].removeAttribute('style');\n\t\t\t\t}\n\t\t\t\telse\n\t\t\t\t{\n\t\t\t\t\tEnableLaunchOptionElement( document.forms[ formName ].elements[ \"argumentsx\" ] );\n\t\t\t\t}\n\t\t\t}\n\n\t\t\tfunction ExtractLaunchOptionLocDescriptions( formName )\n\t\t\t{\n\t\t\t\t// The loc fields aren't part of the form, so instead go through and find all of the hidden fields\n\t\t\t\t// which contain the localized content. The language can be extracted from their name using the regex below\n\t\t\t\tlangMap = new Map();\n\t\t\t\tfor ( description of document.forms[ formName ].elements )\n\t\t\t\t{\n\t\t\t\t\tmatchLang = /description_loc_(.*)__hidden/i.exec( description.id );\n\t\t\t\t\tif ( matchLang && matchLang.length > 1 )\n\t\t\t\t\t{\n\t\t\t\t\t\tlangMap.set( matchLang[ 1 ], description.value );\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t\treturn langMap;\n\t\t\t}\n\n\t\t\tfunction DeleteLaunchOption( appid, index )\n\t\t\t{\n\t\t\t\tif ( confirm( \"Delete launch option \\\"%1$s\\\" ?\".replace( '%1$s', index ) ) )\n\t\t\t\t{\n\t\t\t\t\t// Deleting is \"set every field empty\", so an options object with nothing but the index does it.\n\t\t\t\t\tSetLaunchOption( appid, { 'index': index } );\n\t\t\t\t}\n\t\t\t}\n\n\t\t\t// Anything not supplied becomes ''\n\t\t\tfunction SetLaunchOption( appid, options )\n\t\t\t{\n\t\t\t\tfunction OptionValue( name )\n\t\t\t\t{\n\t\t\t\t\tvar value = options[ name ];\n\t\t\t\t\treturn ( value === undefined || value === null ) ? '' : value;\n\t\t\t\t}\n\n\t\t\t\tvar mapDescriptions = options[ 'mapDescriptions' ];\n\n\t\t\t\tvar sendParams = {\n\t\t\t\t\t\t\t'index': OptionValue( 'index' ),\n\t\t\t\t\t\t\t'executable': OptionValue( 'executable' ),\n\t\t\t\t\t\t\t'arguments': OptionValue( 'arguments' ),\n\t\t\t\t\t\t\t'workingdir': OptionValue( 'workingdir' ),\n\t\t\t\t\t\t\t'type': OptionValue( 'launchtype' ),\n\t\t\t\t\t\t\t// for legacy reasons, we want to store a 'description' field, and therefore use english if provided\n\t\t\t\t\t\t\t'description': ( mapDescriptions && mapDescriptions[ 'english' ] ) || '',\n\t\t\t\t\t\t\t'osversion': OptionValue( 'osversion' ),\n\t\t\t\t\t\t\t'osarch': OptionValue( 'osarch' ),\n\t\t\t\t\t\t\t'oscpu': OptionValue( 'oscpu' ),\n\t\t\t\t\t\t\t'betakey': OptionValue( 'betakey' ),\n\t\t\t\t\t\t\t'ownsdlc': OptionValue( 'ownsdlc' ),\n\t\t\t\t\t\t\t'realm' : OptionValue( 'realm' ),\n\t\t\t\t\t\t\t'steamdeck' : OptionValue( 'steamdeck' ),\n\t\t\t\t}\n\n\t\t\t\t// We need to import the localization values from the optional map so that they will be provided to the server\n\t\t\t\tif ( mapDescriptions )\n\t\t\t\t{\n\t\t\t\t\tmapDescriptions.forEach( function( valueText, keyLang )\n\t\t\t\t\t{\n\t\t\t\t\t\tif ( valueText )\n\t\t\t\t\t\t\tsendParams[ 'description_' + keyLang ] = valueText;\n\t\t\t\t\t} );\n\t\t\t\t}\n\n\t\t\t\tAppsAjaxRequest( 'https://partner.steamgames.com/apps/setlaunchoption/' + appid, sendParams,\n\t\t\t\t\tfunction ( results )\n\t\t\t\t\t{\n\t\t\t\t\t\tStandardCallback( results, 'AjaxOutput' );\n\n\t\t\t\t\t\tif ( results[ 'success' ] )\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t// no error, reload page\n\t\t\t\t\t\t\t$( 'AjaxOutput' ).innerHTML = \"Reloading...\";\n\t\t\t\t\t\t\tRefreshCallback( results );\n\t\t\t\t\t\t}\n\t\t\t\t\t\telse\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t$( 'AjaxOutput' ).innerHTML = results[ 'message' ];\n\t\t\t\t\t\t}\n\t\t\t\t\t}\n\t\t\t\t);\n\t\t\t}\n\n\t\t\tfunction EditAutoUpdates( appid, checkState )\n\t\t\t{\n\t\t\t\tAppsAjaxRequest( 'https://partner.steamgames.com/apps/setautoupdates/' + appid,\n\t\t\t\t\t{ 'NoUpdatesAfterInstall': Boolean( checkState ) },\n\t\t\t\t\tfunction ( results )\n\t\t\t\t\t{\n\t\t\t\t\t\tStandardCallback( results, 'AjaxOutput' );\n\n\t\t\t\t\t\tif ( results[ 'success' ] )\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t// no error, reload page\n\t\t\t\t\t\t\t$( 'AjaxOutput' ).innerHTML = \"Reloading...\";\n\t\t\t\t\t\t\tRefreshCallback( results );\n\t\t\t\t\t\t}\n\t\t\t\t\t}\n\t\t\t\t);\n\t\t\t}\n\n\t\t\tfunction EnableDeckResolutionOverride( appid, bEnabled )\n\t\t\t{\n\t\t\t\tif ( bEnabled )\n\t\t\t\t{\n\t\t\t\t\t$('deckResolutionOverride').style.visibility = \"visible\";\n\t\t\t\t\tSetDeckResolutionOverride( appid, $('deckResolutionOverride').value );\n\t\t\t\t}\n\t\t\t\telse\n\t\t\t\t{\n\t\t\t\t\t$('deckResolutionOverride').style.visibility = \"hidden\";\n\t\t\t\t\tSetDeckResolutionOverride( appid, '' );\n\t\t\t\t}\n\t\t\t}\n\n\t\t\tfunction SetDeckResolutionOverride( appid, resolution )\n\t\t\t{\n\t\t\t\tAppsAjaxRequest( 'https://partner.steamgames.com/apps/setdeckresolutionoverride/' + appid,\n\t\t\t\t\t{ 'ResolutionOverride': String(resolution) },\n\t\t\t\t\tfunction ( results )\n\t\t\t\t\t{\n\t\t\t\t\t\tStandardCallback( results, 'AjaxOutput' );\n\n\t\t\t\t\t\tif ( results[ 'success' ] )\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t// no error, reload page\n\t\t\t\t\t\t\t$( 'AjaxOutput' ).innerHTML = \"Reloading...\";\n\t\t\t\t\t\t\tRefreshCallback( results );\n\t\t\t\t\t\t}\n\t\t\t\t\t}\n\t\t\t\t);\n\t\t\t}\n\n\t\t\tfunction EnableSteamMachineResolutionOverride( appid, bEnabled )\n\t\t\t{\n\t\t\t\tif ( bEnabled )\n\t\t\t\t{\n\t\t\t\t\t$('steamMachineResolutionOverride').style.visibility = \"visible\";\n\t\t\t\t\tSetSteamMachineResolutionOverride( appid, $('steamMachineResolutionOverride').value );\n\t\t\t\t}\n\t\t\t\telse\n\t\t\t\t{\n\t\t\t\t\t$('steamMachineResolutionOverride').style.visibility = \"hidden\";\n\t\t\t\t\tSetSteamMachineResolutionOverride( appid, '' );\n\t\t\t\t}\n\t\t\t}\n\n\t\t\tfunction SetSteamMachineResolutionOverride( appid, resolution )\n\t\t\t{\n\t\t\t\tAppsAjaxRequest( 'https://partner.steamgames.com/apps/setsteammachineresolutionoverride/' + appid,\n\t\t\t\t\t{ 'ResolutionOverride': String(resolution) },\n\t\t\t\t\tfunction ( results )\n\t\t\t\t\t{\n\t\t\t\t\t\tStandardCallback( results, 'AjaxOutput' );\n\n\t\t\t\t\t\tif ( results[ 'success' ] )\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t// no error, reload page\n\t\t\t\t\t\t\t$( 'AjaxOutput' ).innerHTML = \"Reloading...\";\n\t\t\t\t\t\t\tRefreshCallback( results );\n\t\t\t\t\t\t}\n\t\t\t\t\t}\n\t\t\t\t);\n\t\t\t}\n\n\t\t\tfunction EditUseLaunchCommandLine( appid, checkState )\n\t\t\t{\n\t\t\t\tAppsAjaxRequest( 'https://partner.steamgames.com/apps/setuselaunchcommandline/' + appid,\n\t\t\t\t\t{ 'UseLaunchCommandLine': Boolean( checkState ) },\n\t\t\t\t\tfunction ( results )\n\t\t\t\t\t{\n\t\t\t\t\t\tStandardCallback( results, 'AjaxOutput' );\n\n\t\t\t\t\t\tif ( results[ 'success' ] )\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t// no error, reload page\n\t\t\t\t\t\t\t$( 'AjaxOutput' ).innerHTML = \"Reloading...\";\n\t\t\t\t\t\t\tRefreshCallback( results );\n\t\t\t\t\t\t}\n\t\t\t\t\t}\n\t\t\t\t);\n\t\t\t}\n\n\t\t\tfunction EditOverlayForApp( appid, checkState )\n\t\t\t{\n\t\t\t\tAppsAjaxRequest( 'https://partner.steamgames.com/apps/setenableoverlayforapp/' + appid,\n\t\t\t\t\t{ 'EnableGameOverlayForApp': Boolean( checkState ) },\n\t\t\t\t\tfunction ( results )\n\t\t\t\t\t{\n\t\t\t\t\t\tStandardCallback( results, 'AjaxOutput' );\n\n\t\t\t\t\t\tif ( results[ 'success' ] )\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t// no error, reload page\n\t\t\t\t\t\t\t$( 'AjaxOutput' ).innerHTML = \"Reloading...\";\n\t\t\t\t\t\t\tRefreshCallback( results );\n\t\t\t\t\t\t}\n\t\t\t\t\t}\n\t\t\t\t);\n\t\t\t}\n\n\t\t\tfunction EditDisableOverlayInjection( appid, checkState )\n\t\t\t{\n\t\t\t\tAppsAjaxRequest( 'https://partner.steamgames.com/apps/setdisableoverlayinjection/' + appid,\n\t\t\t\t\t{ 'DisableOverlayInjection': Boolean( checkState ) },\n\t\t\t\t\tfunction ( results )\n\t\t\t\t\t{\n\t\t\t\t\t\tStandardCallback( results, 'AjaxOutput' );\n\n\t\t\t\t\t\tif ( results[ 'success' ] )\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t// no error, reload page\n\t\t\t\t\t\t\t$( 'AjaxOutput' ).innerHTML = \"Reloading...\";\n\t\t\t\t\t\t\tRefreshCallback( results );\n\t\t\t\t\t\t}\n\t\t\t\t\t}\n\t\t\t\t);\n\t\t\t}\n\n\t\t\tfunction EditDisableOverlayUI( appid, checkState )\n\t\t\t{\n\t\t\t\tAppsAjaxRequest( 'https://partner.steamgames.com/apps/setdisableoverlayui/' + appid,\n\t\t\t\t\t{ 'DisableOverlayUI': Boolean( checkState ) },\n\t\t\t\t\tfunction ( results )\n\t\t\t\t\t{\n\t\t\t\t\t\tStandardCallback( results, 'AjaxOutput' );\n\n\t\t\t\t\t\tif ( results[ 'success' ] )\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t// no error, reload page\n\t\t\t\t\t\t\t$( 'AjaxOutput' ).innerHTML = \"Reloading...\";\n\t\t\t\t\t\t\tRefreshCallback( results );\n\t\t\t\t\t\t}\n\t\t\t\t\t}\n\t\t\t\t);\n\t\t\t}\n\n\t\t\tfunction UpdateInstallFolder()\n\t\t\t{\n\t\t\t\tappid =  1000