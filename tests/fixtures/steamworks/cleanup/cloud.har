>\n\t\t\t\t\t\t\t\tRich Presence\t\t\t\t\t\t\t</a>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<a class=\"popup_menu_item\" href=\"https://partner.steamgames.com/apps/econserver/1000000\">\n\t\t\t\t\t\t\t\tItem Server\t\t\t\t\t\t\t</a>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<a class=\"popup_menu_item\" href=\"https://partner.steamgames.com/apps/timelinemarkers/1000000\">\n\t\t\t\t\t\t\t\tTimeline Icons\t\t\t\t\t\t\t</a>\n\t\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<script type=\"text/javascript\">\n\t\t\t\t\tRegisterFlyout( 'Q29tbXVuaXR5_tab', 'Q29tbXVuaXR5_flyout', null, null, true );\n\t\t\t\t</script>\n\t\t\t\t\t\t\t\t\t<div class=\"tab  pulldown\" id=\"V29ya3Nob3A__tab\">\n\t\t\t\t\tWorkshop <span class=\"popup_menu_pulldown_indicator\"></span>\n\t\t\t\t</div>\n\t\t\t\t<div class=\"popup_block_new\" style=\"display: none;\" id=\"V29ya3Nob3A__flyout\">\n\t\t\t\t\t<div class=\"popup_body popup_menu\">\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<a class=\"popup_menu_item\" href=\"https://partner.steamgames.com/apps/workshop/1000000\">\n\t\t\t\t\t\t\t\tGeneral\t\t\t\t\t\t\t</a>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<a class=\"popup_menu_item\" href=\"https://partner.steamgames.com/apps/workshophomepage/1000000\">\n\t\t\t\t\t\t\t\tHome Page\t\t\t\t\t\t\t</a>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<a class=\"popup_menu_item\" href=\"https://partner.steamgames.com/apps/workshoptags/1000000\">\n\t\t\t\t\t\t\t\tTags\t\t\t\t\t\t\t</a>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<a class=\"popup_menu_item\" href=\"https://partner.steamgames.com/apps/workshopserviceproviders/1000000\">\n\t\t\t\t\t\t\t\tService Providers\t\t\t\t\t\t\t</a>\n\t\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<script type=\"text/javascript\">\n\t\t\t\t\tRegisterFlyout( 'V29ya3Nob3A__tab', 'V29ya3Nob3A__flyout', null, null, true );\n\t\t\t\t</script>\n\t\t\t\t\t\t\t\t\t<div class=\"tab \" onclick=\"window.location='https://partner.steamgames.com/apps/packages/1000000'\">\n\t\t\t\t\t<a href=\"https://partner.steamgames.com/apps/packages/1000000\" onclick=\"CancelEvent(event);\" >Manage Keys</a>\n\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t<div class=\"tab  pulldown\" id=\"TWlzYw__tab\">\n\t\t\t\t\tMisc <span class=\"popup_menu_pulldown_indicator\"></span>\n\t\t\t\t</div>\n\t\t\t\t<div class=\"popup_block_new\" style=\"display: none;\" id=\"TWlzYw__flyout\">\n\t\t\t\t\t<div class=\"popup_body popup_menu\">\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<a class=\"popup_menu_item\" href=\"https://partner.steamgames.com/apps/migration/1000000\">\n\t\t\t\t\t\t\t\tMigrate Metadata\t\t\t\t\t\t\t</a>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<a class=\"popup_menu_item\" href=\"https://partner.steamgames.com/apps/raw/1000000\">\n\t\t\t\t\t\t\t\tView Raw Settings\t\t\t\t\t\t\t</a>\n\t\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<script type=\"text/javascript\">\n\t\t\t\t\tRegisterFlyout( 'TWlzYw__tab', 'TWlzYw__flyout', null, null, true );\n\t\t\t\t</script>\n\t\t\t\t\t\t\t\t\t<div class=\"tab \" onclick=\"window.location='https://partner.steamgames.com/apps/publishing/1000000'\">\n\t\t\t\t\t<a href=\"https://partner.steamgames.com/apps/publishing/1000000\" onclick=\"CancelEvent(event);\" >Publish</a>\n\t\t\t\t</div>\n\t\t\t\t\t\t\t&nbsp; \t<div style=\"clear: both;\"></div>\n</div>\t<br/>\n\n    <div class=\"two_column_page\">\n        <div class=\"right\">\n            <div class=\"panel\">\n                <a href=\"https://partner.steamgames.com/doc/features/cloud\">View Steam Cloud Documentation</a>\n            </div>\n\t\t\t\t\t\t\t<div class=\"panel\">\n\t\t\t\t\t<h3>Releasing</h3>\n\t\t\t\t\t<div class=\"instructions_table_cell\"><p>To fully enable Steam Cloud, and to complete the release checklist, you also need to select the corresponding tick-box in your store page info under <a href=\"https://partner.steamgames.com/admin/game/editbyappid/1000000?activetab=tab_basic#feature_section\">'Supported Features'</a>.</p></div>\n\t\t\t\t</div>\n\t\t\t        </div>\n        <div class=\"left\">\n            <div class=\"ctn\">\n                <h2>Steam Cloud Settings</h2>\n                <div class=\"grayRule\"> </div>\n\n                <div id=\"cloudOutput\"></div>\n\n\t\t\t\t<p><span class=\"required\">* These two settings are required for any Steam cloud integration to be functional, including API or auto-cloud usage.</span></p>\n\t\t\t\t<p>Changes made here take effect at publish time and impact both Steamworks cloud APIs and Auto-Cloud.</p>\n\n\t\t\t\t<div class=\"feature_options_list\">\n\t\t\t\t\t<div class=\"feature_row\">\n\t\t\t\t\t\t<p>\n\n\t\t\t\t\t\t<input type=\"number\" min=\"10\" max=\"10000000000\" style=\"width:150px;\" width=\"30\" id=\"ufsQuota\" value=\"104857600\"/>\n\t\t\t\t\t\t\t(<span id=\"output\"></span>)\n\n\t\t\t\t\t\t\t<script>\n\t\t\t\t\t\t\t\tfunction formatBytesIntl(bytes, locale = navigator.language) {\n\t\t\t\t\t\t\t\t\tconst units = ['byte', 'kilobyte', 'megabyte', 'gigabyte', 'terabyte'];\n\t\t\t\t\t\t\t\t\tconst i = Math.floor(Math.log(bytes) / Math.log(1000));\n\t\t\t\t\t\t\t\t\tconst value = bytes / Math.pow(1000, i);\n\n\t\t\t\t\t\t\t\t\tconst formatter = new Intl.NumberFormat(locale, {\n\t\t\t\t\t\t\t\t\t\tstyle: 'unit',\n\t\t\t\t\t\t\t\t\t\tunit: units[i],\n\t\t\t\t\t\t\t\t\t\tunitDisplay: 'short', // 'narrow', 'short', or 'long'\n\t\t\t\t\t\t\t\t\t\tmaximumFractionDigits: 2,\n\t\t\t\t\t\t\t\t\t});\n\n\t\t\t\t\t\t\t\t\treturn formatter.format(value);\n\t\t\t\t\t\t\t\t}\n\n\t\t\t\t\t\t\t\tconst inputElement = document.getElementById('ufsQuota');\n\t\t\t\t\t\t\t\tconst outputElement = document.getElementById('output');\n\t\t\t\t\t\t\t\t// set the initial value based on what's in the field\n\t\t\t\t\t\t\t\tif (inputElement.value > 0) {\n\t\t\t\t\t\t\t\t\toutputElement.textContent = formatBytesIntl(inputElement.value);\n\t\t\t\t\t\t\t\t} else {\n\t\t\t\t\t\t\t\t\toutputElement.textContent = 0;\n\t\t\t\t\t\t\t\t}\n\n\n\t\t\t\t\t\t\t\tinputElement.addEventListener('input', function(event) {\n\t\t\t\t\t\t\t\t\t// update the value when the input field changes\n\t\t\t\t\t\t\t\t\tconst currentValue = event.target.value;\n\t\t\t\t\t\t\t\t\toutputElement.textContent = formatBytesIntl(currentValue);\n\t\t\t\t\t\t\t\t});\n\t\t\t\t\t\t\t</script>\n\t\t\t\t\t\t</p>\n\n\t\t\t\t\t\t<div>\n\t\t\t\t\t\t<p>Byte quota per user <span class=\"required\">*</span><br>\n\t\t\t\t\t\t\tEnter as bytes, up to 10,000,000,000 max (10GB)<br>\n\t\t\t\t\t\t</p>\n\t\t\t\t\t\tThe size you need will depend on the size of your save files and how many of those files are typically produced by a player. If your save files are around 10MB each and players typically generate 20 of them over the course of playing the game, then you would probably double that and enter 400000000\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class=\"feature_row\">\n\t\t\t\t\t\t<p>\n\t\t\t\t\t\t<input type=\"number\" min=\"10\" max=\"10000\" style=\"width:150px;\" width=\"30\" id=\"ufsFiles\" value=\"10000\"/></p>\n\t\t\t\t\t\t<div>\n\t\t\t\t\t\t<p>Number of files allowed per user <span class=\"required\">*</span><br>\n\t\t\t\t\t\t\t10,000 max<br>\n\t\t\t\t\t\t</p>\n\t\t\t\t\t\tIf players typically generate 20 saves over the course of playing your game, you would probably double that and enter 40 here\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\n\n            </div>\n        </div>\n\n    </div>\n\n\n\t\t<div class=\"section instructions\">\n\t\t\t<h2>Beta Testing</h2>\n\t\t\t<div class=\"grayRule\"> </div>\n\t\t\t<p>Once configured above and published, the cloud icon will be visible in the Steam client for anyone that owns your game, and any auto-cloud configuration defined below will be functional. To test cloud work after your game has been released publicly, you may want to enable beta testing here. This will hide the icon from the client and will disable auto-cloud syncing.</p>\n\t\t\t<p>To test auto-cloud syncing while in this state, you will need to use the Steam console command <code>testappcloudpaths [appID]</code>.</p>\n\t\t\t<p><input id=\"ufsHideInClient\" type=\"checkbox\" checked name=\"ufsHideInClient\" value=\"ufsHideInClient\"/>\n\t\t\t\t<label for=\"ufsHideInClient\"><b>Enable cloud support for developers only</b></label></p>\n\t\t\t<p class=\"required\" >To release Steam Cloud for your game to public customers, you will need to uncheck the above box.</p>\n\t\t</div>\n\n        <div class=\"section instructions\">\n            <h2>Dynamic Cloud Sync</h2>\n            <div class=\"grayRule\"> </div>\n            <p>On supported platforms such as Steam Deck, Steam can sync your game files up to the Steam Cloud on system suspend and sync any new changes down upon resume.</p>\n            <p>To support this feature, your game will need to be able to handle the cloud-managed files changing during the game session. It should also provide hints to Steam regarding file modifications. The Steamworks SDK has new Steam Cloud APIs to assist you with this - see the <b>Dynamic Cloud Sync</b> section of the <a href=\"https://partner.steamgames.com/doc/features/cloud\">Steam Cloud Documentation</a> for information.</p>\n            <p><input id=\"ufsAllowSyncOnSuspend\" type=\"checkbox\"  name=\"ufsAllowSyncOnSuspend\" value=\"ufsAllowSyncOnSuspend\"/>\n                <label for=\"ufsAllowSyncOnSuspend\"><b>Enable Steam Cloud sync on system suspend and resume</b></label></p>\n            <p><b>WARNING: </b>Failure to utilize the Steam Cloud APIs to protect against partial file writes and to receive notifications about updated local files can result in file corruption and/or loss of user progress.</p>\n        </div>\n\n\t\t<div class=\"section instructions\">\n\t\t\t<h2>Shared Cloud Storage</h2>\n\t\t\t<div class=\"grayRule\"> </div>\n\t\t\t<p>You can save Steam Cloud data for this game using another game's appid. Use this to share saved games between a demo and full game. Enter the app ID to use for shared cloud data here. Only enter this on one app page (ideally set this for your demo to use base game's appID). Do not enter it on both shared app IDs.</p>\n\n\t\t\t<table>\n\t\t\t\t<tr>\n\t\t\t\t\t<td>\n\t\t\t\t\t\tShared cloud App ID:\t\t\t\t\t</td>\n\t\t\t\t\t<td>\n\t\t\t\t\t\t<input style=\"width:100px;\" width=\"30\" id=\"relatedAppID\" value=\"0\"/>\n\t\t\t\t\t\t <br/>\n\t\t\t\t\t</td>\n\t\t\t\t</tr>\n\t\t\t</table>\n\n\t\t</div>\n\n\t<div class=\"section instructions\">\n\t<h2>Steam Auto-Cloud Configuration</h2>\n\t<div class=\"grayRule\"></div>\n\t<p>Auto-cloud is an alternative to the Steamworks cloud APIs that allows apps to use Steam Cloud without writing code or modifying the game binaries.  Steam will automatically sync the following groups of files when the application launches and exits.</p>\n    <br>\n\n    <h3>Best Practices</h3>\n    <p>\n    <ul>\n       <li>- Use a new path for each group of files to sync.</li>\n        <li>- Either slash or backslash may be used on Windows, but forward slash must be used on Mac OS and Linux.</li>\n        <li>- Avoid machine specific configurations such as video quality.</li>\n    </ul>\n    </p>\n    <br>\n\n    <h3>Cross-platform configuration</h3>\n\t<p>To utilize cross-platform syncing for Steam Auto-Cloud, you need to set the OS for each root to <b>\"[All OSes]\"</b> (which is also the default setting). Additionally, the only Root value that is valid on all platforms is <b>\"App Install Directory\"</b>. If you select a different Root value, you must also define \"Root Overrides\" to indicate the corresponding Root for each other supported platform.</p>\n    <p>If you need more control over syncing content between installations on different platforms, please see <a href=\"https://partner.steamgames.com/doc/features/cloud\">Steam Cloud Documentation</a> for information on using the Steam Cloud APIs.</p>\n\t<div class=\"section\">\n\t\t<div id=\"autoCloudOutput\"></div>\n\t\t            <br>\n\t\t\t<div class=\"section indented\">\n\t\t\t\t<h3>Root Paths</h3>\n\t\t\t\t<div class=\"grayRule\"></div>\n\t\t\t\t\t<table class=\"root_path_table landingTable\">\n\t\t\t\t\t\t<tr>\n\t\t\t\t\t\t\t<th/>\n\t\t\t\t\t\t\t<th style=\"width: 200px;\">Root</th>\n\t\t\t\t\t\t\t<th style=\"width: 100%;\">Subdirectory <a class=\"ttip small\" data-tooltip-text=\"Subdirectory path (if any) to the clouded files.\">(?)</a></th>\n\t\t\t\t\t\t\t<th style=\"width: 108px;\">Pattern <a class=\"ttip small\" data-tooltip-text=\"File mask pattern to match.  If all files, use '*'.\">(?)</a></th>\n\t\t\t\t\t\t\t<th style=\"width: 130px;\">OS <a class=\"ttip small\" data-tooltip-text=\"Operating System. In most cases this should be left as the default [All OSes]. Only change this if you are syncing files that are OS specific.\">(?)</a></th>\n\t\t\t\t\t\t\t<th style=\"width: 100px;\">Recursive <a class=\"ttip small\" data-tooltip-text=\"Include sub-directories when searching for matching files.\">(?)</a></th>\n\t\t\t\t\t\t\t<th style=\"width: 130px;\">Cross-Platform <a class=\"ttip small\" data-tooltip-text=\"Will current Root and Override settings enable cross-platform syncing for files in this root path\">(?)</a></th>\n\t\t\t\t\t\t\t<th/>\n\t\t\t\t\t\t\t<th/>\n\t\t\t\t\t\t</tr>\n\t\t\t\t\t\t\n\t\t\t\t\t\t\t<form method=\"POST\" onsubmit=\"return false\" name=\"AutoCloudPathForm0\">\n\t\t\t\t\t\t\t\t<input type=\"hidden\" name=\"sessionid\" value=\"ffffffffffffffffffff0001\" />\t\t\t\t\t\t\t\t<tr>\n\t\t\t\t\t\t\t\t\t<td rowspan=\"2\" class=\"root_path_num\">\n\t\t\t\t\t\t\t\t\t\t0</b>\n\t\t\t\t\t\t\t\t\t</td>\n\t\t\t\t\t\t\t\t\t<td>\n\t\t\t\t\t\t\t\t\t\t<select name=\"root\"  disabled=\"disabled\"  >\n\t\t\t\t\t\t\t\t\t\t\t<option value=\"gameinstall\">App Install Directory</option><option value=\"SteamCloudDocuments\">SteamCloudDocuments</option><option value=\"WinMyDocuments\">WinMyDocuments</option><option value=\"WinAppDataLocal\">WinAppDataLocal</option><option value=\"WinAppDataLocalLow\" selected=\"selected\">WinAppDataLocalLow</option><option value=\"WinAppDataRoaming\">WinAppDataRoaming</option><option value=\"WinSavedGames\">WinSavedGames</option><option value=\"WindowsHome\">WindowsHome</option><option value=\"MacHome\">MacHome</option><option value=\"MacAppSupport\">MacAppSupport</option><option value=\"MacDocuments\">MacDocuments</option><option value=\"LinuxHome\">LinuxHome</option><option value=\"LinuxXdgDataHome\">LinuxXdgDataHome</option><option value=\"LinuxXdgConfigHome\">LinuxXdgConfigHome</option><option value=\"AndroidExternalData\">AndroidExternalData</option><option value=\"AndroidInternalData\">AndroidInternalData</option>\t\t\t\t\t\t\t\t\t\t</select>\n\t\t\t\t\t\t\t\t\t</td>\n\t\t\t\t\t\t\t\t\t<td><input type=\"text\" disabled=\"disabled\" style=\"width:100%\" name=\"path\" value=\"RedactedGames/ExampleGame\"/></td>\n\t\t\t\t\t\t\t\t\t<td><input type=\"text\" disabled=\"disabled\" style=\"width:100px\" name=\"pattern\" value=\"*.sav\"></td>\n\t\t\t\t\t\t\t\t\t<td>\n\t\t\t\t\t\t\t\t\t\t<select class=\"oslist\" name=\"oslist\" disabled=\"disabled\" style=\"width: 10em\">\n\t\t\t\t\t\t\t\t\t\t\t<option value=\"\">[All OSes]</option><option value=\"Windows\">Windows</option><option value=\"MacOS\">macOS</option><option value=\"Linux\">Linux + SteamOS</option><option value=\"Android\">Android</option>\t\t\t\t\t\t\t\t\t\t</select>\n\t\t\t\t\t\t\t\t\t</td>\n\t\t\t\t\t\t\t\t\t<td>\n\t\t\t\t\t\t\t\t\t\t<input type=\"checkbox\" checked name=\"recursive\" disabled=\"disabled\" value=\"recursive\"/><br/>\n\t\t\t\t\t\t\t\t\t</td>\n\t\t\t\t\t\t\t\t\t<td>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<span class='crossPlatform_yes'>Yes</span>                                        \t\t\t\t\t\t\t\t\t</td>\n\t\t\t\t\t\t\t\t\t<td>\n\t\t\t\t\t\t\t\t\t\t<input type=\"submit\" value=\"Edit\" name=\"editoption\" style=\"DISPLAY: block\" onclick='EditAutoCloudPath( \"AutoCloudPathForm0\", true );' />\n\t\t\t\t\t\t\t\t\t\t<input type=\"submit\" value=\"Update\" name=\"updateoption\" style=\"DISPLAY: none\" onclick='SetAutoCloudPath( 1000000,\n\t\t\t\t\t\t\t\t\t\t\t\"0\",\n\t\t\t\t\t\t\t\t\t\t\tdocument.AutoCloudPathForm0.elements[ \"root\" ].value,\n\t\t\t\t\t\t\t\t\t\t\tdocument.AutoCloudPathForm0.elements[ \"path\" ].value,\n\t\t\t\t\t\t\t\t\t\t\tdocument.AutoCloudPathForm0.elements[ \"pattern\" ].value,\n\t\t\t\t\t\t\t\t\t\t\tdocument.AutoCloudPathForm0.elements[ \"oslist\" ].value,\n\t\t\t\t\t\t\t\t\t\t\tdocument.AutoCloudPathForm0.elements[ \"recursive\" ].checked\n\t\t\t\t\t\t\t\t\t\t\t);' />\n\t\t\t\t\t\t\t\t\t</td>\n\t\t\t\t\t\t\t\t\t<td>\n\t\t\t\t\t\t\t\t\t\t<input type=\"submit\" value=\"Delete\" name=\"deletepath\" style=\"DISPLAY: block\" onclick='SetAutoCloudPath( 1000000, \"0\",\"\",\"\",\"\",\"\" );' />\n\t\t\t\t\t\t\t\t\t\t<input type=\"submit\" value=\"Cancel\" name=\"cancelpath\" style=\"DISPLAY: none\" onclick='window.location.reload( true );' />\n\t\t\t\t\t\t\t\t\t</td>\n\t\t\t\t\t\t\t\t</tr>\n\t\t\t\t\t\t\t\t<tr>\n\t\t\t\t\t\t\t\t\t<td colspan=\"8\" class=\"root_path_preview\"><strong>Preview: </strong>%USERPROFILE%/AppData/LocalLow/RedactedGames/ExampleGame</td>\n\t\t\t\t\t\t\t\t</tr>\n\t\t\t\t\t\t\t</form>\n\n\t\t\t\t\t\t\n\t\t\t\t\t\t\t<form method=\"POST\" onsubmit=\"return false\" name=\"AutoCloudPathForm1\">\n\t\t\t\t\t\t\t\t<input type=\"hidden\" name=\"sessionid\" value=\"ffffffffffffffffffff0001\" />\t\t\t\t\t\t\t\t<tr>\n\t\t\t\t\t\t\t\t\t<td rowspan=\"2\" class=\"root_path_num\">\n\t\t\t\t\t\t\t\t\t\t1</b>\n\t\t\t\t\t\t\t\t\t</td>\n\t\t\t\t\t\t\t\t\t<td>\n\t\t\t\t\t\t\t\t\t\t<select name=\"root\"  disabled=\"disabled\"  >\n\t\t\t\t\t\t\t\t\t\t\t<option value=\"gameinstall\">App Install Directory</option><option value=\"SteamCloudDocuments\">SteamCloudDocuments</option><option value=\"WinMyDocuments\">WinMyDocuments</option><option value=\"WinAppDataLocal\">WinAppDataLocal</option><option value=\"WinAppDataLocalLow\" selected=\"selected\">WinAppDataLocalLow</option><option value=\"WinAppDataRoaming\">WinAppDataRoaming</option><option value=\"WinSavedGames\">WinSavedGames</option><option value=\"WindowsHome\">WindowsHome</option><option value=\"MacHome\">MacHome</option><option value=\"MacAppSupport\">MacAppSupport</option><option value=\"MacDocuments\">MacDocuments</option><option value=\"LinuxHome\">LinuxHome</option><option value=\"LinuxXdgDataHome\">LinuxXdgDataHome</option><option value=\"LinuxXdgConfigHome\">LinuxXdgConfigHome</option><option value=\"AndroidExternalData\">AndroidExternalData</option><option value=\"AndroidInternalData\">AndroidInternalData</option>\t\t\t\t\t\t\t\t\t\t</select>\n\t\t\t\t\t\t\t\t\t</td>\n\t\t\t\t\t\t\t\t\t<td><input type=\"text\" disabled=\"disabled\" style=\"width:100%\" name=\"path\" value=\"SWMCPRec/Saves\"/></td>\n\t\t\t\t\t\t\t\t\t<td><input type=\"text\" disabled=\"disabled\" style=\"width:100px\" name=\"pattern\" value=\"*.sav\"></td>\n\t\t\t\t\t\t\t\t\t<td>\n\t\t\t\t\t\t\t\t\t\t<select class=\"oslist\" name=\"oslist\" disabled=\"disabled\" style=\"width: 10em\">\n\t\t\t\t\t\t\t\t\t\t\t<option value=\"\">[All OSes]</option><option value=\"Windows\">Windows</option><option value=\"MacOS\">macOS</option><option value=\"Linux\">Linux + SteamOS</option><option value=\"Android\">Android</option>\t\t\t\t\t\t\t\t\t\t</select>\n\t\t\t\t\t\t\t\t\t</td>\n\t\t\t\t\t\t\t\t\t<td>\n\t\t\t\t\t\t\t\t\t\t<input type=\"checkbox\" checked name=\"recursive\" disabled=\"disabled\" value=\"recursive\"/><br/>\n\t\t\t\t\t\t\t\t\t</td>\n\t\t\t\t\t\t\t\t\t<td>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<span class='crossPlatform_yes'>Yes</span>                                        \t\t\t\t\t\t\t\t\t</td>\n\t\t\t\t\t\t\t\t\t<td>\n\t\t\t\t\t\t\t\t\t\t<input type=\"submit\" value=\"Edit\" name=\"editoption\" style=\"DISPLAY: block\" onclick='EditAutoCloudPath( \"AutoCloudPathForm1\", true );' />\n\t\t\t\t\t\t\t\t\t\t<input type=\"submit\" value=\"Update\" name=\"updateoption\" style=\"DISPLAY: none\" onclick='SetAutoCloudPath( 1000000,\n\t\t\t\t\t\t\t\t\t\t\t\"1\",\n\t\t\t\t\t\t\t\t\t\t\tdocument.AutoCloudPathForm1.elements[ \"root\" ].value,\n\t\t\t\t\t\t\t\t\t\t\tdocument.AutoCloudPathForm1.elements[ \"path\" ].value,\n\t\t\t\t\t\t\t\t\t\t\tdocument.AutoCloudPathForm1.elements[ \"pattern\" ].value,\n\t\t\t\t\t\t\t\t\t\t\tdocument.AutoCloudPathForm1.elements[ \"oslist\" ].value,\n\t\t\t\t\t\t\t\t\t\t\tdocument.AutoCloudPathForm1.elements[ \"recursive\" ].checked\n\t\t\t\t\t\t\t\t\t\t\t);' />\n\t\t\t\t\t\t\t\t\t</td>\n\t\t\t\t\t\t\t\t\t<td>\n\t\t\t\t\t\t\t\t\t\t<input type=\"submit\" value=\"Delete\" name=\"deletepath\" style=\"DISPLAY: block\" onclick='SetAutoCloudPath( 1000000, \"1\",\"\",\"\",\"\",\"\" );' />\n\t\t\t\t\t\t\t\t\t\t<input type=\"submit\" value=\"Cancel\" name=\"cancelpath\" style=\"DISPLAY: none\" onclick='window.location.reload( true );' />\n\t\t\t\t\t\t\t\t\t</td>\n\t\t\t\t\t\t\t\t</tr>\n\t\t\t\t\t\t\t\t<tr>\n\t\t\t\t\t\t\t\t\t<td colspan=\"8\" class=\"root_path_preview\"><strong>Preview: </strong>%USERPROFILE%/AppData/LocalLow/SWMCPRec/Saves</td>\n\t\t\t\t\t\t\t\t</tr>\n\t\t\t\t\t\t\t</form>\n\n\t\t\t\t\t\t\n\t\t\t\t\t\t\t<form method=\"POST\" onsubmit=\"return false\" name=\"AutoCloudPathForm2\">\n\t\t\t\t\t\t\t\t<input type=\"hidden\" name=\"sessionid\" value=\"ffffffffffffffffffff0001\" />\t\t\t\t\t\t\t\t<tr>\n\t\t\t\t\t\t\t\t\t<td rowspan=\"2\" class=\"root_path_num\">\n\t\t\t\t\t\t\t\t\t\t2</b>\n\t\t\t\t\t\t\t\t\t</td>\n\t\t\t\t\t\t\t\t\t<td>\n\t\t\t\t\t\t\t\t\t\t<select name=\"root\"  disabled=\"disabled\"  >\n\t\t\t\t\t\t\t\t\t\t\t<option value=\"gameinstall\">App Install Directory</option><option value=\"SteamCloudDocuments\">SteamCloudDocuments</option><option value=\"WinMyDocuments\">WinMyDocuments</option><option value=\"WinAppDataLocal\">WinAppDataLocal</option><option value=\"WinAppDataLocalLow\">WinAppDataLocalLow</option><option value=\"WinAppDataRoaming\">WinAppDataRoaming</option><option value=\"WinSavedGames\">WinSavedGames</option><option value=\"WindowsHome\">WindowsHome</option><option value=\"MacHome\">