vascript\">\n\t\t\t\t\tRegisterFlyout( 'TWlzYw__tab', 'TWlzYw__flyout', null, null, true );\n\t\t\t\t</script>\n\t\t\t\t\t\t\t\t\t<div class=\"tab \" onclick=\"window.location='https://partner.steamgames.com/apps/publishing/1000000'\">\n\t\t\t\t\t<a href=\"https://partner.steamgames.com/apps/publishing/1000000\" onclick=\"CancelEvent(event);\" >Publish</a>\n\t\t\t\t</div>\n\t\t\t\t\t\t\t&nbsp; \t<div style=\"clear: both;\"></div>\n</div>\t\t\t<br/>\n\n\t\t\t<div id='appConfig'>\n\n\t\t\t\t<div id=\"AjaxOutput\"></div>\n\n\t\t\t\t\t\t\t\t\t<h2>General Installation Settings</h2>\n\t\t\t\t\t<div class=\"grayRule\"></div>\n\t\t\t\t\t<p>Edit basic configuration about your game.</p>\n\t\t\t\t\t<br>\n\t\t\t\t\t<div class=\"section\">\n\t\t\t\t\t\t<h2>Install Folder</h2>\n\t\t\t\t\t\t<div class=\"grayRule\"></div>\n\t\t\t\t\t\t<form method=\"POST\" onsubmit=\"return false\" name=\"InstallFolderForm\">\n\t\t\t\t\t\t\t<input type=\"hidden\" name=\"sessionid\" value=\"ffffffffffffffffffff0001\" />\t\t\t\t\t\t\t<p>Current Install Folder:\t\t\t\t\t\t\t\t<input type=\"text\" style=\"width: 300px\" name=\"installfolder\" value=\"ExampleGame\"/>\n\t\t\t\t\t\t\t\t<span class=\"ttip small\"  data-tooltip-text=\"Install directories must not contain the following characters: \\/:&quot;&lt;&gt;|?* .\" >(?)</span>\n\t\t\t\t\t\t\t</p>\n\t\t\t\t\t\t\t<input class=\"btn_darkblue_white_innerfade btn_medium\" type=\"submit\" value=\"Update Install Folder\" onclick='UpdateInstallFolder();'/>\n\t\t\t\t\t\t</form>\n\t\t\t\t\t</div>\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\t<div class=\"section\" id=\"launch_options\">\n\t\t\t\t\t\t<h2>Launch Options<span class=\"required\">*</span></h2>\n\t\t\t\t\t\t<div class=\"grayRule\"></div>\n\t\t\t\t\t\t<p>You need to configure at least one launch option so that Steam knows what action to take when customers try to launch your application.</p>\n\t\t\t\t\t\t<p class=\"required\">* indicates required fields</p>\n\t\t\t\t\t\t<br>\n\n\t\t\t\t\t\t<div class=\"copyIndent\">\n\t\t\t\t\t\t\t\n\n\n\n\t\t\t\t\t\t\t\t\t<form method=\"POST\" onsubmit=\"return false\" name=\"LaunchForm0\">\n\t\t\t\t\t\t\t\t\t\t<input type=\"hidden\" name=\"sessionid\" value=\"ffffffffffffffffffff0001\" />\t\t\t\t\t\t\t\t\t\t<table class=\"launchOptionArea\">\n\t\t\t\t\t\t\t\t\t\t\t<tr>\n\t\t\t\t\t\t\t\t\t\t\t\t<td colspan=\"3\">\n\t\t\t\t\t\t\t\t\t\t\t\t\t<div class=\"Flexrow\">\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t<h3>Launch Option 0:</h3>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t<div class=\"Flexrow\">\n\t\t\t\t\t\t\t\t\t\t\t\t\t<input class=\"btn_blue_white_innerfade btn_medium\" type=\"submit\" value=\"Edit\" name=\"editoption\" style=\"DISPLAY: block\"\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t   onclick='EditLaunchOption( \"LaunchForm0\" );'/>\n\n\t\t\t\t\t\t\t\t\t\t\t\t\t<input class=\"btn_green_white_innerfade btn_medium\" type=\"submit\" value=\"Update\" name=\"updateoption\" style=\"DISPLAY: none\"\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t   onclick='SetLaunchOption( 1000000, {\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t   \"index\": \"0\",\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t   \"executable\": document.LaunchForm0.elements[ \"executable\" ].value,\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t   \"arguments\": document.LaunchForm0.elements[ \"argumentsx\" ].value,\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t   \"workingdir\": document.LaunchForm0.elements[ \"workingdir\" ].value,\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t   \"launchtype\": document.LaunchForm0.elements[ \"type\" ].value,\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t   \"osversion\": document.LaunchForm0.elements[ \"osversion\" ].value,\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t   \"osarch\": document.LaunchForm0.elements[ \"osarch\" ].value,\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t   \"oscpu\": document.LaunchForm0.elements[ \"oscpu\" ].value,\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t   \"betakey\": document.LaunchForm0.elements[ \"betakey\" ].value,\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t   \"ownsdlc\": document.LaunchForm0.elements[ \"ownsdlc\" ].value,\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t   \"realm\": document.LaunchForm0.elements[ \"realm\" ].value,\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t   \"steamdeck\": document.LaunchForm0.elements[ \"steamdeck\" ].value,\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t   \"mapDescriptions\": ExtractLaunchOptionLocDescriptions( \"LaunchForm0\" )\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t   } );'/>\n\t\t\t\t\t\t\t\t\t\t\t\t\t<input class=\"btn_blue_white_innerfade btn_medium\" type=\"submit\" value=\"Delete\" name=\"deleteoption\" style=\"DISPLAY: block\"\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t   onclick='DeleteLaunchOption( 1000000, \"0\" );'/>\n\t\t\t\t\t\t\t\t\t\t\t\t\t<input class=\"btn_blue_white_innerfade btn_medium\" type=\"submit\" value=\"Cancel\" name=\"canceloption\" style=\"DISPLAY: none\"\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t   onclick='window.location.reload( true );'/>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t\t\t\t</td>\n\t\t\t\t\t\t\t\t\t\t\t</tr>\n\t\t\t\t\t\t\t\t\t\t\t<tr>\n\t\t\t\t\t\t\t\t\t\t\t\t<td>Executable <span class=\"required\">*</span>\n\t\t\t\t\t\t\t\t\t\t\t\t</td>\n\t\t\t\t\t\t\t\t\t\t\t\t<td><input type=\"text\" disabled=\"disabled\" name=\"executable\" value=\"ExampleGame.exe\"/></td>\n\t\t\t\t\t\t\t\t\t\t\t\t<td>Enter the executable to run when a customer attempts to launch your application. If your exe exists in a subdirectory, make sure you include the relative path as well as the exe</td>\n\t\t\t\t\t\t\t\t\t\t\t</tr>\n\t\t\t\t\t\t\t\t\t\t\t<tr  style=\"display:none;\"  >\n\t\t\t\t\t\t\t\t\t\t\t\t<td>Arguments\t\t\t\t\t\t\t\t\t\t\t\t</td>\n\t\t\t\t\t\t\t\t\t\t\t\t<td><input type=\"text\" disabled=\"disabled\" name=\"argumentsx\" value=\"\"/></td>\n\t\t\t\t\t\t\t\t\t\t\t\t<td>You can include any necessary arguments here for Steam to pass to your executable when launching</td>\n\t\t\t\t\t\t\t\t\t\t\t</tr>\n\t\t\t\t\t\t\t\t\t\t\t<tr  style=\"display:none;\"  >\n\t\t\t\t\t\t\t\t\t\t\t\t<td>Working Dir\t\t\t\t\t\t\t\t\t\t\t\t</td>\n\t\t\t\t\t\t\t\t\t\t\t\t<td><input type=\"text\" disabled=\"disabled\" name=\"workingdir\" value=\"\"/></td>\n\t\t\t\t\t\t\t\t\t\t\t\t<td>If you need to specify a  default directory (other than the game install directory) where your game will look for files and where Steam will look for the exe. This overrides the game install directory as the root for searching. If in doubt, leave empty.</td>\n\t\t\t\t\t\t\t\t\t\t\t</tr>\n\n\t\t\t\t\t\t\t\t\t\t\t<tr  >\n\t\t\t\t\t\t\t\t\t\t\t\t<td>Launch Type\t\t\t\t\t\t\t\t\t\t\t\t</td>\n\t\t\t\t\t\t\t\t\t\t\t\t<td><select name=\"type\" disabled=\"disabled\">\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t<option value=\"\" >Unspecified</option>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t<option\tvalue=\"default\" selected >Launch (Default)</option>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t<option\tvalue=\"config\"  >Configure App</option>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t<option value=\"vr\"  >Launch SteamVR App</option>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t<option\tvalue=\"openvroverlay\"  >Launch SteamVR Overlay</option>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t<option\tvalue=\"openxr\"  >\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\tLaunch OpenXR App\t\t\t\t\t\t\t\t\t\t\t\t\t\t</option>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t<option\tvalue=\"othervr\"  >Launch Oculus SDK App</option>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t<option\tvalue=\"server\"  >Launch Game Server</option>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t<option\tvalue=\"editor\"  >Launch Editor</option>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t<option\tvalue=\"manual\"  >Show App Manual</option>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t<option\tvalue=\"benchmark\"  >Launch Benchmark</option>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t<option\tvalue=\"safemode\"  >Launch Benchmark</option>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t<option value=\"option1\"  >Play %%description%% (option1)</option>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t<option value=\"option2\"  >Play %%description%% (option2)</option>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t<option value=\"option3\"  >Play %%description%% (option3)</option>\n\t\t\t\t\t\t\t\t\t\t\t\t\t</select></td>\n\t\t\t\t\t\t\t\t\t\t\t\t<td>Select the component or version of the application that will be launched by this launch option.</td>\n\t\t\t\t\t\t\t\t\t\t\t</tr>\n\t\t\t\t\t\t\t\t\t\t\t<tr>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<td>Description </td>\n\t\t\t\t\t\t\t\t\t\t\t\t<td><div id=\"Launch_0_description_loc__area\" class=\"LocTextArea\"><input type=\"text\" id=\"Launch_0_description_loc__textarea\" onchange=\"OnLocTextChanged( 'Launch_0_description_loc_' )\"><input type=\"hidden\" id=\"Launch_0_description_loc__currentlanguage\"><input type=\"hidden\" id=\"Launch_0_description_loc_english__hidden\" name=\"Launch_0_description_loc[english]\" value=\"Play ExampleGame\" lang=\"en\"><input type=\"hidden\" id=\"Launch_0_description_loc_french__hidden\" name=\"Launch_0_description_loc[french]\" value=\"\" lang=\"fr\"><input type=\"hidden\" id=\"Launch_0_description_loc_italian__hidden\" name=\"Launch_0_description_loc[italian]\" value=\"\" lang=\"it\"><input type=\"hidden\" id=\"Launch_0_description_loc_german__hidden\" name=\"Launch_0_description_loc[german]\" value=\"\" lang=\"de\"><input type=\"hidden\" id=\"Launch_0_description_loc_spanish__hidden\" name=\"Launch_0_description_loc[spanish]\" value=\"\" lang=\"es\"><input type=\"hidden\" id=\"Launch_0_description_loc_bulgarian__hidden\" name=\"Launch_0_description_loc[bulgarian]\" value=\"\" lang=\"bg\"><input type=\"hidden\" id=\"Launch_0_description_loc_czech__hidden\" name=\"Launch_0_description_loc[czech]\" value=\"\" lang=\"cs\"><input type=\"hidden\" id=\"Launch_0_description_loc_danish__hidden\" name=\"Launch_0_description_loc[danish]\" value=\"\" lang=\"da\"><input type=\"hidden\" id=\"Launch_0_description_loc_dutch__hidden\" name=\"Launch_0_description_loc[dutch]\" value=\"\" lang=\"nl\"><input type=\"hidden\" id=\"Launch_0_description_loc_finnish__hidden\" name=\"Launch_0_description_loc[finnish]\" value=\"\" lang=\"fi\"><input type=\"hidden\" id=\"Launch_0_description_loc_greek__hidden\" name=\"Launch_0_description_loc[greek]\" value=\"\" lang=\"el\"><input type=